---
// E-Mail-Link, dessen Adresse nicht im HTML steht (Schutz vor Spam-Sammlern).
// Die Adresse liegt umgekehrt und Base64-kodiert in data-mail; das Script setzt das mailto erst im Browser.
// Sichtbar ist nur `text`, die Adresse selbst nie. Ohne JavaScript führt der Link zum Kontaktformular.
interface Props {
  email: string;
  text?: string;
  class?: string;
}
const { email, text = 'E-Mail schreiben', class: klasse } = Astro.props;
const kodiert = btoa([...email].reverse().join(''));
---

<a class={klasse} href="/#kontakt" data-mail={kodiert}><slot />{text}</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-mail]')) {
    link.href = `mailto:${[...atob(link.dataset.mail ?? '')].reverse().join('')}`;
  }
</script>
