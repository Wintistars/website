---
// ENTWURF E: Randloses Titelband eines Abschnitts als Eisfläche. Darunter liegt klares, frisch aufbereitetes Eis
// mit dem eingelassenen Titel. Mit JS (und ohne reduzierte Bewegung) liegt zu Beginn mattes, zerkratztes
// Trainingseis darüber; die Eismaschine fährt beim Hineinscrollen einmal gerade quer durch und legt den Titel frei.
// Gesteuert von e.astro (nur transform).
import Eismaschine from './Eismaschine.astro';

interface Props {
  nr: string;
  titel: string;
  id: string;
  logo: string;
  /** 1 = Fahrt von links nach rechts, -1 = von rechts nach links */
  richtung: 1 | -1;
}
const { nr, titel, id, logo, richtung } = Astro.props;
---

<div class="band" data-band data-dir={richtung}>
  <div class="band-eis">
    <div class="band-in">
      <span class="band-n">{nr}</span>
      <h2 class="band-h" id={id}>{titel}</h2>
    </div>
  </div>
  <div class="band-nass" data-nass aria-hidden="true"></div>
  <div class="band-frost" data-frost aria-hidden="true">
    <div class="band-frost-in" data-frost-in>
      <div class="band-in band-geist">
        <span class="band-n">{nr}</span>
        <span class="band-h">{titel}</span>
      </div>
    </div>
  </div>
  <div class="band-zb" data-zb aria-hidden="true">
    <div class="band-zb-in" data-zb-in>
      <Eismaschine logo={logo} richtung={richtung} />
    </div>
  </div>
</div>

<style>
  .band {
    position: relative;
    height: var(--band-h);
    overflow-x: clip;
    color: #1c2232;
  }

  /* ---------- Klares, frisch aufbereitetes Eis ---------- */
  .band-eis {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* frisch aufbereitet: hell und klar, nur eine ganz leichte kühle Tönung */
    background: linear-gradient(180deg, #ffffff, #f2f6f9);
  }
  /* eine einzige, feine Spiegelung quer über das Eis */
  /* weicher Spiegelreflex */
  .band-eis::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(214 228 238 / 0.28) 42%, rgb(255 255 255 / 0) 50%, rgb(214 228 238 / 0.16) 56%, transparent 64%);
    pointer-events: none;
  }
  .band-in {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    width: min(1240px, 100% - 2 * var(--gut));
    height: 100%;
    margin-inline: auto;
    align-content: center;
    flex-wrap: wrap;
  }
  .band-n {
    flex: none;
    font: 600 clamp(0.75rem, 1vw, 0.88rem) / 1 var(--data);
    letter-spacing: 0.12em;
    color: #a14f1c;
  }
  .band-h {
    font: 800 min(calc(var(--band-h) * 0.62), 11vw) / 1 var(--display);
    font-stretch: 75%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    /* unter der klaren Eisschicht: minimal kühl getönt */
    color: color-mix(in srgb, #1c2232 94%, #6f93ad);
  }

  /* ---------- Nasse Spur direkt hinter dem Abzieher: etwas dunkler und spiegelnd ---------- */
  .band-nass {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: clamp(36px, 5vw, 80px);
    display: none;
    pointer-events: none;
    will-change: transform;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }
  .band[data-dir='-1'] .band-nass {
    background: linear-gradient(270deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }

  /* ---------- Mattes, zerkratztes Trainingseis ---------- */
  .band-frost {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 200%;
    overflow: hidden;
    display: none;
    pointer-events: none;
    will-change: transform;
  }
  .band[data-dir='-1'] .band-frost {
    left: auto;
    right: 0;
  }
  .band-frost-in {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    will-change: transform;
    background: #e2e7eb;
  }
  /* Schneestaub, Kufenspuren und Bremsspuren (einmal per Canvas erzeugt, siehe e.astro) */
  .band-frost-in::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      var(--eis-schnee, none) var(--eis-pos, 0 0) / var(--eis-kachel, 420px 160px),
      radial-gradient(ellipse 70% 45% at 50% 0%, rgb(255 255 255 / 0.5), transparent 70%),
      radial-gradient(ellipse 70% 45% at 50% 100%, rgb(255 255 255 / 0.45), transparent 70%),
      rgb(236 240 243 / 0.36);
  }
  .band[data-dir='-1'] .band-frost-in {
    left: 50%;
  }
  /* Der Titel ist unter dem matten Eis nur zu ahnen */
  .band-geist {
    filter: blur(1px);
    opacity: 0.5;
  }

  /* ---------- Eismaschine ---------- */
  .band-zb {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    display: none;
    pointer-events: none;
    will-change: transform;
  }
  .band-zb-in {
    height: 100%;
    will-change: transform;
  }

  /* Nur mit JS und Bewegung: Frost, Spur und Maschine einblenden */
  /* Mattes Eis schon ab dem ersten Frame (is-js wird inline vor dem Rendern gesetzt), Maschine und Spur erst,
     wenn das Skript ihre Position kennt (has-zb) – so ändert sich beim Laden nichts sichtbar */
  @media (prefers-reduced-motion: no-preference) {
    :global(.e.is-js) .band-frost {
      display: block;
    }
  }
  :global(.e.has-zb) .band-frost,
  :global(.e.has-zb) .band-nass,
  :global(.e.has-zb) .band-zb {
    display: block;
  }
</style>
