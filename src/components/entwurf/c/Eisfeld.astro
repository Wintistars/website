---
// ENTWURF E: Eisfeld-Ausschnitt in Draufsicht (Mittelzone) in echten Proportionen, Masse in Fuss:
// Feldbreite 85 ft (Bande oben/unten), Mittelkreis r 15 ft, blaue Linien ±25 ft, Bullypunkte der neutralen Zone
// bei (±20, ±22) ft. Mit `slice` füllt das Feld seinen Rahmen; die Mitte bleibt immer im Zentrum.
// Wird zweimal gerendert (scharf und als verschwommene Frost-Ebene), daher eindeutige Clip-ID per Prop.
interface Props {
  logo: string;
  clipId: string;
  class?: string;
}
const { logo, clipId, class: klasse } = Astro.props;
---

<svg class={klasse} viewBox="-50 -42.5 100 85" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={clipId}><circle r="13.3"></circle></clipPath>
  </defs>
  <rect x="-80" y="-60" width="160" height="120" fill="#f1f5f8"></rect>
  <rect x="-25.5" y="-42.5" width="1" height="85" fill="#2f5d9e" fill-opacity="0.85"></rect>
  <rect x="24.5" y="-42.5" width="1" height="85" fill="#2f5d9e" fill-opacity="0.85"></rect>
  <rect x="-0.5" y="-42.5" width="1" height="85" fill="#d42e27" fill-opacity="0.85"></rect>
  <circle r="15" fill="none" stroke="#2f5d9e" stroke-opacity="0.9" stroke-width="0.3"></circle>
  <g fill="#d42e27" fill-opacity="0.85">
    <circle cx="-20" cy="-22" r="1"></circle>
    <circle cx="-20" cy="22" r="1"></circle>
    <circle cx="20" cy="-22" r="1"></circle>
    <circle cx="20" cy="22" r="1"></circle>
  </g>
  <circle r="14" fill="#ffffff"></circle>
  <image href={logo} x="-14" y="-14" width="28" height="28" clip-path={`url(#${clipId})`}></image>
  <rect x="-80" y="-46.5" width="160" height="4" fill="#1c2232"></rect>
  <rect x="-80" y="42.5" width="160" height="4" fill="#1c2232"></rect>
</svg>
