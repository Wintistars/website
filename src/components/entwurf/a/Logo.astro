---
// Entwurf A: Club-Logo rund zugeschnitten. Das Bild wird nicht verändert, nur auf den sauberen Kreis
// (47.5 % Radius) beschnitten; der Rand kommt per CSS.
import { LOGO_PLATZHALTER } from '../../../lib/entwurf';

interface Props {
  /** CSS-Länge für den Durchmesser */
  size?: string;
  alt?: string;
  class?: string;
  ring?: string;
  /** Logo im sichtbaren Bereich beim Laden: sofort laden */
  eager?: boolean;
}
const { size = '48px', alt = 'Logo EHC Wintistars', class: klasse, ring = 'var(--ink, #1c2232)', eager = false } = Astro.props;
---

<span class:list={['c-logo', klasse]} style={`--s:${size};--ring:${ring}`}>
  <img
    src={LOGO_PLATZHALTER}
    alt={alt}
    width="640"
    height="640"
    decoding="async"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</span>

<style>
  .c-logo {
    display: inline-block;
    flex: none;
    width: var(--s);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 3px var(--ring);
  }
  .c-logo img {
    width: 105.27%;
    max-width: none;
    height: auto;
    margin: -2.635%;
  }
</style>
