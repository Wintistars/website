---
import type { Spieler } from '../lib/types';
import { POSITION_LABEL } from '../lib/format';
import SanityPicture from './SanityPicture.astro';

interface Props {
  spieler: Spieler;
}

const { spieler } = Astro.props;
---

<article class="card">
  <a href={`/spieler/${spieler.slug}/`}>
    <SanityPicture image={spieler.portrait} ratio={3 / 4} widths={[300, 600]} sizes="(min-width: 64rem) 16rem, 50vw" alt={spieler.name} />
    <div class="body">
      {spieler.nummer != null && <span class="nummer">#{spieler.nummer}</span>}
      <h3>{spieler.name}</h3>
      {spieler.position && <p class="muted">{POSITION_LABEL[spieler.position]}</p>}
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--c-surface);
    border-radius: var(--radius);
    overflow: hidden;
  }
  a {
    text-decoration: none;
    display: block;
  }
  .body {
    padding: 0.75rem 1rem 1rem;
  }
  .nummer {
    font-weight: 800;
    color: var(--c-accent);
  }
  h3 {
    margin: 0.1rem 0;
  }
  p {
    margin: 0;
  }
</style>
