---
import type { News } from '../lib/types';
import { formatDatum } from '../lib/format';
import SanityPicture from './SanityPicture.astro';

interface Props {
  news: News;
}

const { news } = Astro.props;
---

<article class="card">
  <a href={`/news/${news.slug}/`}>
    <SanityPicture image={news.bild} ratio={16 / 9} widths={[400, 800]} sizes="(min-width: 64rem) 22rem, 100vw" />
    <div class="body">
      {news.datum && <time datetime={news.datum} class="muted">{formatDatum(news.datum)}</time>}
      <h3>{news.titel}</h3>
      {news.lead && <p>{news.lead}</p>}
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--c-bg);
    border-radius: var(--radius);
    border-bottom: 4px solid var(--c-orange);
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(19 24 38 / 0.12);
  }
  a {
    text-decoration: none;
    display: block;
    height: 100%;
  }
  .body {
    padding: 1rem;
  }
  h3 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.5rem;
    text-transform: uppercase;
  }
  p {
    margin: 0;
  }
  time {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-accent-text);
  }
</style>
