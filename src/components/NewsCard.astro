---
import type { News } from '../lib/types';
import { formatDatum } from '../lib/format';
import SanityPicture from './SanityPicture.astro';

interface Props {
  news: News;
}

const { news } = Astro.props;
---

<article class="card">
  <a href={`/news/${news.slug}/`}>
    <SanityPicture image={news.bild} ratio={16 / 9} widths={[400, 800]} sizes="(min-width: 64rem) 22rem, 100vw" />
    <div class="body">
      {news.datum && <time datetime={news.datum} class="muted">{formatDatum(news.datum)}</time>}
      <h3>{news.titel}</h3>
      {news.lead && <p>{news.lead}</p>}
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--c-surface);
    border-radius: var(--radius);
    overflow: hidden;
  }
  a {
    text-decoration: none;
    display: block;
    height: 100%;
  }
  .body {
    padding: 1rem;
  }
  h3 {
    margin: 0.25rem 0 0.5rem;
  }
  p {
    margin: 0;
  }
  time {
    font-size: 0.85rem;
  }
</style>
