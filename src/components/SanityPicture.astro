---
// Responsives Bild aus Sanity, optimiert über das Sanity-Bild-CDN.
import type { SanityImage } from '../lib/types';
import { imageSrcset, imageUrl } from '../lib/image';

interface Props {
  image?: SanityImage | null;
  /** Breite / Höhe, z. B. 16/9. Ohne Angabe: Originalverhältnis. */
  ratio?: number;
  widths?: number[];
  sizes?: string;
  alt?: string;
  eager?: boolean;
  class?: string;
}

const {
  image,
  ratio,
  widths = [400, 800, 1200, 1600],
  sizes = '100vw',
  alt,
  eager = false,
  class: className,
} = Astro.props;

const maxW = Math.max(...widths);
const aspect = ratio ?? image?.dimensions?.aspectRatio;
---

{
  image?.asset && (
    <img
      src={imageUrl(image, maxW, ratio ? Math.round(maxW / ratio) : undefined)}
      srcset={imageSrcset(image, widths, ratio)}
      sizes={sizes}
      alt={alt ?? image.alt ?? ''}
      width={maxW}
      height={aspect ? Math.round(maxW / aspect) : undefined}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={className}
      style={ratio ? `aspect-ratio: ${ratio}; object-fit: cover;` : undefined}
    />
  )
}
