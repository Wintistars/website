---
import type { Spieler } from '../../lib/types';
import { POSITION_LABEL } from '../../lib/format';
import { VEREIN } from '../../lib/verein';
import SanityPicture from '../SanityPicture.astro';
import RichText from '../richtext/RichText.astro';

interface Props {
  spieler: Spieler;
}

const { spieler } = Astro.props;
---

<article class="spieler">
  <SanityPicture image={spieler.portrait} ratio={3 / 4} widths={[400, 800]} sizes="(min-width: 48rem) 20rem, 100vw" alt={spieler.name} eager />
  <div>
    {spieler.nummer != null && <p class="nummer">#{spieler.nummer}</p>}
    <h1>{spieler.name}</h1>
    <dl>
      {spieler.position && (<><dt>Position</dt><dd>{POSITION_LABEL[spieler.position]}</dd></>)}
      {spieler.jahrgang && (<><dt>Jahrgang</dt><dd>{spieler.jahrgang}</dd></>)}
      <dt>Team</dt>
      <dd><a href="/team/">{VEREIN}</a></dd>
    </dl>
    <div class="prose"><RichText value={spieler.text} /></div>
  </div>
</article>

<style>
  .spieler {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 48rem) {
    .spieler {
      grid-template-columns: 20rem 1fr;
    }
  }
  .nummer {
    font-size: 2rem;
    font-weight: 800;
    color: var(--c-accent);
    margin: 0;
  }
  h1 {
    margin-top: 0;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
</style>
