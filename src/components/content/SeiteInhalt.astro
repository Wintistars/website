---
import type { Seite } from '../../lib/types';
import SanityPicture from '../SanityPicture.astro';
import RichText from '../richtext/RichText.astro';

interface Props {
  seite: Seite;
  /** Titel, Einleitung und Titelbild ausblenden, z. B. auf der Startseite (rendert diese selbst). */
  hideTitle?: boolean;
}

const { seite, hideTitle = false } = Astro.props;
---

<article class="prose">
  {
    !hideTitle && (
      <>
        <h1>{seite.titel}</h1>
        {seite.einleitung && <p class="lead">{seite.einleitung}</p>}
        <SanityPicture
          image={seite.titelbild}
          ratio={21 / 9}
          widths={[640, 960, 1440]}
          sizes="(min-width: 47rem) 45rem, 100vw"
          eager
          class="titelbild"
        />
      </>
    )
  }
  <RichText value={seite.body} />
</article>

<style>
  .lead {
    font-size: 1.2rem;
    color: var(--c-muted);
  }
  .titelbild {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 1rem 1.5rem;
  }
</style>
