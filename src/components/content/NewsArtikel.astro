---
import type { News } from '../../lib/types';
import { formatDatum } from '../../lib/format';
import SanityPicture from '../SanityPicture.astro';
import RichText from '../richtext/RichText.astro';

interface Props {
  news: News;
}

const { news } = Astro.props;
---

<article class="prose">
  {news.datum && <time datetime={news.datum} class="muted">{formatDatum(news.datum)}</time>}
  <h1>{news.titel}</h1>
  {news.lead && <p class="lead">{news.lead}</p>}
  <SanityPicture image={news.bild} widths={[600, 1000, 1400]} sizes="(min-width: 48rem) 45rem, 100vw" eager />
  <RichText value={news.text} />
</article>

<style>
  .lead {
    font-size: 1.2rem;
    font-weight: 500;
  }
</style>
