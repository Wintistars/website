---
// Kontaktformular mit Eckdaten daneben. Versand über die Cloudflare Pages Function functions/api/kontakt.ts.
// Ist der Versand (noch) nicht eingerichtet oder schlägt er fehl, zeigt das Formular die Kontakt-E-Mail an.
import type { Verein } from '../../lib/types';

interface Props {
  verein: Verein | null;
}
const { verein } = Astro.props;
const email = verein?.kontaktEmail;
const fakten = verein?.fakten ?? [];
---

<div class="kontakt-grid">
  <div class="kontakt-karte blatt">
    <p class="kontakt-lead">Interesse, bei uns mitzuspielen? Oder eine Frage zum Club? Schreib uns.</p>
    <form class="kontakt-form" data-kontakt-form action="/api/kontakt" method="post" novalidate>
      <div class="kf-zeile">
        <div class="kf-feld">
          <label for="kf-name">Name <span class="kf-pflicht" aria-hidden="true">*</span></label>
          <input id="kf-name" name="name" type="text" autocomplete="name" maxlength="120" required />
          <p class="kf-fehler" id="kf-name-fehler" hidden>Bitte gib deinen Namen an.</p>
        </div>
        <div class="kf-feld">
          <label for="kf-mail">E-Mail <span class="kf-pflicht" aria-hidden="true">*</span></label>
          <input id="kf-mail" name="email" type="email" autocomplete="email" inputmode="email" maxlength="200" required />
          <p class="kf-fehler" id="kf-mail-fehler" hidden>Bitte gib eine gültige E-Mail-Adresse an.</p>
        </div>
      </div>
      <div class="kf-feld">
        <label for="kf-betreff">Betreff</label>
        <input id="kf-betreff" name="betreff" type="text" autocomplete="off" maxlength="200" />
      </div>
      <div class="kf-feld">
        <label for="kf-nachricht">Nachricht <span class="kf-pflicht" aria-hidden="true">*</span></label>
        <textarea id="kf-nachricht" name="nachricht" rows="5" maxlength="5000" required></textarea>
        <p class="kf-fehler" id="kf-nachricht-fehler" hidden>Bitte schreib uns eine Nachricht.</p>
      </div>
      <!-- Falle für Spam-Bots: für Menschen unsichtbar, muss leer bleiben -->
      <div class="kf-falle" aria-hidden="true">
        <label for="kf-website">Website</label>
        <input id="kf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="kf-fuss">
        <p class="kf-hinweis"><span aria-hidden="true">*</span> Pflichtfeld</p>
        <button class="knopf knopf-voll" type="submit" data-kontakt-senden>Senden</button>
      </div>
      <p class="kf-danke" data-kontakt-danke role="status" hidden>Danke für deine Nachricht! Wir melden uns bald.</p>
      <p class="kf-danke kf-problem" data-kontakt-problem role="alert" hidden>
        Die Nachricht konnte leider nicht gesendet werden.
        {
          email ? (
            <>
              Schreib uns bitte direkt an <a href={`mailto:${email}`}>{email}</a>.
            </>
          ) : (
            'Bitte versuch es später nochmals.'
          )
        }
      </p>
    </form>
  </div>
  <aside class="kontakt-info" aria-label="Gut zu wissen">
    {
      fakten.length > 0 && (
        <dl>
          {fakten.map((f) => (
            <div>
              <dt>{f.titel}</dt>
              <dd>{f.text}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {
      email && (
        <a class="kontakt-ics" href={`mailto:${email}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 3.2V17h16V8.2l-8 5-8-5ZM5.3 7 12 11.2 18.7 7H5.3Z" />
          </svg>
          {email}
        </a>
      )
    }
    <a class="kontakt-ics" href="/spielplan.ics">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm12 8H5v9h14v-9Z"></path>
      </svg>
      Spielplan als Kalender abonnieren
    </a>
  </aside>
</div>

<style>
  .kf-falle {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .kf-problem {
    border-color: var(--rot);
  }
  .kf-problem a {
    color: inherit;
    font-weight: 650;
  }
  .kontakt-info .kontakt-ics + .kontakt-ics {
    margin-top: 0.6rem;
  }
</style>

<script>
  const kForm = document.querySelector<HTMLFormElement>('[data-kontakt-form]');
  if (kForm) {
    const danke = kForm.querySelector<HTMLElement>('[data-kontakt-danke]')!;
    const problem = kForm.querySelector<HTMLElement>('[data-kontakt-problem]')!;
    const senden = kForm.querySelector<HTMLButtonElement>('[data-kontakt-senden]')!;
    const felder = [...kForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([name="website"]), textarea')];
    const pruefe = (f: HTMLInputElement | HTMLTextAreaElement) => {
      const fehler = kForm.querySelector<HTMLElement>(`#${f.id}-fehler`);
      if (!fehler) return true;
      // Nur Leerzeichen zählen nicht als ausgefüllt
      const ok = f.checkValidity() && (!f.required || f.value.trim() !== '');
      fehler.hidden = ok;
      f.toggleAttribute('aria-invalid', !ok);
      if (ok) f.removeAttribute('aria-describedby');
      else f.setAttribute('aria-describedby', fehler.id);
      return ok;
    };
    felder.forEach((f) => {
      f.addEventListener('blur', () => f.value && pruefe(f));
      f.addEventListener('input', () => f.hasAttribute('aria-invalid') && pruefe(f));
    });
    // Ohne JavaScript schickt der Browser das Formular normal ab (die Function leitet danach zurück).
    const status = new URLSearchParams(location.search).get('kontakt');
    if (status === 'gesendet') danke.hidden = false;
    if (status === 'fehler') problem.hidden = false;

    kForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      danke.hidden = true;
      problem.hidden = true;
      const falsch = felder.filter((f) => !pruefe(f));
      if (falsch.length) {
        falsch[0].focus();
        return;
      }
      senden.disabled = true;
      try {
        const antwort = await fetch(kForm.action, {
          method: 'POST',
          body: new FormData(kForm),
          headers: { Accept: 'application/json' },
        });
        if (!antwort.ok) throw new Error(String(antwort.status));
        danke.hidden = false;
        kForm.reset();
      } catch {
        problem.hidden = false;
      } finally {
        senden.disabled = false;
      }
    });
  }
</script>
