---
import { ART_LABEL, gegner, type Spiel } from '../../lib/spielplan';
import { VEREIN } from '../../lib/verein';
import { datumTeile, formatUhrzeit } from '../../lib/zeit';

interface Props {
  spiel: Spiel;
}

const { spiel } = Astro.props;
const { wochentag, tag, monat } = datumTeile(spiel.beginn);
const heimspiel = spiel.wir === 'heim';
---

<article class="karte">
  <time datetime={spiel.beginn.toISOString()} class="datum">
    <span class="wt">{wochentag}</span>
    <span class="tag">{tag}</span>
    <span class="monat">{monat}</span>
  </time>
  <div class="details">
    <span class="art">{ART_LABEL[spiel.art]}{spiel.wettbewerb && ` · ${spiel.wettbewerb}`}</span>
    <p class="begegnung">
      {
        spiel.wir ? (
          <>
            <span class="wir">{VEREIN}</span>
            <span class="vs">{heimspiel ? 'vs' : '@'}</span>
            <span>{gegner(spiel)}</span>
          </>
        ) : (
          <span>{gegner(spiel)}</span>
        )
      }
    </p>
    <p class="wo">
      <strong>{formatUhrzeit(spiel.beginn)} Uhr</strong>
      {spiel.ort && <span> · {spiel.ort}</span>}
    </p>
    {spiel.bemerkung && <p class="bemerkung">{spiel.bemerkung}</p>}
  </div>
</article>

<style>
  .karte {
    display: grid;
    grid-template-columns: auto 1fr;
    background: var(--c-navy);
    color: var(--c-cream);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .datum {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 1.5rem;
    background: var(--c-orange);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
  }
  .wt,
  .monat {
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }
  .tag {
    font-size: 3.5rem;
    font-style: italic;
  }
  .details {
    padding: 1.25rem 1.5rem;
  }
  p {
    margin: 0;
  }
  .art {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--c-sand);
  }
  .begegnung {
    margin-block: 0.4rem 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .vs {
    color: var(--c-orange);
    font-style: italic;
    margin-inline: 0.3rem;
  }
  .wo {
    color: rgb(246 241 231 / 0.85);
  }
  .bemerkung {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--c-sand);
  }
</style>
