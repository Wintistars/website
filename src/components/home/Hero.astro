---
// Kopfbereich der Startseite. Bild und Einleitung kommen aus der Seite «home» in Sanity (Teamfoto erscheint weiter unten).
import type { SanityImage } from '../../lib/types';
import { GRUENDUNGSJAHR } from '../../lib/verein';
import SanityPicture from '../SanityPicture.astro';

interface Props {
  bild?: SanityImage | null;
  einleitung?: string;
}

const { bild, einleitung } = Astro.props;
---

<section class:list={['hero', { 'mit-bild': bild?.asset }]}>
  {bild?.asset && <SanityPicture image={bild} widths={[800, 1200, 1600, 2400]} sizes="100vw" eager class="bild" />}
  <div class="container inhalt">
    <p class="kicker">Eishockey · Winterthur · Est. {GRUENDUNGSJAHR}</p>
    <h1>
      <span class="ehc">EHC</span>
      <span class="name">Wintistars</span>
    </h1>
    {einleitung && <p class="lead">{einleitung}</p>}
    <div class="aktionen">
      <a href="/spielplan/" class="btn primaer">Spielplan</a>
      <a href="/team/" class="btn">Das Team</a>
    </div>
  </div>
  <div class="trikotstreifen" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 85% 20%, rgb(185 97 42 / 0.25), transparent 55%),
      var(--c-navy);
    color: var(--c-cream);
    overflow: hidden;
  }
  .hero :global(.bild) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .mit-bild::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(19 24 38 / 0.92) 0%, rgb(19 24 38 / 0.7) 45%, rgb(19 24 38 / 0.15) 100%);
  }
  .inhalt {
    padding-block: clamp(4rem, 12vw, 9rem) clamp(3rem, 8vw, 6rem);
  }
  .kicker {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-sand);
  }
  h1 {
    margin: 0;
    font-style: italic;
    line-height: 0.85;
    text-transform: uppercase;
  }
  .ehc {
    display: block;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--c-orange);
    letter-spacing: 0.1em;
  }
  .name {
    display: block;
    font-size: clamp(4rem, 15vw, 10rem);
    letter-spacing: -0.01em;
  }
  .lead {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    font-size: 1.2rem;
    color: rgb(246 241 231 / 0.85);
  }
  .aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    padding: 0.7rem 1.5rem;
    border: 2px solid var(--c-sand);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .btn:hover {
    background: var(--c-sand);
    color: var(--c-navy);
  }
  .btn.primaer {
    background: var(--c-orange);
    border-color: var(--c-orange);
    color: #fff;
  }
  .btn.primaer:hover {
    background: #a1521f;
    border-color: #a1521f;
  }
</style>
