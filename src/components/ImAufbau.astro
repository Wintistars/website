---
// Platzhalter-Startseite für Vorschau-Builds (siehe src/lib/vorschau.ts).
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow/400.css';
import { LOGO_PLATZHALTER } from '../lib/entwurf';
import { VEREIN } from '../lib/verein';
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1c2232" />
    <title>{VEREIN} – Seite im Aufbau</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <img src={LOGO_PLATZHALTER} alt={`Logo ${VEREIN}`} width="180" height="180" />
      <h1>Seite im Aufbau</h1>
      <p>Die neue Website des {VEREIN} entsteht gerade.</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #1c2232;
    color: #f6f1e7;
    font-family: 'Barlow', system-ui, sans-serif;
  }
  main {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 2rem 1rem;
    text-align: center;
  }
  img {
    width: 180px;
    height: 180px;
    clip-path: circle(47.5%);
    margin-bottom: 1rem;
  }
  h1 {
    margin: 0;
    font: 800 clamp(2rem, 7vw, 3.25rem) / 1 'Barlow Condensed', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  p {
    margin: 0;
    color: #d9c29c;
  }
</style>
