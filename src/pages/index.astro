---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeiteInhalt from '../components/content/SeiteInhalt.astro';
import NewsCard from '../components/NewsCard.astro';
import SpielZeile from '../components/SpielZeile.astro';
import { getHome, getNews } from '../lib/sanity';
import { getNaechstesSpiel } from '../lib/spielplan';
import { VEREIN } from '../lib/verein';

const [home, news, naechstesSpiel] = await Promise.all([getHome(), getNews(6), getNaechstesSpiel()]);
---

<BaseLayout>
  {home ? <SeiteInhalt seite={home} hideTitle /> : <h1>{VEREIN}</h1>}

  {
    naechstesSpiel && (
      <section>
        <h2>Nächstes Spiel</h2>
        <ol class="naechstes">
          <SpielZeile spiel={naechstesSpiel} />
        </ol>
        <p><a href="/spielplan/">Ganzer Spielplan →</a></p>
      </section>
    )
  }

  <section>
    <h2>News</h2>
    {news.length > 0 ? (
      <div class="grid">{news.map((n) => <NewsCard news={n} />)}</div>
    ) : (
      <p class="muted">Noch keine News.</p>
    )}
    <p><a href="/news/">Alle News →</a></p>
  </section>
</BaseLayout>

<style>
  .naechstes {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
