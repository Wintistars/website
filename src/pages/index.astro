---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeiteInhalt from '../components/content/SeiteInhalt.astro';
import NewsCard from '../components/NewsCard.astro';
import { getHome, getNews } from '../lib/sanity';

const [home, news] = await Promise.all([getHome(), getNews(6)]);
---

<BaseLayout>
  {home ? <SeiteInhalt seite={home} hideTitle /> : <h1>EHC Wintistars</h1>}

  <section>
    <h2>News</h2>
    {news.length > 0 ? (
      <div class="grid">{news.map((n) => <NewsCard news={n} />)}</div>
    ) : (
      <p class="muted">Noch keine News.</p>
    )}
    <p><a href="/news/">Alle News →</a></p>
  </section>
</BaseLayout>
