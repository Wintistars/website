---
// Spielerprofil: dieselbe Karte wie in der Kadertafel, dazu der Text aus Sanity.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SanityPicture from '../../components/SanityPicture.astro';
import RichText from '../../components/richtext/RichText.astro';
import { getSpieler } from '../../lib/sanity';
import { POS_EINZEL, zuKaderSpieler } from '../../lib/kader';
import type { Spieler } from '../../lib/types';
import { VEREIN } from '../../lib/verein';

export const getStaticPaths = (async () => {
  const spieler = await getSpieler();
  return spieler.map((s) => ({ params: { slug: s.slug }, props: { spieler: s } }));
}) satisfies GetStaticPaths;

interface Props {
  spieler: Spieler;
}

const { spieler } = Astro.props;
const k = zuKaderSpieler(spieler);
const pos = spieler.position ? POS_EINZEL[spieler.position] : 'Spieler';
---

<BaseLayout title={spieler.name} description={`${spieler.name} – ${pos} beim ${VEREIN}`}>
  <div class="seite wrap">
    <a class="zurueck" href="/team/"><span aria-hidden="true">←</span> Zum Team</a>
    <article class="ktd-karte profil" data-rolle={spieler.position === 'torhueter' ? 'g' : undefined}>
      <div class="ktd-portrait">
        {
          spieler.portrait?.asset ? (
            <SanityPicture
              image={spieler.portrait}
              ratio={3 / 4}
              widths={[400, 600, 900]}
              sizes="(min-width: 761px) 340px, 100vw"
              alt={`Porträt ${spieler.name}`}
              eager
            />
          ) : (
            <div class="ktd-platz">
              <span class="ktd-platz-nr" aria-hidden="true">{k.nummer > 0 ? k.nummer : ''}</span>
              <svg class="ktd-silhouette" viewBox="0 0 200 240" aria-hidden="true">
                <path d="M100 30c-30 0-52 22-52 52v14c0 6 4 10 10 10h4c3 18 18 32 38 32s35-14 38-32h4c6 0 10-4 10-10V82c0-30-22-52-52-52Zm-30 62h60v8H70Z"></path>
                <path d="M20 240c4-46 34-78 80-82 46 4 76 36 80 82Z"></path>
              </svg>
              <span class="ktd-platz-text">Porträt folgt</span>
            </div>
          )
        }
      </div>
      <div class="ktd-text">
        <p class="ktd-pos">{pos}</p>
        {k.nummer > 0 && <p class="ktd-nr" aria-hidden="true">#{k.nummer}</p>}
        <h1 class="ktd-name">
          {k.vorname && <span class="ktd-vorname">{k.vorname}</span>}
          <span class="ktd-nachname">{k.name}</span>
        </h1>
        {k.nummer > 0 && <p class="sr">Rückennummer {k.nummer}</p>}
        {spieler.funktion && <p class="funktion">{spieler.funktion}</p>}
        {
          (spieler.text?.length ?? 0) > 0 && (
            <div class="prose">
              <RichText value={spieler.text} />
            </div>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .profil {
    max-width: 860px;
    box-shadow: var(--sh-blatt);
  }
  .profil :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profil .prose {
    margin-top: 1rem;
    font-size: 1rem;
  }
  .profil[data-rolle='g'] .ktd-platz-nr {
    color: rgb(227 148 106 / 0.14);
  }
  .funktion {
    margin-top: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--creme);
    color: var(--orange-text);
    font: 650 0.75rem/1.2 var(--f-text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 600px) {
    .profil {
      max-height: none;
      border-radius: 14px;
    }
  }
</style>
