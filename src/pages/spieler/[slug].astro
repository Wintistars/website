---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Spieler from '../../storyblok/Spieler.astro';
import { getSpieler, getTeams, teamsVonSpieler } from '../../lib/storyblok';
import type { SpielerStory, TeamStory } from '../../lib/types';

export const getStaticPaths = (async () => {
  const [spieler, teams] = await Promise.all([getSpieler(), getTeams()]);
  return spieler.map((story) => ({
    params: { slug: story.slug },
    props: { story, teams: teamsVonSpieler(story, teams) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  story: SpielerStory;
  teams: TeamStory[];
}

const { story, teams } = Astro.props;
---

<BaseLayout title={story.content.name}>
  <Spieler blok={story.content} teams={teams} />
</BaseLayout>
