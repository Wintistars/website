---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpielerProfil from '../../components/content/SpielerProfil.astro';
import { getSpieler } from '../../lib/sanity';
import type { Spieler } from '../../lib/types';

export const getStaticPaths = (async () => {
  const spieler = await getSpieler();
  return spieler.map((s) => ({ params: { slug: s.slug }, props: { spieler: s } }));
}) satisfies GetStaticPaths;

interface Props {
  spieler: Spieler;
}

const { spieler } = Astro.props;
---

<BaseLayout title={spieler.name}>
  <SpielerProfil spieler={spieler} />
</BaseLayout>
