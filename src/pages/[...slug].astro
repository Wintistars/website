---
// Allgemeine Seiten (Club, Kontakt, …): alle Stories vom Typ "seite" ausser "home".
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Seite from '../storyblok/Seite.astro';
import { getSeiten } from '../lib/storyblok';
import type { SeiteStory } from '../lib/types';

export const getStaticPaths = (async () => {
  const seiten = await getSeiten();
  return seiten.map((story) => ({ params: { slug: story.full_slug.replace(/\/$/, '') }, props: { story } }));
}) satisfies GetStaticPaths;

interface Props {
  story: SeiteStory;
}

const { story } = Astro.props;
---

<BaseLayout title={story.content.titel}>
  <Seite blok={story.content} />
</BaseLayout>
