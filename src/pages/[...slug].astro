---
// Allgemeine Seiten: alle Dokumente vom Typ "seite" ausser "home" (Startseite, Inhalt = «Über uns»).
// Club, Team und Kontakt sind Abschnitte der Startseite, keine eigenen Seiten (Weiterleitung in public/_redirects).
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SektionKopf from '../components/SektionKopf.astro';
import SanityPicture from '../components/SanityPicture.astro';
import RichText from '../components/richtext/RichText.astro';
import { getSeiten } from '../lib/sanity';
import type { Seite } from '../lib/types';

export const getStaticPaths = (async () => {
  const seiten = (await getSeiten()).filter((s) => !['club', 'team', 'kontakt'].includes(s.slug));
  return seiten.map((seite) => ({ params: { slug: seite.slug }, props: { seite } }));
}) satisfies GetStaticPaths;

interface Props {
  seite: Seite;
}

const { seite } = Astro.props;
---

<BaseLayout title={seite.titel} description={seite.einleitung}>
  <article class="seite wrap">
    <SektionKopf kicker="EHC Wintistars" titel={seite.titel} id="seite-titel" ebene={1}>
      {seite.einleitung && <p class="seite-lead">{seite.einleitung}</p>}
    </SektionKopf>
    <SanityPicture
      image={seite.titelbild}
      ratio={21 / 9}
      widths={[640, 960, 1440, 1920]}
      sizes="(min-width: 1240px) 1160px, 100vw"
      eager
      class="titelbild"
    />
    <div class="prose">
      <RichText value={seite.body} />
    </div>
  </article>
</BaseLayout>
