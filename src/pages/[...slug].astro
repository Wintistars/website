---
// Allgemeine Seiten (Club, Kontakt, …): alle Dokumente vom Typ "seite" ausser "home".
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeiteInhalt from '../components/content/SeiteInhalt.astro';
import { getSeiten } from '../lib/sanity';
import type { Seite } from '../lib/types';

export const getStaticPaths = (async () => {
  const seiten = await getSeiten();
  return seiten.map((seite) => ({ params: { slug: seite.slug }, props: { seite } }));
}) satisfies GetStaticPaths;

interface Props {
  seite: Seite;
}

const { seite } = Astro.props;
---

<BaseLayout title={seite.titel}>
  <SeiteInhalt seite={seite} />
</BaseLayout>
