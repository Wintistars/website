---
// Teaminfos & Kader: Singleton "team" in Sanity. Fehlt es (noch), zeigt die Kadertafel «Kader folgt».
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamBand from '../components/team/TeamBand.astro';
import Erfolge from '../components/club/Erfolge.astro';
import RichText from '../components/richtext/RichText.astro';
import { getTeam } from '../lib/sanity';
import { VEREIN } from '../lib/verein';

const team = await getTeam();
const hatText = (team?.beschreibung?.length ?? 0) > 0;
const erfolge = team?.erfolge ?? [];
---

<BaseLayout title="Team" description={`Kader und Teamfoto des ${VEREIN}`}>
  <TeamBand spieler={team?.spieler ?? []} teamfoto={team?.teamfoto} ebene={1} />

  {
    (hatText || team?.trainer || erfolge.length > 0) && (
      <section class="sektion wrap" aria-label="Über das Team">
        <div class="seite-raster">
          <div class="rv" data-rv>
            {hatText && (
              <div class="prose">
                <RichText value={team?.beschreibung} />
              </div>
            )}
            {team?.trainer && (
              <dl class="fakten">
                <div>
                  <dt>Trainer</dt>
                  <dd>{team.trainer}</dd>
                </div>
              </dl>
            )}
          </div>
          <Erfolge erfolge={erfolge} verzoegerung={120} />
        </div>
      </section>
    )
  }
</BaseLayout>
