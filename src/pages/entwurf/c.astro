        </div>
        {
          fotos.length > 1 ? (
            <div class="ges" data-ges>
              <div class="wrap">
                <h3 class="mini ges-kopf" id="h-archiv">Aus dem Archiv</h3>
                <div class="ges-buehne" data-ges-buehne role="region" aria-roledescription="Galerie" aria-labelledby="h-archiv">
