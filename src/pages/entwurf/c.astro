  .hv-spiel {
    display: grid;
    gap: 0.35rem;
    min-width: 15rem;
    padding: 1rem 1.2rem 1.05rem;
    border-radius: var(--r-s);
    background: rgb(255 255 255 / 0.8);
    box-shadow: var(--schatten);
    text-decoration: none;
    transition: transform 0.4s var(--ease);
  }
  .hv-spiel:hover {
    transform: translateY(-2px);
  }
  .hv-spiel-g {
    font: 800 1.35rem/1.05 var(--display);
    font-stretch: 85%;
    text-transform: uppercase;
  }
  .hv-spiel-l {
    margin-top: 0.3rem;
    font: 700 0.85rem/1 var(--text);
    color: var(--rost-d);
  }
  .hv1-bahn {
    position: relative;
    flex: none;
    height: var(--lh);
    overflow-x: clip;
  }
  .hv1-fuss {
    display: flex;
    justify-content: flex-end;
  }
  .hv1-eis,
  .hv1-frost-in {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100vw;
  }
  .hv1-eis {
    /* frisch aufbereitet: hell, klar, mit weichem Spiegelreflex */
    background:
      linear-gradient(100deg, transparent 26%, rgb(214 228 238 / 0.3) 40%, rgb(255 255 255 / 0) 48%, rgb(214 228 238 / 0.18) 54%, transparent 62%),
      linear-gradient(180deg, #ffffff, #f2f6f9);
  }
  /* Center-Ice-Branding: wie unter klarem Eis eingelassen */
  .hv1-marke {
    display: flex;
    align-items: center;
    gap: calc(var(--lh) * 0.12);
    height: 100%;
    padding-left: max(var(--gut), calc(50vw - 620px));
  }
  .hv1-marke img {
    flex: none;
    width: calc(var(--lh) * 0.86);
    height: calc(var(--lh) * 0.86);
    clip-path: circle(47.5%);
  }
  .hv1-wort {
    font: 800 min(calc(var(--lh) * 0.62), (100vw - 2 * var(--gut) - var(--lh)) / 4.6) / 1 var(--display);
    font-stretch: 75%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in srgb, var(--navy) 94%, #6f93ad);
  }
  .hv1-nass {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: clamp(36px, 5vw, 80px);
    display: none;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }
  .hv1-frost {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 200vw;
    overflow: hidden;
    display: none;
    pointer-events: none;
  }
  /* ungepflegtes Eis: matter Grundton, darüber Schneestaub, Kufenspuren und Bremsspuren (Canvas-Textur) */
  .hv1-frost-in {
    background: #e2e7eb;
  }
  .hv1-frost-in::after {
    content: '';
    position: absolute;
    inset: 0;
    --eis-pos: 120px 40px;
    background:
      var(--eis-schnee, none) var(--eis-pos, 0 0) / var(--eis-kachel, 420px 160px),
      radial-gradient(ellipse 70% 45% at 50% 0%, rgb(255 255 255 / 0.5), transparent 70%),
      radial-gradient(ellipse 70% 45% at 50% 100%, rgb(255 255 255 / 0.45), transparent 70%),
      rgb(236 240 243 / 0.4);
  }
  .hv1-geist {
    filter: blur(1px) saturate(0.5);
    opacity: 0.6;
  }
  .hv1-zb {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    /* ohne Bewegung: parkiert am rechten Rand */
    transform: translateX(var(--xe));
  }
  @media (prefers-reduced-motion: no-preference) {
    .e.is-js .hv1-frost,
    .e.is-js .hv1-nass {
      display: block;
    }
    /* bis alles geladen ist: matter Startzustand, Maschine und Spur noch unsichtbar */
    .e.is-js:not(.is-bereit) :is(.hv1-zb, .hv1-nass) {
      visibility: hidden;
    }
    .e.is-bereit .hv1-zb {
      animation: hv1-zb 3s cubic-bezier(0.45, 0.05, 0.35, 1) 0.8s both;
    }
    .e.is-bereit .hv1-frost {
      animation: hv1-frost 3s cubic-bezier(0.45, 0.05, 0.35, 1) 0.8s both;
    }
    .e.is-bereit .hv1-frost-in {
      animation: hv1-frost-in 3s cubic-bezier(0.45, 0.05, 0.35, 1) 0.8s both;
    }
    .e.is-bereit .hv1-nass {
      animation:
        hv1-nass 3s cubic-bezier(0.45, 0.05, 0.35, 1) 0.8s both,
        hv1-trocknen 2.4s ease 3.9s forwards;
    }
  }
  @keyframes hv1-zb {
    from {
      /* ganz ausserhalb, inklusive weichem Schatten */
      transform: translateX(calc(var(--L) * -1 - 24px));
    }
    to {
      transform: translateX(var(--xe));
    }
  }
  @keyframes hv1-frost {
    from {
      transform: translateX(calc(var(--L) * -0.93 - 24px));
    }
    to {
      transform: translateX(calc(var(--xe) + var(--L) * 0.07));
    }
  }
  @keyframes hv1-frost-in {
    from {
      transform: translateX(calc(var(--L) * 0.93 + 24px));
    }
    to {
      transform: translateX(calc(-1 * (var(--xe) + var(--L) * 0.07)));
    }
  }
  @keyframes hv1-nass {
    from {
      transform: translateX(calc(var(--L) * -0.93 - 24px - 100%));
    }
    to {
      transform: translateX(calc(var(--xe) + var(--L) * 0.07 - 100%));
    }
  }
  @keyframes hv1-trocknen {
    to {
      opacity: 0;
    }
  }
  /* Header über dem hellen Hero: hell mit dunkler Schrift */
  .e.hd-hell .hd {
    background: rgb(238 243 246 / 0.86);
    color: var(--navy);
    border-bottom-color: rgb(28 34 50 / 0.08);
  }
  @media (max-width: 699px) {
    .hv1 {
      --xe: calc(100vw + 8px); /* schmal: Maschine fährt ganz hinaus */
      min-height: 0;
      gap: 1.8rem;
    }
    .hv-spiel {
      width: 100%;
    }
  }

  /* ---------- Variante 2: Arena von oben ---------- */
  .hv2 {
    display: grid;
    grid-template-columns: 45fr 55fr;
    min-height: min(100svh, 920px);
    padding-top: 64px;
    background: var(--navy);
    color: var(--creme);
    --ak: #e8884a;
  }
  .hv2 .hv-kicker,
  .hv2 .hv-spiel-k {
    color: #e8884a;
  }
  .hv2-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.9rem, 2.2vh, 1.4rem);
    padding: clamp(2rem, 5vh, 3.5rem) clamp(1.6rem, 4vw, 4rem) clamp(2rem, 5vh, 3.5rem) max(var(--gut), calc(50vw - 620px));
  }
  .hv2-titel {
    display: grid;
    font: 800 clamp(3.6rem, min(12.4vw, 20vh), 11rem) / 0.84 var(--display);
    font-stretch: 75%;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .hv2-ehc {
    font-size: 0.32em;
    letter-spacing: 0.4em;
    color: #e8884a;
    margin-bottom: 0.25em;
  }
  .hv2-lead {
    max-width: 30rem;
    font: 600 clamp(1rem, 1.3vw, 1.12rem) / 1.5 var(--text);
    color: rgb(246 241 231 / 0.85);
  }
  .hv2-spiel {
    display: grid;
    gap: 0.35rem;
    max-width: 30rem;
    padding: 1.1rem 1.2rem 1.2rem;
    border-radius: var(--r-s);
    background: rgb(246 241 231 / 0.06);
    border: 1px solid rgb(246 241 231 / 0.12);
    border-top: 3px solid var(--rost);
  }
  .hv2-spiel-g {
    font: 800 clamp(1.4rem, 2.2vw, 1.9rem) / 1.05 var(--display);
    font-stretch: 85%;
    text-transform: uppercase;
  }
  .hv2-spiel-g span {
    font: 600 0.75rem/1 var(--data);
    letter-spacing: 0.1em;
    color: #e8884a;
    vertical-align: middle;
  }
  .hv2-spiel .hv-spiel-d {
    color: rgb(246 241 231 / 0.75);
  }
  .hv2-cd {
    margin-top: 0.5rem;
    grid-template-columns: repeat(4, 1fr);
  }
  .hv2-cd .cd-u {
    min-width: 0;
    padding: 0.6rem 0.4rem 0.5rem;
    background: rgb(246 241 231 / 0.08);
  }
  .hv2-cd .cd-u b {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }
  .hv2-feld {
    position: relative;
    overflow: hidden;
    container-type: size;
    background: #f1f5f8;
  }
  /* Eisfeld ist eine eigene Komponente: Klassen hier global ansprechen */
  .hv2-feld :global(.hv2-rink) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Bahnen: Masse in Fuss wie das Feld (slice), 2 × 15 ft decken Mittelkreis und Logo ganz ab */
  .hv2-lauf {
    --s: max(100cqw / 100, 100cqh / 85);
    --zh: calc(var(--s) * 15);
    --L: calc(var(--zh) * 264 / 128);
    --W: 100cqw;
    --ease: cubic-bezier(0.45, 0.05, 0.35, 1);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hv2-frost,
  .hv2-nass,
  .hv2-zb {
    display: none;
    position: absolute;
    height: var(--zh);
  }
  .hv2-frost {
    overflow: hidden;
    width: calc(2 * var(--W));
  }
  .hv2-frost-a,
  .hv2-nass-a,
  .hv2-zb-a {
    top: calc(50% - var(--zh));
  }
  .hv2-frost-b,
  .hv2-nass-b,
  .hv2-zb-b {
    top: 50%;
  }
  .hv2-frost-a {
    left: 0;
  }
  .hv2-frost-b {
    right: 0;
  }
  .hv2-frost-in {
    position: absolute;
    left: 0;
    width: var(--W);
    height: 100cqh;
  }
  .hv2-frost-a .hv2-frost-in {
    top: calc(var(--zh) - 50cqh);
  }
  .hv2-frost-b .hv2-frost-in {
    left: 50%;
    top: -50cqh;
  }
  /* ungepflegtes Eis: statisch verschwommen, matt, grau-weiss, mit Kufenspuren und Schneestaub */
  .hv2-feld :global(.hv2-rink-matt) {
    filter: blur(1px) saturate(0.55);
    opacity: 0.7;
  }
  .hv2-frost-in {
    background: #e2e7eb;
  }
  .hv2-frost-in::after {
    content: '';
    position: absolute;
    inset: 0;
    --eis-pos: 60px 30px;
    background:
      var(--eis-schnee, none) var(--eis-pos, 0 0) / var(--eis-kachel, 420px 160px),
      radial-gradient(ellipse 70% 45% at 50% 0%, rgb(255 255 255 / 0.5), transparent 70%),
      radial-gradient(ellipse 70% 45% at 50% 100%, rgb(255 255 255 / 0.45), transparent 70%),
      rgb(236 240 243 / 0.42);
  }
  .hv2-nass {
    left: 0;
    width: clamp(30px, 4cqw, 70px);
  }
  .hv2-nass-a {
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }
  .hv2-nass-b {
    background: linear-gradient(270deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }
  .hv2-zb {
    left: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .e.is-js .hv2-frost,
    .e.is-js .hv2-nass,
    .e.is-js .hv2-zb {
      display: block;
    }
    .e.is-js:not(.is-bereit) :is(.hv2-zb, .hv2-nass) {
      visibility: hidden;
    }
    /* 0.8 s ungepflegt stehen lassen, dann Bahn A (links → rechts), danach Bahn B (rechts → links) */
    .e.is-bereit .hv2-zb-a {
      animation: hv2-zb-a 1.9s var(--ease) 0.8s both;
    }
    .e.is-bereit .hv2-frost-a {
      animation: hv2-frost-a 1.9s var(--ease) 0.8s both;
    }
    .e.is-bereit .hv2-frost-a .hv2-frost-in {
      animation: hv2-frost-a-in 1.9s var(--ease) 0.8s both;
    }
    .e.is-bereit .hv2-nass-a {
      animation:
        hv2-nass-a 1.9s var(--ease) 0.8s both,
        hv2-trocknen 1.6s ease 2.8s forwards;
    }
    .e.is-bereit .hv2-zb-b {
      animation: hv2-zb-b 1.9s var(--ease) 2.7s both;
    }
    .e.is-bereit .hv2-frost-b {
      animation: hv2-frost-b 1.9s var(--ease) 2.7s both;
    }
    .e.is-bereit .hv2-frost-b .hv2-frost-in {
      animation: hv2-frost-b-in 1.9s var(--ease) 2.7s both;
    }
    .e.is-bereit .hv2-nass-b {
      animation:
        hv2-nass-b 1.9s var(--ease) 2.7s both,
        hv2-trocknen 1.6s ease 4.7s forwards;
    }
  }
  @keyframes hv2-zb-a {
    from {
      transform: translateX(calc(-1 * var(--L)));
    }
    to {
      transform: translateX(var(--W));
    }
  }
  @keyframes hv2-frost-a {
    from {
      transform: translateX(calc(-0.93 * var(--L)));
    }
    to {
      transform: translateX(calc(var(--W) + 0.07 * var(--L)));
    }
  }
  @keyframes hv2-frost-a-in {
    from {
      transform: translateX(calc(0.93 * var(--L)));
    }
    to {
      transform: translateX(calc(-1 * var(--W) - 0.07 * var(--L)));
    }
  }
  @keyframes hv2-nass-a {
    from {
      transform: translateX(calc(-100% - 0.93 * var(--L)));
    }
    to {
      transform: translateX(calc(var(--W) + 0.07 * var(--L) - 100%));
    }
  }
  @keyframes hv2-zb-b {
    from {
      transform: translateX(var(--W));
    }
    to {
      transform: translateX(calc(-1 * var(--L)));
    }
  }
  @keyframes hv2-frost-b {
    from {
      transform: translateX(calc(0.93 * var(--L)));
    }
    to {
      transform: translateX(calc(-1 * var(--W) - 0.07 * var(--L)));
    }
  }
  @keyframes hv2-frost-b-in {
    from {
      transform: translateX(calc(-0.93 * var(--L)));
    }
    to {
      transform: translateX(calc(var(--W) + 0.07 * var(--L)));
    }
  }
  @keyframes hv2-nass-b {
    from {
      transform: translateX(calc(var(--W) + 0.93 * var(--L)));
    }
    to {
      transform: translateX(calc(-0.07 * var(--L)));
    }
  }
  @keyframes hv2-trocknen {
    to {
      opacity: 0;
    }
  }
  @media (max-width: 860px) {
    .hv2 {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hv2-feld {
      order: -1;
      height: clamp(260px, 72vw, 320px);
    }
    .hv2-text {
      padding: 2rem var(--gut) 2.6rem;
    }
    .hv2-titel {
      font-size: clamp(3.4rem, 19vw, 6rem);
    }
  }

  /* ============ Nächstes Spiel ============ */
  .match {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1.4rem, 3.5vw, 3rem);
    padding: clamp(1.2rem, 2.5vw, 2rem);
    border-radius: var(--r);
    background: #fff;
    box-shadow: var(--schatten);
  }
  .match-date {
    display: grid;
    justify-items: center;
    align-content: center;
    width: clamp(110px, 12vw, 150px);
    aspect-ratio: 1;
    border-radius: var(--r-s);
    background: var(--rost);
    color: #fff;
    text-transform: uppercase;
  }
  .md-wt,
  .md-mo {
    font: 700 0.85rem/1 var(--data);
    letter-spacing: 0.14em;
  }
  .md-tag {
    font: 800 clamp(3.2rem, 5vw, 4.6rem) / 0.95 var(--display);
    font-stretch: 75%;
  }
  .match-when {
    font: 600 0.82rem/1.3 var(--data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ak);
  }
  .match-teams {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.7rem;
    margin: 0.5rem 0 0.4rem;
    font: 800 clamp(1.8rem, 3.6vw, 3.2rem) / 1 var(--display);
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .mt-wir {
    color: var(--rost-d);
  }
  .mt-vs {
    font: 600 0.9rem/1 var(--data);
    color: rgb(28 34 50 / 0.5);
    text-transform: lowercase;
  }
  .match-ort {
    color: rgb(28 34 50 / 0.75);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .tags li {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--eis);
    font: 600 0.72rem/1 var(--data);
    letter-spacing: 0.06em;
  }
  .cd {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 0.4rem;
  }
  .cd-u {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    min-width: 64px;
    padding: 0.8rem 0.5rem 0.6rem;
    border-radius: 12px;
    background: var(--navy);
    color: var(--creme);
  }
  .cd-u b {
    font: 700 clamp(1.6rem, 2.6vw, 2.2rem) / 1 var(--data);
    font-variant-numeric: tabular-nums;
  }
  .cd-u span {
    font: 600 0.62rem/1 var(--data);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .match-cal {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.4rem;
    font: 600 0.82rem/1 var(--data);
    color: var(--rost-d);
    text-underline-offset: 3px;
  }
  .match-leer {
    grid-template-columns: 1fr;
  }
  @media (max-width: 1080px) {
    .match {
      grid-template-columns: auto 1fr;
    }
    .cd {
      grid-column: 1 / -1;
      justify-content: start;
    }
  }
  @media (max-width: 560px) {
    .match {
      grid-template-columns: 1fr;
    }
    .match-date {
      width: 100%;
      aspect-ratio: auto;
      grid-auto-flow: column;
      gap: 0.8rem;
      justify-content: start;
      align-items: baseline;
      padding: 0.8rem 1rem;
    }
    .cd {
      grid-template-columns: repeat(4, 1fr);
    }
    .cd-u {
      min-width: 0;
    }
  }
  .plan {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .games {
    border-top: 2px solid var(--fg);
  }
  .game {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--linie);
  }
  .g-date {
    display: grid;
    gap: 0.15rem;
  }
  .g-date b {
    font: 800 2rem/1 var(--display);
    font-stretch: 75%;
  }
  .g-date span {
    font: 600 0.68rem/1 var(--data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ak);
  }
  .g-score b {
    font: 700 1.5rem/1 var(--data);
  }
  .g-main {
    display: grid;
    gap: 0.15rem;
  }
  .g-opp {
    font: 700 1.15rem/1.2 var(--display);
  }
  .g-opp em {
    font: 600 0.72rem/1 var(--data);
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ak);
    margin-right: 0.3rem;
  }
  .g-ort {
    display: block;
  }
  .g-meta {
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .leer {
    opacity: 0.75;
  }
  .res-leer {
    border-top: 2px solid var(--fg);
  }
  .skel li {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px dashed var(--linie);
  }
  .skel span {
    height: 10px;
    border-radius: 99px;
    background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--fg) 22%, transparent) 0 7px, transparent 7px 12px);
  }
  .skel span:first-child {
    width: 2.8rem;
  }
  .skel li:nth-child(2) span:last-child {
    width: 70%;
  }
  .skel li:nth-child(3) span:last-child {
    width: 55%;
  }
  .res-leer p {
    margin: 1rem 0 1.4rem;
    font-size: 0.92rem;
    opacity: 0.85;
  }
  .res-leer b {
    display: block;
    font: 800 1.4rem/1.1 var(--display);
    font-stretch: 85%;
    text-transform: uppercase;
  }
  @media (max-width: 800px) {
    .plan {
      grid-template-columns: 1fr;
    }
  }

  /* ============ News ============ */
  .news {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
  }
  .news-in {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
    padding: 1.4rem;
    border-radius: var(--r);
    background: var(--creme);
    color: var(--navy);
    text-decoration: none;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  a.news-in:hover {
    transform: translateY(-6px) rotate(-0.4deg);
    box-shadow: 0 24px 40px -26px rgb(0 0 0 / 0.45);
  }
  .news-img {
    margin: -0.6rem -0.6rem 0.2rem;
    overflow: hidden;
    border-radius: var(--r-s);
  }
  .news-img img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .news-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font: 600 0.74rem/1 var(--data);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rost-d);
  }
  .news-i {
    font: 800 2.4rem/1 var(--display);
    font-stretch: 75%;
    color: var(--rost);
  }
  .news-t {
    font: 800 clamp(1.5rem, 2.2vw, 1.9rem) / 1.02 var(--display);
    font-stretch: 85%;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .news-l {
    font-size: 0.94rem;
    color: rgb(28 34 50 / 0.78);
  }
  .news-ph,
  .news-go {
    margin-top: auto;
    align-self: flex-start;
    font: 600 0.72rem/1 var(--data);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .news-ph {
    padding: 0.35rem 0.6rem;
    border: 1px dashed rgb(28 34 50 / 0.4);
    border-radius: 999px;
    color: rgb(28 34 50 / 0.7);
  }
  .news-go {
    color: var(--rost-d);
  }
  @media (max-width: 699px) {
    /* Mobile: Karten seitlich wischen statt untereinander */
    .news {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gut));
      padding-inline: var(--gut);
      scroll-padding-inline: var(--gut);
    }
    .news-card {
      scroll-snap-align: start;
    }
  }

  /* ============ Mannschaft ============ */
  .foto {
    position: relative;
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }
  .foto img,
  .foto-ph {
    width: 100%;
    aspect-ratio: 16 / 5;
    min-height: 200px;
    border-radius: var(--r);
    object-fit: cover;
  }
  .foto-ph {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, #2a3350, #151a28);
  }
  /* Bauchstreifen: Orange, Crème, Sand (breit), Crème, Orange */
  .foto-band {
    position: absolute;
    inset: 54% 0 auto;
    height: 22%;
    background: linear-gradient(#b9612a 0 16%, #f6f1e7 16% 26%, #d9c29c 26% 74%, #f6f1e7 74% 84%, #b9612a 84% 100%);
    transform: skewY(-4deg);
  }
  .foto-t {
    position: relative;
    margin-top: -12%;
    font: 800 clamp(2rem, 5vw, 4.4rem) / 1 var(--display);
    font-stretch: 75%;
    text-transform: uppercase;
    color: var(--creme);
  }
  .foto figcaption {
    margin-top: 0.7rem;
    font: 600 0.72rem/1 var(--data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .kader {
    display: grid;
    grid-template-columns: 1fr 1.25fr 2.1fr;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    align-items: start;
  }
  .k-titel {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 3px solid var(--navy);
    box-shadow: 0 3px 0 #b9612a;
  }
  .k-titel b {
    font: 800 1.7rem/1 var(--display);
    font-stretch: 75%;
    text-transform: uppercase;
  }
  .k-titel span {
    font: 600 0.75rem/1 var(--data);
    color: var(--ak);
  }
  .k-sturm .k-liste {
    columns: 2;
    column-gap: clamp(1.2rem, 2.5vw, 2.2rem);
  }
  .k-liste li {
    break-inside: avoid;
    border-bottom: 1px solid var(--linie);
  }
  .k-row {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.45rem 0.1rem;
    text-decoration: none;
    transition: color 0.25s;
  }
  a.k-row:hover {
    color: var(--rost-d);
  }
  .k-nr {
    font: 800 1.6rem/1 var(--display);
    font-stretch: 75%;
    color: var(--rost-d);
    font-variant-numeric: tabular-nums;
  }
  .k-name {
    font: 600 0.92rem/1.2 var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .k-name b {
    font: 800 1.05rem/1 var(--display);
    font-stretch: 85%;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .kader {
      grid-template-columns: 1fr 1fr;
    }
    .k-sturm {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .kader {
      grid-template-columns: 1fr;
    }
    .k-sturm .k-liste {
      columns: 1;
    }
  }
  .sek-in > .mini {
    margin-top: 0.4rem;
  }

  /* ============ Spielerkarte ============ */
  .e.is-js [data-spieler] {
    cursor: pointer;
    border-radius: 6px;
  }
  .e.is-js span.k-row:hover {
    color: var(--rost-d);
  }
  .sk {
    width: min(720px, 92vw);
    max-width: none;
    padding: 0;
    border: 0;
    border-radius: var(--r);
    background: var(--creme);
    color: var(--navy);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.55);
    overflow: hidden;
  }
  .sk::backdrop {
    background: rgb(18 23 38 / 0.62);
  }
  .sk-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
  .sk-bild {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #eef3f6;
  }
  .sk-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sk-foto[hidden],
  .sk-ph[hidden] {
    display: none;
  }
  /* Platzhalter: helle Eisfläche mit dezenten Kufenspuren, Silhouette und grosser Nummer */
  .sk-ph {
    position: absolute;
    inset: 0;
    display: grid;
    background:
      var(--eis-schnee, none) 40px 30px / var(--eis-kachel, 420px 160px),
      linear-gradient(180deg, #f6f9fb, #e6edf2);
  }
  .sk-ph::before {
    /* Kufenspuren nur angedeutet */
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(246 249 251 / 0.55);
  }
  .sk-ph-nr {
    position: absolute;
    top: 4%;
    left: 0;
    right: 0;
    text-align: center;
    font: 800 clamp(7rem, 22vw, 12rem) / 1 var(--display);
    font-stretch: 75%;
    color: rgb(28 34 50 / 0.08);
  }
  .sk-sil {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 0;
    width: 76%;
    height: auto;
  }
  .sk-sil path {
    fill: var(--navy);
  }
  .sk-sil .sk-sil-gitter {
    fill: none;
    stroke: var(--sand);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .sk-ph-t {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    font: 600 0.68rem/1 var(--data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rost-d);
  }
  .sk-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.2rem, 3vw, 2rem);
  }
  .sk-nr {
    font: 800 clamp(3.6rem, 8vw, 5.6rem) / 0.9 var(--display);
    font-stretch: 75%;
    color: var(--rost-d);
  }
  .sk-name {
    font: 600 1.2rem/1.15 var(--text);
  }
  .sk-name b {
    display: block;
    font: 800 clamp(2rem, 4.4vw, 2.8rem) / 0.95 var(--display);
    font-stretch: 80%;
    text-transform: uppercase;
  }
  .sk-pos {
    margin-top: 0.3rem;
    font: 600 0.78rem/1 var(--data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(28 34 50 / 0.65);
  }
  .sk-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.6rem;
    font: 700 0.92rem/1 var(--text);
    color: var(--rost-d);
    text-underline-offset: 3px;
  }
  .sk-link[hidden] {
    display: none;
  }
  .sk-nav {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.2rem;
  }
  .sk-pfeil,
  .sk-zu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(28 34 50 / 0.07);
    color: var(--navy);
    cursor: pointer;
    transition: background-color 0.25s;
  }
  .sk-pfeil:hover,
  .sk-zu:hover {
    background: rgb(28 34 50 / 0.14);
  }
  .sk-pfeil svg,
  .sk-zu svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sk-zahl {
    font: 600 0.8rem/1 var(--data);
    letter-spacing: 0.08em;
    color: rgb(28 34 50 / 0.7);
  }
  .sk-zu {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 4;
  }
  /* Mobile: Bottom-Sheet */
  @media (max-width: 640px) {
    .sk {
      width: 100%;
      margin: auto 0 0;
      border-radius: var(--r) var(--r) 0 0;
    }
    .sk[open] {
      animation: sk-hoch 0.35s var(--ease);
    }
    .sk-in {
      grid-template-columns: 40% 1fr;
    }
    .sk-text {
      padding: 1.1rem 1rem 1.2rem;
      gap: 0.25rem;
    }
    .sk-nr {
      font-size: 3rem;
    }
    .sk-name b {
      font-size: 1.6rem;
    }
    .sk-nav {
      padding-top: 0.6rem;
      gap: 0.5rem;
    }
    .sk-ph-nr {
      font-size: 7rem;
    }
    .sk-ph-t {
      top: auto;
      bottom: 0.6rem;
      left: 0.5rem;
      font-size: 0.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk[open] {
      animation: none;
    }
  }
  @keyframes sk-hoch {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }

  /* ============ Seit 1993 ============ */
  .club {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .club-text {
    font: 600 clamp(1.2rem, 1.9vw, 1.6rem) / 1.4 var(--display);
    letter-spacing: -0.005em;
    max-width: 36ch;
  }
  .erfolge .mini {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .erfolge .mini::before {
    content: '';
    width: 34px;
    height: 8px;
    background: linear-gradient(#b9612a 0 1.5px, #f6f1e7 1.5px 2.5px, #d9c29c 2.5px 5.5px, #f6f1e7 5.5px 6.5px, #b9612a 6.5px 8px);
  }
  .erfolge li {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-top: 1px solid var(--linie);
  }
  .erfolge li:last-child {
    border-bottom: 1px solid var(--linie);
  }
  .erfolge b {
    font: 800 1.6rem/1 var(--display);
    font-stretch: 75%;
    color: var(--ak);
  }
  .erfolge span {
    font-size: 0.95rem;
  }
  @media (max-width: 860px) {
    .club {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .erfolge li {
      grid-template-columns: 4.4rem 1fr;
    }
  }

  /* Archivfotos: ohne JS eine einfache Bildliste, mit JS eine klickbare Galerie */
  .ges {
    margin-top: clamp(2.4rem, 6vh, 3.6rem);
  }
  .ges-kopf {
    margin-bottom: 1rem;
  }
  .ges-liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .ges-foto img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-s);
  }
  .ges-foto figure {
    margin: 0;
  }
  .ges-foto figcaption {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin-top: 0.6rem;
    font-size: 0.88rem;
  }
  .ges-foto figcaption b {
    font: 600 0.8rem/1 var(--data);
    color: var(--ak);
  }
  .ges-frost,
  .ges-gross,
  .ges-nass,
  .ges-zb,
  .ges-pfeil,
  .ges-leiste,
  .ges-lb {
    display: none;
  }

  /* ---------- Galerie (mit JS) ---------- */
  :global(.e.is-js) .ges-buehne {
    position: relative;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--r);
    background: #0e121c;
    touch-action: pan-y;
  }
  :global(.e.is-js) .ges-buehne:focus-visible {
    outline: 3px solid var(--fokus);
    outline-offset: 4px;
  }
  :global(.e.is-js) .ges-liste {
    display: block;
    position: absolute;
    inset: 0;
  }
  :global(.e.is-js) .ges-foto {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  :global(.e.is-js) .ges-foto.is-aktiv {
    visibility: visible;
    z-index: 1;
  }
  :global(.e.is-js) .ges-foto.is-neu {
    visibility: visible;
    z-index: 2;
  }
  :global(.e.is-js) .ges-scharf {
    position: absolute;
    inset: 0;
  }
  :global(.e.is-js) .ges-scharf img {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
  }
  :global(.e.is-js) .ges-scharf figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  /* Foto unter mattem, zerkratztem Eis: statische, verschwommene Ebene (Blur wird nie animiert) */
  :global(.e.is-js) .ges-frost {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    background: #cfd6dc;
  }
  :global(.e.is-js) .ges-frost img {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    object-fit: cover;
    filter: blur(1px) saturate(0.45) brightness(1.06);
  }
  :global(.e.is-js) .ges-frost::after {
    content: '';
    position: absolute;
    inset: 0;
    --eis-pos: 200px 80px;
    background:
      var(--eis-schnee, none) var(--eis-pos, 0 0) / var(--eis-kachel, 420px 160px),
      radial-gradient(ellipse 70% 45% at 50% 0%, rgb(255 255 255 / 0.5), transparent 70%),
      radial-gradient(ellipse 70% 45% at 50% 100%, rgb(255 255 255 / 0.45), transparent 70%),
      rgb(232 237 241 / 0.5);
  }
  @media (max-width: 699px) {
    :global(.e.is-js) .ges-frost img {
      filter: saturate(0.45) brightness(1.06);
    }
  }
  /* Klickfläche für die Lightbox */
  :global(.e.is-js) .ges-gross {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 0;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }
  /* schmale, nasse Spur direkt hinter dem Abzieher */
  :global(.e.is-js) .ges-nass {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 3;
    width: clamp(36px, 5vw, 80px);
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }
  :global(.e.is-js) .ges-nass.is-links {
    background: linear-gradient(270deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) calc(100% - 7px), rgb(170 195 215 / 0.22) calc(100% - 3px), rgb(255 255 255 / 0.9));
  }
  :global(.e.is-js) .ges-zb {
    display: block;
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 4;
    height: clamp(72px, 12vw, 150px);
    translate: 0 -50%;
    transform: translateX(-120%);
    visibility: hidden;
    pointer-events: none;
  }
  .ges-zb > div {
    height: 100%;
  }
  .ges-zb-gedreht,
  .ges-zb.is-links .ges-zb-gerade {
    display: none;
  }
  .ges-zb.is-links .ges-zb-gedreht {
    display: block;
  }
  /* Pfeile: gross und gut sichtbar */
  :global(.e.is-js) .ges-pfeil {
    display: grid;
    place-items: center;
    position: absolute;
    top: 50%;
    z-index: 5;
    width: clamp(44px, 5vw, 60px);
    aspect-ratio: 1;
    translate: 0 -50%;
    border: 0;
    border-radius: 50%;
    background: rgb(246 241 231 / 0.94);
    color: var(--navy);
    box-shadow: 0 8px 24px -10px rgb(0 0 0 / 0.5);
    cursor: pointer;
    transition:
      transform 0.3s var(--ease),
      background-color 0.25s;
  }
  .ges-pfeil:hover {
    background: #fff;
    transform: scale(1.06);
  }
  .ges-pfeil svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ges-zurueck {
    left: clamp(10px, 1.6vw, 20px);
  }
  .ges-weiter {
    right: clamp(10px, 1.6vw, 20px);
  }
  /* Legende, Punkte, Zähler */
  :global(.e.is-js) .ges-leiste {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.6rem;
    margin-top: 1.1rem;
  }
  .ges-leg {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0;
    transition: opacity 0.3s ease;
  }
  .ges-leg.is-weg {
    opacity: 0;
  }
  .ges-leg b {
    font: 800 clamp(1.5rem, 2.4vw, 2rem) / 1 var(--display);
    font-stretch: 75%;
    color: var(--ak);
  }
  .ges-leg span {
    font: 600 1rem/1.3 var(--text);
  }
  .ges-nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .ges-punkte {
    display: flex;
    gap: 0;
    margin-inline: -10px;
  }
  .ges-punkte button {
    display: block;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }
  .ges-punkte button::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    translate: -50% -50%;
    border-radius: 999px;
    background: rgb(246 241 231 / 0.35);
    transition:
      width 0.3s var(--ease),
      background-color 0.3s;
  }
  .ges-punkte button[aria-current='true']::after {
    width: 22px;
    background: var(--ak);
  }
  .ges-zahl {
    margin: 0;
    font: 600 0.8rem/1 var(--data);
    letter-spacing: 0.1em;
    opacity: 0.75;
    white-space: nowrap;
  }
  .ges-zahl b {
    font-weight: 700;
  }
  /* Lightbox */
  :global(.e.is-js) .ges-lb[open] {
    display: grid;
    place-items: center;
    gap: 1rem;
