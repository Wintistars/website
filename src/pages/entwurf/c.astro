                  </ol>
                  <button class="ges-gross" type="button" data-ges-gross tabindex="-1" aria-hidden="true"></button>
                  <div class="ges-nass" data-ges-nass aria-hidden="true"></div>
                  <div class="ges-zb" data-ges-zb aria-hidden="true">
                    <div class="ges-zb-gerade">
                      <Eismaschine logo={LOGO_PLATZHALTER} richtung={1} />
                    </div>
                    <div class="ges-zb-gedreht">
                      <Eismaschine logo={LOGO_PLATZHALTER} richtung={-1} />
                    </div>
                  </div>
                  <button class="ges-pfeil ges-zurueck" type="button" data-ges-zurueck aria-label="Vorheriges Foto">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
                  </button>
                  <button class="ges-pfeil ges-weiter" type="button" data-ges-weiter aria-label="Nächstes Foto">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                  </button>
                </div>
                <div class="ges-leiste">
                  <p class="ges-leg" data-ges-leg aria-live="polite">
                    <b data-ges-jahr>{fotos[0].jahr ?? 'Archiv'}</b>
                    <span data-ges-titel>{fotos[0].kurz}</span>
                  </p>
                  <div class="ges-nav">
                    <ul class="ges-punkte">
                      {fotos.map((f, i) => (
                        <li>
                          <button type="button" data-ges-punkt={i} aria-label={`Foto ${i + 1}: ${f.titel}`} aria-current={i === 0 ? 'true' : undefined}></button>
                        </li>
                      ))}
                    </ul>
                    <p class="ges-zahl" aria-live="polite">
                      <b data-ges-nr>01</b> / {nr(fotos.length)}
                    </p>
                  </div>
                </div>
              </div>
              <dialog class="ges-lb" data-ges-lb aria-label="Foto gross">
                <button class="ges-lb-zu" type="button" data-ges-lb-zu aria-label="Schliessen">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
                <img data-ges-lb-bild src={fotos[0].url} alt={fotos[0].titel} />
                <p class="ges-leg"><b data-ges-lb-jahr>{fotos[0].jahr ?? 'Archiv'}</b> <span data-ges-lb-titel>{fotos[0].kurz}</span></p>
              </dialog>
            </div>
          ) : (
            fotos.length === 1 && (
              <figure class="wrap ges-einzel" data-reveal>
                <img src={fotos[0].url} alt={fotos[0].titel} width={fotos[0].breite} height={fotos[0].hoehe} loading="lazy" decoding="async" />
                <figcaption>
                  <b>{fotos[0].jahr ?? 'Archiv'}</b> {fotos[0].kurz}
