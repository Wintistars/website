---
// ENTWURF E – «Eiszeit»: Jeder Abschnitt beginnt mit einem Titelband aus Eis. Beim Hineinscrollen fährt die
// Eismaschine (Draufsicht) einmal gerade hindurch und macht aus mattem Trainingseis frisches, glänzendes Eis.
// Nur Design-Studie, wird vor dem definitiven Design entfernt.
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
// Schriften vorladen, damit sich der Startzustand nicht durch einen späten Schriftwechsel verschiebt
import fontDisplay from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import fontText from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import fontData from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import EntwurfLayout from '../../layouts/EntwurfLayout.astro';
import Eismaschine from '../../components/entwurf/c/Eismaschine.astro';
import { eisTexturDaten } from '../../components/entwurf/eisTextur';
import Titelband from '../../components/entwurf/c/Titelband.astro';
import Eisfeld from '../../components/entwurf/c/Eisfeld.astro';
import { getEntwurfDaten, LOGO_PLATZHALTER, POSITION_LABEL } from '../../lib/entwurf';
import { ART_LABEL, ausgang, gegner, type Spiel } from '../../lib/spielplan';
import { datumTeile, formatUhrzeit, ZEITZONE } from '../../lib/zeit';
import { GRUENDUNGSJAHR, VEREIN } from '../../lib/verein';
import type { SpielerPosition } from '../../lib/types';

const d = await getEntwurfDaten();
const naechstes = d.naechstes;
const weitere = d.kommend.filter((s) => s.id !== naechstes?.id).slice(0, 4);
const resultate = d.resultate.slice(0, 4);

const NAV = [
  { href: '/news/', label: 'News' },
  { href: '/team/', label: 'Team' },
  { href: '/spielplan/', label: 'Spielplan' },
  { href: '/club/', label: 'Club' },
  { href: '/kontakt/', label: 'Kontakt' },
];

const [jahrJetzt, monatJetzt] = new Date()
  .toLocaleDateString('en-CA', { timeZone: ZEITZONE, year: 'numeric', month: '2-digit' })
  .split('-')
  .map(Number);
const saisonStart = monatJetzt >= 7 ? jahrJetzt : jahrJetzt - 1;
const SAISON = `${saisonStart}/${String((saisonStart + 1) % 100).padStart(2, '0')}`;

const datum = (s: Spiel, o: Intl.DateTimeFormatOptions) => s.beginn.toLocaleDateString('de-CH', { timeZone: ZEITZONE, ...o });
const ns = naechstes
  ? {
      wt: datum(naechstes, { weekday: 'short' }).replace('.', ''),
      tag: datum(naechstes, { day: 'numeric' }),
      monat: datum(naechstes, { month: 'short' }).replace('.', ''),
      monatLang: datum(naechstes, { month: 'long' }),
      wochentag: datum(naechstes, { weekday: 'long' }),
      zeit: formatUhrzeit(naechstes.beginn),
      gegner: gegner(naechstes),
      wir: naechstes.wir,
      ort: naechstes.ort,
      art: ART_LABEL[naechstes.art],
      seite: naechstes.wir === 'heim' ? 'Heimspiel' : naechstes.wir === 'gast' ? 'Auswärts' : undefined,
      wettbewerb: naechstes.wettbewerb,
      iso: naechstes.beginn.toISOString(),
    }
  : undefined;

// Hero-Variante: Standard 2 («Arena von oben»), umschaltbar per ?hero=1 / ?hero=2 (siehe Inline-Skript)
const HERO_STANDARD = '2';
const nsKurz = naechstes
  ? {
      datum: datum(naechstes, { day: '2-digit', month: '2-digit' }),
      wt: datum(naechstes, { weekday: 'short' }).replace('.', ''),
    }
  : undefined;

const EIS_TEXTUR = `url("${eisTexturDaten()}")`;

const kurzOrt = (s: Spiel) => s.ort?.split(',')[0];
function score(s: Spiel): string {
  if (!s.resultat) return '–';
  const { heim, gast } = s.resultat;
  return s.wir === 'gast' ? `${gast}:${heim}` : `${heim}:${gast}`;
}
const AUSGANG = { sieg: 'Sieg', niederlage: 'Niederlage', unentschieden: 'Unentschieden' } as const;
const newsDatum = (iso: string) =>
  new Date(iso.length === 10 ? `${iso}T12:00:00Z` : iso).toLocaleDateString('de-CH', {
    timeZone: ZEITZONE,
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
const nr = (n: number) => String(n).padStart(2, '0');

const GRUPPEN: { p: SpielerPosition; titel: string }[] = [
  { p: 'torhueter', titel: 'Torhüter' },
  { p: 'verteidiger', titel: 'Verteidigung' },
  { p: 'sturm', titel: 'Sturm' },
];
const kader = GRUPPEN.map((g) => ({
  ...g,
  spieler: d.spieler.filter((s) => s.position === g.p).sort((a, b) => a.nummer - b.nummer),
})).filter((g) => g.spieler.length > 0);
// Spielerkarte: alle Spieler in Nummernreihenfolge (Blättern), Daten als JSON für das Skript
const kaderAlle = kader.flatMap((g) => g.spieler).sort((a, b) => a.nummer - b.nummer);
const kaderJson = JSON.stringify(
  kaderAlle.map((s) => ({
    nr: s.nummer,
    vorname: s.vorname,
    name: s.name,
    pos: POSITION_LABEL[s.position],
    slug: s.slug ?? null,
    bild: s.bild ?? null,
  })),
).replace(/</g, '\\u003c');

const meisterTitel = d.erfolge
  .filter((e) => e.saison.trim() && e.saison !== '–')
  .sort((a, b) => a.saison.localeCompare(b.saison));
const weitereErfolge = d.erfolge.filter((e) => !e.saison.trim() || e.saison === '–');
// Archivfotos für «Seit 1993»: höchstens fünf verschiedene Bilder als klickbare Galerie. Jahr nur, wenn es im Titel steht.
const fotos = d.archiv
  .filter((f, i, alle) => alle.findIndex((x) => x.url === f.url) === i)
  .slice(0, 5)
  .map((f) => {
    const jahr = f.titel.match(/\d{4}(?:\/\d{2})?/)?.[0];
    // kleine Version für die verschwommene Frost-Ebene (Wix skaliert über w_/h_ in der URL)
    const klein = f.url.replace(/w_(\d+),h_(\d+)/, (_m, w: string, h: string) => `w_480,h_${Math.round((Number(h) * 480) / Number(w))}`);
    return { ...f, jahr, klein, kurz: jahr ? f.titel.replace(jahr, '').trim() : f.titel };
  });
---

<EntwurfLayout title="Entwurf C – Eiszeit" bg="#1c2232">
  <Fragment slot="head">
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontData} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <div class="e" data-e data-hero={HERO_STANDARD} style={`--eis-schnee:${EIS_TEXTUR};--eis-kachel:960px 480px`}>
    <script is:inline>
      // Läuft synchron vor dem Hero: Variante und is-js stehen ab dem ersten Frame fest.
      (function (el) {
        var v = new URLSearchParams(location.search).get('hero');
        if (v === '1' || v === '2') el.dataset.hero = v;
        el.classList.add('is-js');
      })(document.currentScript.parentElement);
    </script>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <Eismaschine defs />

    <header class="hd">
      <a class="brand" href="#inhalt" aria-label={`${VEREIN} – nach oben`}>
        <span class="brand-logo"><img src={LOGO_PLATZHALTER} alt="" width="640" height="640" /></span>
        <span class="brand-name">Wintistars</span>
      </a>
      <nav class="hd-nav" aria-label="Hauptnavigation">
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <button class="hd-menu" type="button" aria-expanded="false" aria-controls="e-menu" data-menu-btn>
        <span>Menü</span>
        <span class="hd-menu-i" aria-hidden="true"><span></span><span></span></span>
      </button>
    </header>

    <div class="menu" id="e-menu" data-menu hidden>
      <nav aria-label="Hauptnavigation (mobil)">
        <ol>
          {
            NAV.map((n, i) => (
              <li style={`--i:${i}`}>
                <a href={n.href}>
                  <span>{nr(i + 1)}</span>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>

    <main id="inhalt">
      <!-- Hero Variante 1 «Frisches Eis»: helle Eisfläche, die Eismaschine legt das Center-Ice-Branding frei -->
      <section class="hv1" aria-label="Willkommen">
        <div class="wrap hv1-kopf">
          <div class="hv1-text">
            <p class="hv-kicker">Plauscheishockey aus Winterthur</p>
            <p class="hv1-lead">Seit {GRUENDUNGSJAHR} auf dem Eis: Meisterschaft im Conte Hockey Cup, Plauschspiele in der Eishalle Deutweg.</p>
          </div>
        </div>
        <div class="hv1-bahn">
          <div class="hv1-eis">
            <div class="hv1-marke">
              <img src={LOGO_PLATZHALTER} alt="Logo des EHC Wintistars" width="640" height="640" fetchpriority="high" />
              <h1 class="hv1-wort"><span class="sr">EHC </span>Wintistars</h1>
            </div>
          </div>
          <div class="hv1-nass" aria-hidden="true"></div>
          <div class="hv1-frost" aria-hidden="true">
            <div class="hv1-frost-in">
              <div class="hv1-marke hv1-geist">
                <img src={LOGO_PLATZHALTER} alt="" width="640" height="640" />
                <span class="hv1-wort">Wintistars</span>
              </div>
            </div>
          </div>
          <div class="hv1-zb" aria-hidden="true"><Eismaschine logo={LOGO_PLATZHALTER} richtung={1} /></div>
        </div>
        <div class="wrap hv1-fuss">
          {
            ns && nsKurz && (
              <a class="hv-spiel" href="/spielplan/">
                <span class="hv-spiel-k">Nächstes Spiel</span>
                <span class="hv-spiel-d">
                  {nsKurz.wt} {nsKurz.datum} · {ns.zeit}
                </span>
                <span class="hv-spiel-g">
                  {ns.wir === 'gast' ? 'bei' : 'gegen'} {ns.gegner}
                </span>
                <span class="hv-spiel-l">Zum Spielplan <span aria-hidden="true">→</span></span>
              </a>
            )
          }
        </div>
      </section>

      <!-- Hero Variante 2 «Arena von oben»: links Typo auf Navy, rechts Eisfeld-Ausschnitt mit Center-Ice-Logo -->
      <section class="hv2" aria-label="Willkommen">
        <div class="hv2-text">
          <p class="hv-kicker"><span>Plauscheishockey aus Winterthur</span><span>seit {GRUENDUNGSJAHR}</span></p>
          <h1 class="hv2-titel"><span class="hv2-ehc">EHC</span> Wintistars</h1>
          <p class="hv2-lead">Meisterschaft im Conte Hockey Cup in Frauenfeld, Plauschspiele in der Eishalle Deutweg.</p>
          {
            ns && nsKurz && (
              <div class="hv2-spiel">
                <p class="hv-spiel-k">Nächstes Spiel</p>
                <p class="hv2-spiel-g">
                  <span>{ns.wir === 'gast' ? 'bei' : 'gegen'}</span> {ns.gegner}
                </p>
                <p class="hv-spiel-d">
                  {nsKurz.wt} {nsKurz.datum} · {ns.zeit} Uhr{ns.ort && ` · ${ns.ort.split(',')[0]}`}
                </p>
                <p class="cd hv2-cd" data-countdown={ns.iso} hidden>
                  <span class="sr">Noch </span>
                  <span class="cd-u"><b data-cd="t">–</b><span>Tage</span></span>
                  <span class="cd-u"><b data-cd="h">–</b><span>Std</span></span>
                  <span class="cd-u"><b data-cd="m">–</b><span>Min</span></span>
                  <span class="cd-u"><b data-cd="s">–</b><span>Sek</span></span>
                </p>
              </div>
            )
          }
          <p><a class="btn btn-rost" href="/spielplan/">Spielplan <span aria-hidden="true">→</span></a></p>
        </div>
        <div class="hv2-feld" aria-hidden="true">
          <Eisfeld class="hv2-rink" logo={LOGO_PLATZHALTER} clipId="e-rink-scharf" />
          <!-- Zwei gerade Bahnen über die Mitte: oben von links, unten von rechts. Davor mattes, verschwommenes Eis. -->
          <div class="hv2-lauf">
            {
              (['a', 'b'] as const).map((bahn) => (
                <>
                  <div class:list={['hv2-frost', `hv2-frost-${bahn}`]}>
                    <div class="hv2-frost-in">
                      <Eisfeld class="hv2-rink hv2-rink-matt" logo={LOGO_PLATZHALTER} clipId={`e-rink-matt-${bahn}`} />
                    </div>
                  </div>
                  <div class:list={['hv2-nass', `hv2-nass-${bahn}`]} />
                  <div class:list={['hv2-zb', `hv2-zb-${bahn}`]}>
                    <Eismaschine logo={LOGO_PLATZHALTER} richtung={bahn === 'a' ? 1 : -1} />
                  </div>
                </>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 01 Nächstes Spiel -->
      <section class="sek s-creme" id="spiel" aria-labelledby="h-spiel">
        <Titelband nr="01" titel="Nächstes Spiel" id="h-spiel" logo={LOGO_PLATZHALTER} richtung={-1} />
        <div class="wrap sek-in">
          {
            ns ? (
              <div class="match" data-reveal>
                <div class="match-date" aria-hidden="true">
                  <span class="md-wt">{ns.wt}</span>
                  <span class="md-tag">{ns.tag}</span>
                  <span class="md-mo">{ns.monat}</span>
                </div>
                <div class="match-main">
                  <p class="match-when">
                    {ns.wochentag}, {ns.tag}. {ns.monatLang} · {ns.zeit} Uhr
                  </p>
                  <p class="match-teams">
                    <span class:list={['mt', { 'mt-wir': ns.wir === 'heim' }]}>{ns.wir === 'gast' ? ns.gegner : ns.wir === 'heim' ? VEREIN : ns.gegner}</span>
                    <span class="mt-vs">vs</span>
                    <span class:list={['mt', { 'mt-wir': ns.wir === 'gast' }]}>{ns.wir === 'gast' ? VEREIN : ns.wir === 'heim' ? ns.gegner : ''}</span>
                  </p>
                  {ns.ort && <p class="match-ort">{ns.ort}</p>}
                  <ul class="tags">
                    <li>{ns.art}</li>
                    {ns.seite && <li>{ns.seite}</li>}
                    {ns.wettbewerb && <li>{ns.wettbewerb}</li>}
                  </ul>
                  <a class="match-cal" href="/spielplan.ics">Im Kalender speichern</a>
                </div>
                <p class="cd" data-countdown={ns.iso} hidden>
                  <span class="sr">Noch </span>
                  <span class="cd-u"><b data-cd="t">–</b><span>Tage</span></span>
                  <span class="cd-u"><b data-cd="h">–</b><span>Std</span></span>
                  <span class="cd-u"><b data-cd="m">–</b><span>Min</span></span>
                  <span class="cd-u"><b data-cd="s">–</b><span>Sek</span></span>
                </p>
              </div>
            ) : (
              <div class="match match-leer" data-reveal>
                <p class="match-teams">Die Saison ruht.</p>
                <p class="match-ort">Sobald das nächste Spiel angesetzt ist, steht es hier.</p>
              </div>
            )
          }
        </div>
      </section>

      <!-- 02 Spielplan -->
      <section class="sek s-navy" id="spiele" aria-labelledby="h-spiele">
        <Titelband nr="02" titel="Spielplan" id="h-spiele" logo={LOGO_PLATZHALTER} richtung={1} />
        <div class="wrap sek-in">
          <div class="plan">
            <div class="plan-col">
              <h3 class="mini">Weitere Spiele</h3>
              {
                weitere.length > 0 ? (
                  <ol class="games">
                    {weitere.map((s, i) => {
                      const t = datumTeile(s.beginn);
                      return (
                        <li class="game" data-reveal style={`--d:${i * 60}ms`}>
                          <span class="g-date">
                            <b>{t.tag}</b>
                            <span>{t.monat}</span>
                          </span>
                          <span class="g-main">
                            <span class="g-opp">
                              <em>{s.wir === 'gast' ? 'bei' : 'gegen'}</em> {gegner(s)}
                            </span>
                            <span class="g-meta">
                              {t.wochentag} · {formatUhrzeit(s.beginn)} · {ART_LABEL[s.art]}
                              {kurzOrt(s) && <span class="g-ort">{kurzOrt(s)}</span>}
                            </span>
                          </span>
                        </li>
                      );
                    })}
                  </ol>
                ) : (
                  <p class="leer">Weitere Spiele folgen, sobald sie angesetzt sind.</p>
                )
              }
            </div>
            <div class="plan-col">
              <h3 class="mini">Letzte Resultate</h3>
              {
                resultate.length > 0 ? (
                  <ol class="games">
                    {resultate.map((s) => {
                      const a = ausgang(s);
                      return (
                        <li class="game" data-reveal>
                          <span class="g-date g-score">
                            <b>{score(s)}</b>
                          </span>
                          <span class="g-main">
                            <span class="g-opp">{gegner(s)}</span>
                            <span class="g-meta">
                              {datumTeile(s.beginn).tag}. {datumTeile(s.beginn).monat} · {ART_LABEL[s.art]}
                              {a && <> · {AUSGANG[a]}</>}
                            </span>
                          </span>
                        </li>
                      );
                    })}
                  </ol>
                ) : (
                  <div class="res-leer" data-reveal>
                    <ul class="skel" aria-hidden="true">
                      <li><span></span><span></span></li>
                      <li><span></span><span></span></li>
                      <li><span></span><span></span></li>
                    </ul>
                    <p>
                      <b>Noch keine Resultate.</b> In der Saison {SAISON} ist noch kein Spiel gespielt. Nach dem Schlusspfiff stehen sie hier.
                    </p>
                  </div>
                )
              }
              <p class="sek-fuss"><a class="btn btn-rost" href="/spielplan/">Ganzer Spielplan <span aria-hidden="true">→</span></a></p>
            </div>
          </div>
        </div>
      </section>

      <!-- 03 News -->
      <section class="sek s-rost" id="news" aria-labelledby="h-news">
        <Titelband nr="03" titel="News" id="h-news" logo={LOGO_PLATZHALTER} richtung={-1} />
        <div class="wrap sek-in">
          <ol class="news">
            {
              d.news.map((n, i) => {
                const inhalt = (
                  <>
                    {n.bild && (
                      <span class="news-img">
                        <img src={n.bild} alt="" loading="lazy" width="1200" height="750" />
                      </span>
                    )}
                    <span class="news-top">
                      <span class="news-i" aria-hidden="true">
                        {nr(i + 1)}
                      </span>
                      <time datetime={n.datum}>{newsDatum(n.datum)}</time>
                    </span>
                    <h3 class="news-t">{n.titel}</h3>
                    {n.lead && <p class="news-l">{n.lead}</p>}
                    {n.platzhalter ? <span class="news-ph">Platzhalter</span> : <span class="news-go">Weiterlesen →</span>}
                  </>
                );
                return (
                  <li class="news-card" data-reveal style={`--d:${i * 90}ms`}>
                    {n.platzhalter ? (
                      <article class="news-in">{inhalt}</article>
                    ) : (
                      <a class="news-in" href={`/news/${n.slug}/`}>
                        {inhalt}
                      </a>
                    )}
                  </li>
                );
              })
            }
          </ol>
          <p class="sek-fuss"><a class="btn btn-creme" href="/news/">Alle News <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <!-- 04 Mannschaft -->
      <section class="sek s-creme" id="team" aria-labelledby="h-team">
        <Titelband nr="04" titel="Mannschaft" id="h-team" logo={LOGO_PLATZHALTER} richtung={1} />
        <div class="wrap sek-in">
          <figure class="foto" data-reveal>
            {
              d.teamfoto ? (
                <img src={d.teamfoto} alt={d.teamfotoTitel ?? `Teamfoto ${VEREIN}`} loading="lazy" />
              ) : (
                <div class="foto-ph" role="img" aria-label="Platzhalter: Teamfoto folgt">
                  <span class="foto-band" aria-hidden="true" />
                  <span class="foto-t" aria-hidden="true">Teamfoto folgt</span>
                </div>
              )
            }
            {d.teamfoto && d.teamfotoTitel && <figcaption>{d.teamfotoTitel}</figcaption>}
          </figure>
          <h3 class="mini">Kader {SAISON}</h3>
          <div class="kader">
            {
              kader.map((g, gi) => (
                <section class:list={['k-gruppe', `k-${g.p}`]} aria-label={g.titel} data-reveal style={`--d:${gi * 80}ms`}>
                  <p class="k-titel">
                    <b>{g.titel}</b>
                    <span>{g.spieler.length}</span>
                  </p>
                  <ol class="k-liste">
                    {g.spieler.map((s) => {
                      const zeile = (
                        <>
                          <span class="k-nr">{s.nummer}</span>
                          <span class="k-name">
                            {s.vorname} <b>{s.name}</b>
                          </span>
                        </>
                      );
                      return (
                        <li>
                          {s.slug ? (
                            <a class="k-row" href={`/spieler/${s.slug}/`} data-spieler={kaderAlle.indexOf(s)}>
                              {zeile}
                            </a>
                          ) : (
                            <span class="k-row" data-spieler={kaderAlle.indexOf(s)}>
                              {zeile}
                            </span>
                          )}
                        </li>
                      );
                    })}
                  </ol>
                </section>
              ))
            }
          </div>
          <script is:inline type="application/json" data-kader-json set:html={kaderJson}></script>
          <dialog class="sk" data-sk aria-labelledby="sk-name">
            <div class="sk-in">
              <div class="sk-bild" data-sk-bild>
                <img class="sk-foto" data-sk-foto alt="" hidden />
                <div class="sk-ph" data-sk-ph>
                  <span class="sk-ph-nr" data-sk-ph-nr aria-hidden="true"></span>
                  <svg class="sk-sil" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
                    <path d="M100 18c-30 0-50 22-50 52v22c0 7 5 11 11 11h3c5 19 19 31 36 31s31-12 36-31h3c6 0 11-4 11-11V70c0-30-20-52-50-52z"></path>
                    <path class="sk-sil-gitter" d="M66 84h68M70 96h60M84 84v28M100 84v32M116 84v28"></path>
                    <path d="M10 200c4-42 36-64 90-64s86 22 90 64z"></path>
                  </svg>
                  <span class="sk-ph-t">Porträt folgt</span>
                </div>
              </div>
              <div class="sk-text">
                <p class="sk-nr" data-sk-nr></p>
                <h3 class="sk-name" id="sk-name"><span data-sk-vor></span> <b data-sk-nach></b></h3>
                <p class="sk-pos" data-sk-pos></p>
                <a class="sk-link" data-sk-link href="#" hidden>Zum Spielerprofil <span aria-hidden="true">→</span></a>
