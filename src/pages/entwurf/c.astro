                    {fotos.map((f, i) => (
                      <li class:list={['ges-foto', { 'is-aktiv': i === 0 }]} data-ges-foto>
                        <div class="ges-frost" data-ges-frost aria-hidden="true">
                          <img src={f.klein} alt="" loading="lazy" decoding="async" />
                        </div>
                        <figure class="ges-scharf" data-ges-scharf>
                          <img src={f.url} alt={f.titel} width={f.breite} height={f.hoehe} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
