      <!-- 05 Seit 1993: Club, Erfolge und Archivfotos -->
      <section class="sek s-navy sek-ges" id="club" aria-labelledby="h-club">
        <Titelband nr="05" titel="Seit 1993" id="h-club" logo={LOGO_PLATZHALTER} richtung={-1} />
        <div class="wrap sek-in">
