    </main>

    <!-- Footer -->
    <footer class="ft s-nacht">
      <div class="wrap">
        <p class="ft-h" data-reveal>Bis zum nächsten Spiel.</p>
        <div class="ft-grid">
          <nav aria-label="Footer">
            <ul class="ft-nav">
              {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </nav>
          <div class="ft-brand">
            <span class="ft-logo"><img src={LOGO_PLATZHALTER} alt={`Logo ${VEREIN}`} width="640" height="640" loading="lazy" /></span>
            <p>{VEREIN}<br />Plauscheishockey seit {GRUENDUNGSJAHR}<br />Eishalle Deutweg, Winterthur</p>
          </div>
        </div>
        <p class="ft-copy">© {jahrJetzt} {VEREIN}</p>
      </div>
    </footer>
  </div>
</EntwurfLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-e]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.classList.add('is-js'); // meist schon vom Inline-Skript gesetzt
    // Hero-Fahrt erst starten, wenn Schriften und Logo geladen sind (höchstens 1 s warten)
    const logoBilder = [...root.querySelectorAll<HTMLImageElement>('.hv1-marke img, .hv2-feld image, .hv1 img')];
    Promise.race([
      Promise.all([
        document.fonts?.ready ?? Promise.resolve(),
        ...logoBilder.map((b) => (b instanceof HTMLImageElement && !b.complete ? b.decode().catch(() => {}) : Promise.resolve())),
      ]),
      new Promise((ok) => setTimeout(ok, 1000)),
    ]).then(() => root.classList.add('is-bereit'));
    const loaded = () => root.classList.add('is-loaded');
    requestAnimationFrame(() => requestAnimationFrame(loaded));
    setTimeout(loaded, 150);
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // ---------- Dezente Einblendung des Inhalts ----------
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
    );
    root.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // ---------- Titelbänder: eine gerade Fahrt pro Band, an den Scroll gekoppelt ----------
    // Fortschritt 0 → 1, während die Bandmitte von 85 % auf 35 % der Viewport-Höhe wandert.
    // Pro Frame nur transform: Frost-Maske (+ Gegenbewegung des Inhalts), nasse Spur und Maschine.
    interface Band {
      el: HTMLElement;
      dir: 1 | -1;
      frost: HTMLElement;
      frostIn: HTMLElement;
      nass: HTMLElement;
      zb: HTMLElement;
      zbIn: HTMLElement;
      top: number;
      h: number;
      L: number;
      nassW: number;
      p: number;
    }
    const bands: Band[] = [];
    for (const el of root.querySelectorAll<HTMLElement>('[data-band]')) {
      const q = (s: string) => el.querySelector<HTMLElement>(s);
      const frost = q('[data-frost]');
      const frostIn = q('[data-frost-in]');
      const nass = q('[data-nass]');
      const zb = q('[data-zb]');
      const zbIn = q('[data-zb-in]');
      if (!frost || !frostIn || !nass || !zb || !zbIn) continue;
      bands.push({ el, dir: el.dataset.dir === '-1' ? -1 : 1, frost, frostIn, nass, zb, zbIn, top: 0, h: 0, L: 0, nassW: 0, p: -1 });
    }

    let vh = innerHeight;
    let W = root.clientWidth;
    let yS = scrollY;
    let ticking = false;

    function measure() {
      vh = innerHeight;
      W = root.clientWidth;
      const y = scrollY;
      for (const b of bands) {
        const r = b.el.getBoundingClientRect();
        b.top = r.top + y;
        b.h = r.height;
        b.L = b.zb.offsetWidth;
        b.nassW = b.nass.offsetWidth;
        b.p = -1; // neu zeichnen
      }
    }

    function zeichne(b: Band, p: number) {
      const { L, dir } = b;
      // linke Kante der Maschine: kommt von ausserhalb und fährt auf der anderen Seite ganz hinaus
      const x = dir === 1 ? -L + p * (W + L) : W - p * (W + L);
      // Grenze frisch/matt: am Gummi-Abzieher des Conditioners
      const kante = dir === 1 ? x + 0.07 * L : x + 0.93 * L;
      if (dir === 1) {
        b.frost.style.transform = `translate3d(${kante.toFixed(1)}px,0,0)`;
        b.frostIn.style.transform = `translate3d(${(-kante).toFixed(1)}px,0,0)`;
        b.nass.style.transform = `translate3d(${(kante - b.nassW).toFixed(1)}px,0,0)`;
      } else {
        b.frost.style.transform = `translate3d(${(kante - W).toFixed(1)}px,0,0)`;
        b.frostIn.style.transform = `translate3d(${(W - kante).toFixed(1)}px,0,0)`;
        b.nass.style.transform = `translate3d(${kante.toFixed(1)}px,0,0)`;
      }
      b.zb.style.transform = `translate3d(${x.toFixed(1)}px,0,0)`;
      // ganz leichtes Wackeln während der Fahrt (max. 0.4°)
      b.zbIn.style.transform = `rotate(${(0.4 * Math.sin(x / 38)).toFixed(3)}deg)`;
    }

    function frame() {
      ticking = false;
      const ziel = scrollY;
      yS += (ziel - yS) * 0.22;
      if (Math.abs(ziel - yS) < 0.5) yS = ziel;
      else request();
      for (const b of bands) {
        const mitte = b.top + b.h / 2 - yS;
        const p = clamp((0.85 * vh - mitte) / (0.5 * vh));
        if (p === b.p) continue;
        b.p = p;
        zeichne(b, p);
      }
    }
    function request() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    }

    if (motion && bands.length) {
      root.classList.add('has-zb');
      measure();
      yS = scrollY;
      frame();
      addEventListener('scroll', request, { passive: true });
      let rz = 0;
      const neu = () => {
        cancelAnimationFrame(rz);
        rz = requestAnimationFrame(() => {
          measure();
          request();
        });
      };
      addEventListener('resize', neu);
      new ResizeObserver(neu).observe(root);
    }

    // ---------- Archiv-Galerie: Klick, Tastatur, Swipe; beim Wechsel fährt die Eismaschine ----------
    // Zuerst legt sich mattes Eis (verschwommenes neues Foto, statisch) über das aktuelle Bild, dann fährt die Maschine
    // zeitbasiert gerade quer darüber und legt das neue Foto hinter ihrem Abzieher scharf frei (clip-path).
    // Klicks während einer Fahrt beschleunigen sie und kommen in die Warteschlange.
    const ges = root.querySelector<HTMLElement>('[data-ges]');
    if (ges) galerie(ges);

    function galerie(ges: HTMLElement) {
      const buehne = ges.querySelector<HTMLElement>('[data-ges-buehne]');
      const fotos = [...ges.querySelectorAll<HTMLElement>('[data-ges-foto]')].map((li) => ({
        li,
        frost: li.querySelector<HTMLElement>('[data-ges-frost]')!,
        scharf: li.querySelector<HTMLElement>('[data-ges-scharf]')!,
        bild: li.querySelector<HTMLImageElement>('[data-ges-scharf] img')!,
        jahr: li.querySelector('figcaption b')?.textContent ?? '',
        titel: li.querySelector('figcaption span')?.textContent ?? '',
      }));
      const zb = ges.querySelector<HTMLElement>('[data-ges-zb]');
      const nass = ges.querySelector<HTMLElement>('[data-ges-nass]');
      const leg = ges.querySelector<HTMLElement>('[data-ges-leg]');
      const jahr = ges.querySelector<HTMLElement>('[data-ges-jahr]');
      const titel = ges.querySelector<HTMLElement>('[data-ges-titel]');
      const nrEl = ges.querySelector<HTMLElement>('[data-ges-nr]');
      const punkte = [...ges.querySelectorAll<HTMLButtonElement>('[data-ges-punkt]')];
      const lb = ges.querySelector<HTMLDialogElement>('[data-ges-lb]');
      if (!buehne || !zb || !nass || fotos.length < 2) return;
      buehne.tabIndex = 0;
      const n = fotos.length;
      let akt = 0;
      let unterwegs = 0;
      let laeuft = false;
      const schlange: { ziel: number; dir: 1 | -1 }[] = [];
      const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

      function zeigeAnzeige(i: number) {
        punkte.forEach((b, k) => (k === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
        if (nrEl) nrEl.textContent = String(i + 1).padStart(2, '0');
        leg?.classList.add('is-weg');
        setTimeout(() => {
          if (jahr) jahr.textContent = fotos[i].jahr;
          if (titel) titel.textContent = fotos[i].titel;
          leg?.classList.remove('is-weg');
        }, motion ? 200 : 0);
      }

      function wechsle(ziel: number, dir: 1 | -1) {
        if (ziel === akt && !laeuft) return;
        if (laeuft) {
          // laufenden Wechsel nicht abbrechen: den Wunsch anhängen (nur der letzte zählt)
          schlange.length = 0;
          schlange.push({ ziel, dir });
          return;
        }
        blende(ziel);
      }

      // Bildwechsel: ruhiger, kurzer Crossfade ohne Maschine
      function blende(ziel: number) {
        const alt = fotos[akt];
        const neu = fotos[ziel];
        unterwegs = ziel;
        laeuft = true;
        neu.bild.loading = 'eager';
        neu.frost.style.opacity = '0';
        neu.scharf.style.clipPath = 'none';
        neu.li.classList.add('is-neu');
        const a = neu.li.animate([{ opacity: 0 }, { opacity: 1 }], { duration: motion ? 300 : 200, easing: 'ease-out' });
        a.onfinish = () => {
          alt.li.classList.remove('is-aktiv');
          neu.li.classList.add('is-aktiv');
          neu.li.classList.remove('is-neu');
          neu.scharf.style.clipPath = '';
          akt = ziel;
          laeuft = false;
          zeigeAnzeige(akt);
          const naechste = schlange.shift();
          if (naechste && naechste.ziel !== akt) blende(naechste.ziel);
        };
      }

      // Einmalig: Kommt die Galerie ins Bild, legt die Eismaschine das erste Foto frei (ca. 1.4 s)
      if (motion) {
        const erstes = fotos[0];
        erstes.frost.style.opacity = '1';
        erstes.scharf.style.clipPath = 'inset(0 100% 0 0)';
        const beobachter = new IntersectionObserver(
          (eintraege) => {
            if (!eintraege.some((e) => e.isIntersecting)) return;
            beobachter.disconnect();
            aufdecken();
          },
          { threshold: 0.55 },
        );
        beobachter.observe(buehne);
      }
      function aufdecken() {
        const erstes = fotos[0];
        const W = buehne!.clientWidth;
        const L = zb!.offsetWidth;
        const nassW = nass!.offsetWidth;
        zb!.classList.remove('is-links');
        nass!.classList.remove('is-links');
        const dauer = 1400;
        const start = performance.now();
        laeuft = true;
        const schritt = (jetzt: number) => {
          const f = easeInOut(Math.min(1, (jetzt - start) / dauer));
          const x = -L + f * (W + L);
          const kante = x + 0.07 * L;
          erstes.scharf.style.clipPath = `inset(0 ${Math.max(0, W - kante).toFixed(1)}px 0 0)`;
          zb!.style.visibility = 'visible';
          zb!.style.transform = `translate3d(${x.toFixed(1)}px,0,0) rotate(${(0.4 * Math.sin(x / 38)).toFixed(3)}deg)`;
          nass!.style.opacity = f < 1 ? '1' : '0';
          nass!.style.transform = `translate3d(${(kante - nassW).toFixed(1)}px,0,0)`;
          if (f < 1) {
            requestAnimationFrame(schritt);
            return;
          }
          zb!.style.visibility = 'hidden';
          erstes.frost.style.opacity = '0';
          erstes.scharf.style.clipPath = '';
          laeuft = false;
          const naechste = schlange.shift();
          if (naechste && naechste.ziel !== akt) blende(naechste.ziel);
        };
        requestAnimationFrame(schritt);
      }

      const weiter = () => wechsle((schlangeZiel() + 1) % n, 1);
      const zurueck = () => wechsle((schlangeZiel() - 1 + n) % n, -1);
      // Ziel, von dem aus der nächste Klick zählt: das letzte in der Schlange bzw. das gerade angefahrene
      function schlangeZiel() {
        return schlange.length ? schlange[schlange.length - 1].ziel : laeuft ? unterwegs : akt;
      }

      ges.querySelector('[data-ges-weiter]')?.addEventListener('click', weiter);
      ges.querySelector('[data-ges-zurueck]')?.addEventListener('click', zurueck);
      punkte.forEach((b, i) =>
        b.addEventListener('click', () => {
          const von = schlangeZiel();
          if (i !== von) wechsle(i, i > von ? 1 : -1);
        }),
      );
      buehne.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          weiter();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          zurueck();
        } else if (e.key === 'Enter') {
          oeffnen();
        }
      });

      // Swipe auf Touch; ein kurzer Tipp/Klick ohne Bewegung öffnet die Lightbox
      let startX = 0;
      let startY = 0;
      let aktivZeiger = false;
      buehne.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest('.ges-pfeil')) return;
        aktivZeiger = true;
        startX = e.clientX;
        startY = e.clientY;
      });
      buehne.addEventListener('pointerup', (e) => {
        if (!aktivZeiger) return;
        aktivZeiger = false;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) weiter();
          else zurueck();
        } else if (Math.abs(dx) < 8 && Math.abs(dy) < 8) {
          oeffnen();
        }
      });
      buehne.addEventListener('pointercancel', () => (aktivZeiger = false));

      // Lightbox
      const lbBild = lb?.querySelector<HTMLImageElement>('[data-ges-lb-bild]');
      const lbJahr = lb?.querySelector<HTMLElement>('[data-ges-lb-jahr]');
      const lbTitel = lb?.querySelector<HTMLElement>('[data-ges-lb-titel]');
      function oeffnen() {
        if (!lb || !lbBild) return;
        const f = fotos[laeuft ? unterwegs : akt];
        lbBild.src = f.bild.currentSrc || f.bild.src;
        lbBild.alt = f.bild.alt;
        if (lbJahr) lbJahr.textContent = f.jahr;
        if (lbTitel) lbTitel.textContent = f.titel;
        lb.showModal();
      }
      lb?.querySelector('[data-ges-lb-zu]')?.addEventListener('click', () => lb.close());
      lb?.addEventListener('click', (e) => {
        if (e.target === lb) lb.close();
      });
      lb?.addEventListener('close', () => buehne.focus({ preventScroll: true }));
    }

    // ---------- Spielerkarte: Klick/Enter/Space auf einen Kader-Eintrag öffnet sie ----------
    // Blättern in Nummernreihenfolge mit kurzem, ruhigem Wechsel (bei reduzierter Bewegung sofort).
    const skDaten = root.querySelector<HTMLScriptElement>('[data-kader-json]');
    const sk = root.querySelector<HTMLDialogElement>('[data-sk]');
    if (skDaten && sk) spielerkarte(sk, JSON.parse(skDaten.textContent || '[]'));

    function spielerkarte(
      sk: HTMLDialogElement,
      liste: { nr: number; vorname: string; name: string; pos: string; slug: string | null; bild: string | null }[],
    ) {
      const q = <T extends Element>(s: string) => sk.querySelector<T>(s)!;
      const foto = q<HTMLImageElement>('[data-sk-foto]');
      const ph = q<HTMLElement>('[data-sk-ph]');
      const phNr = q<HTMLElement>('[data-sk-ph-nr]');
      const bild = q<HTMLElement>('[data-sk-bild]');
      const text = q<HTMLElement>('.sk-text');
      const link = q<HTMLAnchorElement>('[data-sk-link]');
      const eintraege = [...root.querySelectorAll<HTMLElement>('[data-spieler]')];
      let akt = 0;
      let laeuft = false;

      function fuelle(i: number) {
        const s = liste[i];
        q<HTMLElement>('[data-sk-nr]').textContent = String(s.nr);
        q<HTMLElement>('[data-sk-vor]').textContent = s.vorname;
        q<HTMLElement>('[data-sk-nach]').textContent = s.name;
        q<HTMLElement>('[data-sk-pos]').textContent = s.pos;
        q<HTMLElement>('[data-sk-i]').textContent = String(i + 1);
        phNr.textContent = String(s.nr);
        if (s.bild) {
          foto.src = s.bild;
          foto.alt = `Porträt ${s.vorname} ${s.name}`;
          foto.hidden = false;
          ph.hidden = true;
        } else {
          foto.hidden = true;
          foto.removeAttribute('src');
          ph.hidden = false;
        }
        link.hidden = !s.slug;
        if (s.slug) link.href = `/spieler/${s.slug}/`;
        akt = i;
      }

      // Wechsel ohne Maschine: kurzes Ausblenden, dann leichter Slide in Blätterrichtung (insgesamt unter 250 ms)
      function wechsle(dir: 1 | -1) {
        if (laeuft) return;
        const ziel = (akt + dir + liste.length) % liste.length;
        if (!motion) {
          fuelle(ziel);
          return;
        }
        laeuft = true;
        const teile = [bild, text];
        const raus = teile.map((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 90, easing: 'ease-in', fill: 'forwards' }));
        raus[0].onfinish = () => {
          fuelle(ziel);
          raus.forEach((a) => a.cancel());
          const rein = teile.map((el) =>
            el.animate(
              [
                { opacity: 0, transform: `translateX(${dir * 14}px)` },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 140, easing: 'ease-out' },
            ),
          );
          rein[0].onfinish = () => (laeuft = false);
        };
      }

      function oeffne(i: number) {
        fuelle(i);
        sk.showModal();
      }

      eintraege.forEach((el) => {
        const i = Number(el.dataset.spieler);
        el.setAttribute('role', 'button');
        el.setAttribute('aria-haspopup', 'dialog');
        if (el.tagName !== 'A') el.tabIndex = 0;
        el.addEventListener('click', (e) => {
          e.preventDefault();
          oeffne(i);
        });
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            oeffne(i);
          }
        });
      });
      q('[data-sk-weiter]').addEventListener('click', () => wechsle(1));
      q('[data-sk-zurueck]').addEventListener('click', () => wechsle(-1));
      q('[data-sk-zu]').addEventListener('click', () => sk.close());
      sk.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          wechsle(1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          wechsle(-1);
        }
      });
      sk.addEventListener('click', (e) => {
        if (e.target === sk) sk.close();
      });
      sk.addEventListener('close', () => {
        const ziel = eintraege.find((el) => Number(el.dataset.spieler) === akt);
        ziel?.focus({ preventScroll: false });
      });
    }

    // ---------- Kontaktformular (Entwurf): nativ validieren, nichts senden, Bestätigung zeigen ----------
    const kontakt = root.querySelector<HTMLFormElement>('[data-kontakt]');
    kontakt?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!kontakt.checkValidity()) {
        kontakt.reportValidity();
        return;
      }
      const danke = kontakt.querySelector<HTMLElement>('[data-kt-danke]');
      if (danke) {
        danke.hidden = false;
        danke.tabIndex = -1;
        danke.focus();
      }
      kontakt.reset();
    });

    // ---------- Countdown (Hero und Abschnitt «Nächstes Spiel») ----------
    for (const cd of root.querySelectorAll<HTMLElement>('[data-countdown]')) {
      const ziel = new Date(cd.dataset.countdown ?? '').getTime();
      const [ot, oh, om, os] = ['t', 'h', 'm', 's'].map((k) => cd.querySelector<HTMLElement>(`[data-cd="${k}"]`));
      const p2 = (n: number) => String(n).padStart(2, '0');
      const tick = () => {
        const ms = ziel - Date.now();
        if (ms <= 0) {
          cd.textContent = 'Das Spiel hat begonnen.';
          return false;
        }
        const sec = Math.floor(ms / 1000);
        if (ot) ot.textContent = String(Math.floor(sec / 86400));
        if (oh) oh.textContent = p2(Math.floor(sec / 3600) % 24);
        if (om) om.textContent = p2(Math.floor(sec / 60) % 60);
        if (os) os.textContent = p2(sec % 60);
        return true;
      };
      cd.hidden = false;
      if (tick()) {
        const id = setInterval(() => {
          if (!tick()) clearInterval(id);
        }, 1000);
      }
    }

    // ---------- Heller Header über dem hellen Hero (Variante 1) ----------
    const hv1 = root.querySelector<HTMLElement>('.hv1');
    const kopfHell = () => {
      const hell = root.dataset.hero === '1' && !!hv1 && scrollY < hv1.offsetHeight - 64;
      root.classList.toggle('hd-hell', hell);
    };
    kopfHell();
    addEventListener('scroll', kopfHell, { passive: true });
    addEventListener('resize', kopfHell);

    // ---------- Mobile-Menü ----------
    const menuBtn = root.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const menu = root.querySelector<HTMLElement>('[data-menu]');
    if (menuBtn && menu) {
      const setOpen = (open: boolean) => {
        menuBtn.setAttribute('aria-expanded', String(open));
        root.classList.toggle('menu-open', open);
        document.documentElement.style.overflow = open ? 'hidden' : '';
        if (open) {
          menu.hidden = false;
          requestAnimationFrame(() => menu.classList.add('is-open'));
          menu.querySelector<HTMLElement>('a')?.focus();
        } else {
          menu.classList.remove('is-open');
          setTimeout(
            () => {
              if (!menu.classList.contains('is-open')) menu.hidden = true;
            },
            motion ? 400 : 0,
          );
        }
      };
      menuBtn.addEventListener('click', () => setOpen(menuBtn.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          menuBtn.focus();
        }
      });
    }
  }
</script>

