      width: min(1200px, 100% - 4rem);
    }
  }

  /* ============ Typo ============ */
  .mega,
  .h2,
  .h3,
  .stat-zahl,
  .next-gegner,
  .res-score,
  .fuss-schrift,
  .spieler-nr,
  .cd-zahl,
  .erfolge-gross,
  .teamfoto-titel,
