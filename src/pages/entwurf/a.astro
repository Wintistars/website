    --navy-2: #2a3249;
    --orange: #b9612a;
    --orange-dunkel: #9a4b1b;
    --sand: #d9c29c;
    --creme: #f6f1e7;
    --rot: #d42e27;
    --blau: #2a62b8;

    /* Flächen & Text (hell: Eis am Tag) */
    --bg: #eef2f5;
    --bg-oben: #ffffff;
    --ink: #1c2232;
    --ink-2: #4d5568;
    --flaeche: rgb(255 255 255 / 0.84);
    --flaeche-rand: rgb(255 255 255 / 0.95);
    --karte: #ffffff;
    --solid: #1c2232;
    --solid-2: #2b3450;
    --chip-2: #e1e7ed;
    --hover: #f2f5f8;
    --linie: rgb(28 34 50 / 0.1);
    --akzent-text: #9a4b1b;
    --sieg: #1a7443;
    --niederlage: #c0271f;
    --rink-op: 0.11;
    --rink-bande: #1c2232;
    --glas: rgb(255 255 255 / 0.66);
    --glas-rand: rgb(255 255 255 / 0.85);

    /* Raster, Radien, Schatten */
    --gap: 14px;
    --r-l: 28px;
    --r-m: 20px;
    --r-s: 14px;
    --sh-1: 0 1px 2px rgb(28 34 50 / 0.06), 0 12px 32px -20px rgb(28 34 50 / 0.32);
    --sh-2: 0 1px 2px rgb(28 34 50 / 0.06), 0 26px 48px -22px rgb(28 34 50 / 0.42);
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --font: 'Archivo Variable', system-ui, sans-serif;

    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow-x: clip;
    color: var(--ink);
    font-family: var(--font);
    font-size: 1rem;
    line-height: 1.55;
    background: linear-gradient(180deg, var(--bg-oben) 0%, var(--bg) 36rem);
    -webkit-font-smoothing: antialiased;
  }

  /* Dunkel: Eis bei Nacht */
  @media (prefers-color-scheme: dark) {
    .c {
      --bg: #0c111c;
      --bg-oben: #141b2b;
      --ink: #e8edf4;
      --ink-2: #a3adbf;
      --flaeche: rgb(25 32 49 / 0.82);
      --flaeche-rand: rgb(255 255 255 / 0.07);
      --karte: #18203a;
      --solid: #222b44;
      --solid-2: #2c375a;
      --chip-2: #2a3350;
      --hover: rgb(255 255 255 / 0.04);
      --linie: rgb(255 255 255 / 0.09);
      --akzent-text: #e59a63;
      --sieg: #52c98a;
      --niederlage: #ff7a72;
      --rink-op: 0.2;
      --rink-bande: #8fa3c8;
      --glas: rgb(22 29 46 / 0.62);
      --glas-rand: rgb(255 255 255 / 0.1);
      --sh-1: 0 1px 0 rgb(255 255 255 / 0.04) inset, 0 14px 34px -20px rgb(0 0 0 / 0.8);
      --sh-2: 0 1px 0 rgb(255 255 255 / 0.06) inset, 0 28px 50px -22px rgb(0 0 0 / 0.9);
      color-scheme: dark;
    }
    :global(body) {
      background: #0c111c !important;
    }
  }

  /* ============ Basis ============ */
  :global(:where(.c) :where(h1, h2, h3, p, ul, ol, dl, dd, figure)) {
    margin: 0;
  }
  :global(:where(.c) :where(ul, ol)) {
    padding: 0;
    list-style: none;
  }
  .c a {
    color: inherit;
  }
  .c :focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .c button {
    font: inherit;
    color: inherit;
  }
  .c section {
    scroll-margin-top: 6rem;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: absolute;
    left: 1rem;
