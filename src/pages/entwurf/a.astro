                <label for="k-nachricht">Nachricht <span class="pflicht" aria-hidden="true">*</span></label>
                <textarea id="k-nachricht" name="nachricht" rows="5" required></textarea>
              </div>
              <div class="feld-breit kontakt-fuss">
                <p class="klein"><span aria-hidden="true">*</span> Pflichtfeld</p>
