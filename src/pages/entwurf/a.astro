---
// ENTWURF C – «Eisfläche / Bento modern». Nur Design-Studie, wird vor dem definitiven Design entfernt.
import '@fontsource-variable/archivo/wdth.css';
import EntwurfLayout from '../../layouts/EntwurfLayout.astro';
import Logo from '../../components/entwurf/a/Logo.astro';
import Galerie from '../../components/entwurf/a/Galerie.astro';
import SpielerDialog from '../../components/entwurf/a/SpielerDialog.astro';
import { getEntwurfDaten, POSITION_LABEL } from '../../lib/entwurf';
import { ART_LABEL, ausgang, gegner, type Spiel } from '../../lib/spielplan';
import { formatSpieltag, formatUhrzeit, datumTeile, ZEITZONE } from '../../lib/zeit';
import { GRUENDUNGSJAHR, VEREIN } from '../../lib/verein';
import type { SpielerPosition } from '../../lib/types';

const d = await getEntwurfDaten();
const naechstes = d.naechstes;
const weitere = d.kommend.filter((s) => s.id !== naechstes?.id).slice(0, 5);
const resultate = d.resultate.slice(0, 5);
const letztes = d.resultate[0];

const NAV = [
  { href: '/news/', label: 'News' },
  { href: '/team/', label: 'Team' },
  { href: '/spielplan/', label: 'Spielplan' },
  { href: '/club/', label: 'Club' },
  { href: '/kontakt/', label: 'Kontakt' },
];

// Kader: nach Position, dann Nummer
const POS_REIHENFOLGE: SpielerPosition[] = ['torhueter', 'verteidiger', 'sturm'];
const spieler = [...d.spieler].sort(
  (a, b) => POS_REIHENFOLGE.indexOf(a.position) - POS_REIHENFOLGE.indexOf(b.position) || a.nummer - b.nummer,
);
const FILTER = [
  { wert: 'alle', label: 'Alle', n: spieler.length },
  ...POS_REIHENFOLGE.map((p) => ({ wert: p, label: POSITION_LABEL[p], n: spieler.filter((s) => s.position === p).length })),
].filter((f) => f.n > 0);

// Meistertitel aus den Erfolgen ableiten: «Meister … Liga A» zählt für die höchste Liga.
// Massgebend ist die erste genannte Liga («Meister Liga B und Aufstieg in die Liga A» = Liga B).
const ersteLiga = (titel: string) => /\bliga\s+([a-z])\b/i.exec(titel)?.[1]?.toUpperCase();
const meister = d.erfolge.filter((e) => /\bmeister/i.test(e.titel));
const meisterA = meister.filter((e) => ersteLiga(e.titel) === 'A');
const titelStat =
  meisterA.length > 0
    ? { zahl: meisterA.length, text: 'Meister Liga A', kurz: 'Meister' }
    : meister.length > 0
      ? { zahl: meister.length, text: 'Meistertitel', kurz: 'Meister' }
      : { zahl: d.erfolge.length, text: 'Titel & Erfolge', kurz: 'Erfolge' };

const STATS = [
  { vor: 'seit', zahl: GRUENDUNGSJAHR, nach: '', text: 'in Winterthur auf dem Eis', akzent: false },
  { vor: '', zahl: titelStat.zahl, nach: '×', text: titelStat.text, akzent: true },
  { vor: 'rund', zahl: 30, nach: '', text: 'Spiele pro Saison', akzent: false },
  { vor: 'gut', zahl: 20, nach: '', text: 'Spieler im Stamm', akzent: false },
].filter((s) => s.zahl > 0);

function ort(s: Spiel): string | undefined {
  return s.ort?.split(',')[0]?.trim() || undefined;
}
function ortZeile(s: Spiel): string {
  return [ART_LABEL[s.art], ort(s)].filter(Boolean).join(' · ');
}
function seite(s: Spiel): string | undefined {
  return s.wir === 'heim' ? 'Heim' : s.wir === 'gast' ? 'Auswärts' : undefined;
}
function score(s: Spiel): string {
  if (!s.resultat) return '–';
  const { heim, gast } = s.resultat;
  return s.wir === 'gast' ? `${gast}:${heim}` : `${heim}:${gast}`;
}
/** Schriftgrösse nach Namenslänge, damit auch «EHC Gipfelstürmer Schaffhausen» sauber passt. */
function laenge(name: string): string {
  return name.length > 30 ? 'l3' : name.length > 22 ? 'l2' : name.length > 14 ? 'l1' : 'l0';
}
const AUSGANG_LABEL = { sieg: 'Sieg', niederlage: 'Niederlage', unentschieden: 'Unentschieden' } as const;
const newsDatum = (iso: string) =>
  new Date(`${iso.slice(0, 10)}T12:00:00Z`).toLocaleDateString('de-CH', {
    timeZone: ZEITZONE,
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
const letztesAusgang = letztes ? ausgang(letztes) : undefined;
---

<EntwurfLayout title="Entwurf A – Eisfläche" bg="#eef2f5">
  <div class="c">
    <!-- Eisbahn als dezentes Hintergrundmotiv -->
    <svg class="rink" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect class="rink-bande" x="20" y="20" width="1160" height="760" rx="180" fill="none" stroke-width="3" />
      <line x1="600" y1="20" x2="600" y2="780" class="rink-rot" stroke-width="10" />
      <line x1="420" y1="20" x2="420" y2="780" class="rink-blau" stroke-width="10" />
      <line x1="780" y1="20" x2="780" y2="780" class="rink-blau" stroke-width="10" />
      <line x1="110" y1="40" x2="110" y2="760" class="rink-rot" stroke-width="3" />
      <line x1="1090" y1="40" x2="1090" y2="760" class="rink-rot" stroke-width="3" />
      <circle cx="600" cy="400" r="95" fill="none" class="rink-blau" stroke-width="3" />
      {
        [
          [240, 220],
          [240, 580],
          [960, 220],
          [960, 580],
        ].map(([x, y]) => (
          <g class="rink-rot">
            <circle cx={x} cy={y} r="75" fill="none" stroke-width="3" />
            <circle cx={x} cy={y} r="7" class="rink-punkt" />
          </g>
        ))
      }
      <path d="M110 360 a40 40 0 0 1 0 80 M1090 360 a40 40 0 0 0 0 80" fill="none" class="rink-blau" stroke-width="3" />
    </svg>

    <a class="skip" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf" data-kopf>
      <div class="pill">
        <a class="marke" href="/entwurf/a/" aria-label={`${VEREIN} – Startseite`}>
          <Logo size="40px" alt="" eager />
          <span class="marke-text">Wintistars</span>
        </a>
        <nav class="nav-gross" aria-label="Hauptnavigation">
          <ul>
            {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
          <span class="menu-btn-text" data-menu-label>Menü</span>
          <span class="burger" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>

      <div class="menu" id="menu" data-menu inert>
        <nav aria-label="Hauptnavigation">
          <ol>
            {
              NAV.map((n, i) => (
                <li style={`--i:${i}`}>
                  <a href={n.href}>
                    <span class="menu-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
        <div class="menu-fuss" style="--i:5">
          <a class="btn btn-akzent" href="/spielplan.ics">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm12 8H5v9h14v-9Z"></path></svg>
            Kalender abonnieren
          </a>
          <p>{VEREIN} · Winterthur · seit {GRUENDUNGSJAHR}</p>
        </div>
      </div>
    </header>

    <main id="inhalt">
      <!-- HERO -->
      <section class="hero wrap" aria-labelledby="hero-titel">
        <div class="hero-kopf">
          <div>
            <p class="kicker auf" style="--i:0"><span>Plauscheishockey aus Winterthur</span><span class="k-sep"> · </span><span>seit {GRUENDUNGSJAHR}</span></p>
            <h1 id="hero-titel" class="mega auf" style="--i:1">
              <span>EHC</span> <span>Wintistars<span class="punkt" aria-hidden="true">.</span></span>
            </h1>
          </div>
        </div>

        <div class="bento">
          <div class="tile t-logo auf" style="--i:2" data-parallax>
            <div class="logo-dreh">
              <Logo
                size="var(--logo-s)"
                eager
                alt="Club-Logo EHC Wintistars: roter Löwe, Schriftzug «Wintistars Hockey · Est. 1993»"
              />
            </div>
            <p class="t-logo-fuss"><strong>{VEREIN}</strong><span>Est. {GRUENDUNGSJAHR}</span></p>
          </div>

          <article class="tile t-next auf" style="--i:3" aria-labelledby="next-titel">
            <p class="label"><span class="live-dot" aria-hidden="true"></span>Nächstes Spiel</p>
            {
              naechstes ? (
                <>
                  <h2 id="next-titel" class={`next-gegner ${laenge(gegner(naechstes))}`}>
                    {naechstes.wir && (
                      <span class="vs">{naechstes.wir === 'gast' ? 'Auswärts bei' : 'Zu Hause gegen'}</span>
                    )}
                    <span class="next-name" title={gegner(naechstes)}>{gegner(naechstes)}</span>
                  </h2>
                  <p class="next-meta">
                    <time datetime={naechstes.beginn.toISOString()}>
                      {formatSpieltag(naechstes.beginn)} · {formatUhrzeit(naechstes.beginn)} Uhr
                    </time>
                    <span class="next-ort">{ortZeile(naechstes)}</span>
                  </p>
                  <div class="countdown" data-countdown={naechstes.beginn.toISOString()}>
                    <p class="sr" aria-live="off">Countdown bis zum Spielbeginn</p>
                    {['Tage', 'Std', 'Min', 'Sek'].map((e, i) => (
                      <div class="cd-feld" aria-hidden="true">
                        <span class="cd-zahl" data-teil={i}>
                          --
                        </span>
                        <span class="cd-einheit">{e}</span>
                      </div>
                    ))}
                  </div>
                </>
              ) : (
                <div class="leer leer-dunkel">
                  <svg viewBox="0 0 64 64" width="48" height="48" aria-hidden="true">
                    <ellipse cx="32" cy="40" rx="22" ry="8" fill="currentColor" opacity=".3" />
                    <ellipse cx="32" cy="34" rx="22" ry="8" fill="currentColor" />
                  </svg>
                  <h2 id="next-titel">Gerade kein Spiel angesetzt</h2>
                  <p>Sobald der nächste Match feststeht, erscheint er hier mit Countdown.</p>
                  <a class="btn btn-hell" href="/spielplan.ics">Kalender abonnieren</a>
                </div>
              )
            }
          </article>

          <article class="tile t-res auf" style="--i:4" aria-labelledby="res-titel">
            <p class="label" id="res-titel">Letztes Resultat</p>
            {
              letztes ? (
                <>
                  <p class={`res-score a-${letztesAusgang ?? 'x'}`}>{score(letztes)}</p>
                  <p class="res-gegner">
                    {letztesAusgang && <span class={`badge b-${letztesAusgang}`}>{AUSGANG_LABEL[letztesAusgang]}</span>}
                    <span class="res-name">{letztes.wir ? `vs. ${gegner(letztes)}` : gegner(letztes)}</span>
                  </p>
                  <p class="klein">{formatSpieltag(letztes.beginn)}</p>
                </>
              ) : (
                <div class="res-leer">
                  <svg class="puck" viewBox="0 0 64 40" width="56" height="35" aria-hidden="true">
                    <ellipse cx="32" cy="26" rx="28" ry="10" fill="currentColor" opacity=".25" />
                    <ellipse cx="32" cy="18" rx="28" ry="10" fill="currentColor" />
                  </svg>
                  <p class="res-gegner">Noch kein Resultat</p>
                  <p class="klein">Das erste Ergebnis der Saison steht hier nach dem Match.</p>
                </div>
              )
            }
          </article>

          <a class="tile t-foto auf" style="--i:5" href="#team">
            <span class="foto-streifen" aria-hidden="true"></span>
            <span class="label">Teamfoto</span>
            <span class="foto-text">
              Teamfoto folgt <span class="pfeil" aria-hidden="true">→</span>
            </span>
          </a>

          {
            STATS.map((s, i) => (
              <div class:list={['tile t-stat auf', `t-s${i}`, { 't-stat-akzent': s.akzent }]} style={`--i:${6 + i}`}>
                <p class="stat-zahl">
                  {s.vor && <span class="stat-vor">{s.vor}</span>}
                  <span data-zaehlen={s.zahl}>{s.zahl}</span>
                  {s.nach && <span class="stat-nach">{s.nach}</span>}
                </p>
                <p class="stat-text">{s.text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- SPIELE -->
      <section class="wrap sektion" id="spiele" aria-labelledby="spiele-titel">
        <div class="sek-kopf rv">
          <div>
            <p class="label">Spielplan</p>
            <h2 id="spiele-titel" class="h2">Spiele</h2>
          </div>
          <a class="mehr" href="/spielplan/">Ganzer Spielplan <span aria-hidden="true">→</span></a>
        </div>
        <div class="spiele-grid">
          <div class="panel rv">
            <h3 class="h3">Demnächst</h3>
            {
              weitere.length > 0 ? (
                <ol class="liste">
                  {weitere.map((s) => {
                    const t = datumTeile(s.beginn);
                    return (
                      <li class="zeile">
                        <time class="chip" datetime={s.beginn.toISOString()}>
                          <span class="chip-wt">{t.wochentag}</span>
                          <span class="chip-tag">{t.tag}</span>
                          <span class="chip-mt">{t.monat}</span>
                        </time>
                        <div class="zeile-mitte">
                          <p class="zeile-titel">{gegner(s)}</p>
                          <p class="zeile-sub">{ortZeile(s)}</p>
                        </div>
                        <div class="zeile-rechts">
                          <span class="zeit">{formatUhrzeit(s.beginn)}</span>
                          {seite(s) && <span class="tag-mini">{seite(s)}</span>}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              ) : (
                <div class="leer">
                  <p class="leer-titel">Keine weiteren Spiele angesetzt</p>
                  <p>Neue Termine erscheinen automatisch. Mit dem Kalender-Abo bleibst du immer aktuell.</p>
                  <a class="btn" href="/spielplan.ics">Kalender abonnieren</a>
                </div>
              )
            }
          </div>
          <div class="panel rv" style="--d:100ms">
            <h3 class="h3">Resultate</h3>
            {
              resultate.length > 0 ? (
                <ol class="liste">
                  {resultate.map((s) => {
                    const t = datumTeile(s.beginn);
                    const a = ausgang(s);
                    return (
                      <li class="zeile">
                        <time class="chip chip-grau" datetime={s.beginn.toISOString()}>
                          <span class="chip-wt">{t.wochentag}</span>
                          <span class="chip-tag">{t.tag}</span>
                          <span class="chip-mt">{t.monat}</span>
                        </time>
                        <div class="zeile-mitte">
                          <p class="zeile-titel">{gegner(s)}</p>
                          <p class="zeile-sub">{ortZeile(s)}</p>
                        </div>
                        <div class="zeile-rechts">
                          <span class={`score a-${a ?? 'x'}`}>{score(s)}</span>
                          {a && <span class={`tag-mini a-${a}`}>{AUSGANG_LABEL[a]}</span>}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              ) : (
                <div class="leer">
                  <svg class="puck" viewBox="0 0 64 40" width="48" height="30" aria-hidden="true">
                    <ellipse cx="32" cy="26" rx="28" ry="10" fill="currentColor" opacity=".25" />
                    <ellipse cx="32" cy="18" rx="28" ry="10" fill="currentColor" />
                  </svg>
                  <p class="leer-titel">Noch keine Resultate</p>
                  <p>Die Saison hat eben erst begonnen. Nach dem ersten Match steht hier das Ergebnis.</p>
                </div>
              )
            }
          </div>
        </div>
      </section>

      <!-- NEWS -->
      <section class="wrap sektion" id="news" aria-labelledby="news-titel">
        <div class="sek-kopf rv">
          <div>
            <p class="label">Aktuell</p>
            <h2 id="news-titel" class="h2">News</h2>
          </div>
          <a class="mehr" href="/news/">Alle News <span aria-hidden="true">→</span></a>
        </div>
        <div class="news-grid">
          {
            d.news.map((n, i) => {
              const Tag = n.platzhalter ? 'div' : 'a';
              return (
                <article class="news rv" style={`--d:${i * 100}ms`}>
                  <Tag class:list={['news-link', { 'ohne-bild': !n.bild }]} href={n.platzhalter ? undefined : `/news/${n.slug}/`}>
                    {n.bild && (
                      <div class="news-bild">
                        <img src={n.bild} alt="" loading="lazy" decoding="async" width="1200" height="750" />
                        {n.platzhalter && <span class="badge badge-ecke">Platzhalter</span>}
                      </div>
                    )}
                    <div class="news-body">
                      <p class="news-meta">
                        <time class="klein" datetime={n.datum}>
                          {newsDatum(n.datum)}
                        </time>
                        {n.platzhalter && !n.bild && <span class="news-etikett">Platzhalter</span>}
                      </p>
                      <h3 class="news-titel">{n.titel}</h3>
                      {n.lead && <p class="news-lead">{n.lead}</p>}
                      {!n.platzhalter && (
                        <span class="news-weiter" aria-hidden="true">
                          Weiterlesen →
                        </span>
                      )}
                    </div>
                  </Tag>
                </article>
              );
            })
          }
        </div>
      </section>

      <!-- TEAM & KADER -->
      <section class="wrap sektion" id="team" aria-labelledby="team-titel">
        <div class="sek-kopf rv">
          <div>
            <p class="label">Mannschaft</p>
            <h2 id="team-titel" class="h2">Team</h2>
          </div>
          <a class="mehr" href="/team/">Zur Teamseite <span aria-hidden="true">→</span></a>
        </div>

        {
          d.teamfoto ? (
            <figure class="teamfoto rv">
              <img src={d.teamfoto} alt={d.teamfotoTitel ?? `Teamfoto ${VEREIN}`} loading="lazy" decoding="async" />
            </figure>
          ) : (
            <figure class="teamfoto teamfoto-leer rv">
              <span class="foto-streifen" aria-hidden="true" />
              <svg class="teamfoto-silh" viewBox="0 0 600 160" aria-hidden="true">
                {[60, 150, 240, 330, 420, 510].map((x, i) => (
                  <g transform={`translate(${x} ${i % 2 ? 22 : 8})`} fill="currentColor">
                    <circle cx="30" cy="30" r="22" />
                    <path d="M-10 160 C-10 90 10 62 30 62 C50 62 70 90 70 160 Z" />
                  </g>
                ))}
              </svg>
              <figcaption>
                <span class="teamfoto-titel">Teamfoto folgt</span>
                <span class="klein">Das neue Mannschaftsfoto wird nachgeliefert.</span>
              </figcaption>
            </figure>
          )
        }

        <div class="kader-kopf rv">
          <h3 class="h3">Kader</h3>
          <div class="chips" role="group" aria-label="Kader nach Position filtern">
            {
              FILTER.map((f, i) => (
                <button type="button" class="filter" data-filter={f.wert} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {f.label} <span class="filter-n">{f.n}</span>
                </button>
              ))
            }
          </div>
        </div>
        <p class="sr" aria-live="polite" data-kader-status></p>

        <ul class="kader" data-kader>
          {
            spieler.map((s, i) => {
              const Tag = s.slug ? 'a' : 'div';
              return (
                <li
                  class="spieler rv"
                  data-spieler
                  data-pos={s.position}
                  data-pos-label={POSITION_LABEL[s.position]}
                  data-nummer={s.nummer}
                  data-vorname={s.vorname}
                  data-name={s.name}
                  data-bild={s.bild}
                  data-slug={s.slug}
                  style={`--d:${(i % 6) * 50}ms;--vt:sp-${i}`}
                >
                  <Tag class="spieler-karte" href={s.slug ? `/spieler/${s.slug}/` : undefined}>
                    <div class="spieler-bild">
                      <span class="spieler-nr" aria-hidden="true">
                        {s.nummer}
                      </span>
                      {s.bild ? (
                        <img src={s.bild} alt={`${s.vorname} ${s.name}`} loading="lazy" decoding="async" width="600" height="800" />
                      ) : (
                        <svg class="silh" viewBox="0 0 200 220" aria-hidden="true">
                          <circle cx="100" cy="70" r="38" />
                          <path d="M20 220 C22 150 55 118 100 118 C145 118 178 150 180 220 Z" />
                        </svg>
                      )}
                    </div>
                    <div class="spieler-info">
                      <p class="spieler-name">
                        <span>{s.vorname}</span> <strong>{s.name}</strong>
                      </p>
                      <p class="spieler-pos">
                        <span class="sr">Nummer {s.nummer}, </span>
                        <span aria-hidden="true">#{s.nummer} · </span>
                        {POSITION_LABEL[s.position]}
                      </p>
                    </div>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- ÜBER UNS & ERFOLGE -->
      <section class="wrap sektion" id="club" aria-labelledby="club-titel">
        <div class="club-grid">
          <div class="tile club-text rv">
            <p class="label">Über uns</p>
            <h2 id="club-titel" class="h2">Der Club</h2>
            <p class="lead">{d.ueberUns}</p>
            <dl class="fakten">
              <div><dt>Liga</dt><dd>Conte Hockey Cup, Liga A, Frauenfeld</dd></div>
              <div><dt>Plauschspiele</dt><dd>Eishalle Deutweg, Winterthur</dd></div>
              <div><dt>Saison</dt><dd>Oktober bis April, rund 30 Matches</dd></div>
            </dl>
            <a class="btn" href="/club/">Mehr über den Club</a>
          </div>
          <div class="tile club-erfolge rv" style="--d:100ms">
            <p class="label">Erfolge</p>
            <p class="erfolge-gross">
              <span data-zaehlen={titelStat.zahl}>{titelStat.zahl}</span>× {titelStat.kurz}
            </p>
            <ol class="erfolge">
              {
                d.erfolge.map((e) => {
                  const saison = e.saison && e.saison !== '–' ? e.saison : undefined;
                  return (
                    <li>
                      <span class="saison">
                        {saison ?? (
                          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                            <path fill="currentColor" d="M7 3h10v2h3v3a4 4 0 0 1-4 4h-.3A5 5 0 0 1 13 14.9V18h3v3H8v-3h3v-3.1A5 5 0 0 1 8.3 12H8a4 4 0 0 1-4-4V5h3V3Zm0 4H6v1a2 2 0 0 0 1 1.7V7Zm10 0v2.7A2 2 0 0 0 18 8V7h-1Z" />
