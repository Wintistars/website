      color: #fff;
      visibility: hidden;
      clip-path: circle(0 at calc(100% - 3rem) 2.4rem);
      transition:
        clip-path 0.6s var(--ease),
        visibility 0s linear 0.6s;
    }
    [data-offen] .menu {
      visibility: visible;
      clip-path: circle(150% at calc(100% - 3rem) 2.4rem);
      transition:
        clip-path 0.7s var(--ease),
        visibility 0s;
    }
    .menu li,
    .menu-fuss {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.3s,
        transform 0.3s var(--ease);
    }
    [data-offen] .menu li,
    [data-offen] .menu-fuss {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s var(--ease) calc(0.12s + var(--i) * 0.05s),
        transform 0.6s var(--ease) calc(0.12s + var(--i) * 0.05s);
    }
    .menu a:not(.btn) {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 0.7rem 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
      font-size: clamp(2rem, 10vw, 3rem);
      text-transform: uppercase;
      text-decoration: none;
      transition: color 0.2s, padding 0.3s var(--ease);
    }
    .menu a:not(.btn):hover {
      color: var(--sand);
      padding-left: 0.4rem;
    }
    .menu-nr {
      font-size: 0.8rem;
      font-stretch: 100%;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: var(--sand);
    }
    .menu-fuss {
      display: grid;
      gap: 1rem;
      justify-items: start;
    }
    .menu-fuss p {
      font-size: 0.85rem;
      color: rgb(255 255 255 / 0.65);
    }
  }
  @media (max-width: 340px) {
    .marke-text,
    .menu-btn-text {
      display: none;
    }
  }

  /* ============ Hero ============ */
  .hero {
    padding-top: clamp(1.5rem, 4vw, 2rem);
  }
  .hero-kopf {
    margin-bottom: 1.25rem;
  }
  .hero-kopf .kicker {
    margin-bottom: 0.7rem;
  }
  .hero-kopf .kicker span {
    display: block;
  }
  .hero-kopf .kicker .k-sep {
    display: none;
  }
  .bento {
    --logo-s: min(70cqw, 74cqh);
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'logo logo'
      'next next'
      'res  foto'
      's0   s1'
      's2   s3';
  }
  .t-s0 {
    grid-area: s0;
  }
  .t-s1 {
    grid-area: s1;
  }
  .t-s2 {
    grid-area: s2;
  }
  .t-s3 {
    grid-area: s3;
  }
  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas:
        'logo logo next next'
        'logo logo res  foto'
        's0   s1   s2   s3';
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: 1.4rem;
    }
    .hero-kopf > div {
      display: flex;
      flex-direction: row-reverse;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }
    .hero-kopf .kicker {
      margin: 0 0 0.35rem;
      text-align: right;
      line-height: 1.6;
    }

    .mega {
      font-size: clamp(3rem, 4.9vw, 4.6rem);
      white-space: nowrap;
    }
    .t-stat {
      min-height: 0;
      gap: 0.5rem;
      padding-block: 1rem 1.1rem;
    }
    .cd-feld {
      padding-block: 0.45rem 0.4rem;
    }
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        'logo logo logo logo logo next next next next next next next'
        'logo logo logo logo logo res  res  res  foto foto foto foto'
        's0   s0   s0   s1   s1   s1   s2   s2   s2   s3   s3   s3';
    }
  }

  .tile {
    position: relative;
    border-radius: var(--r-l);
    background: var(--flaeche);
    border: 1px solid var(--flaeche-rand);
    box-shadow: var(--sh-1);
    padding: clamp(1.1rem, 2.2vw, 1.5rem);
    overflow: hidden;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
  }
  .bento .tile:hover,
  a.tile:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--sh-2);
  }
  .tile:focus-visible {
    outline-offset: 4px;
  }

  /* Logo */
  .t-logo {
    grid-area: logo;
    container-type: size;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.92;
    background:
      radial-gradient(circle at 50% 46%, rgb(255 255 255 / 0.95) 0 30%, transparent 62%),
      repeating-linear-gradient(90deg, transparent 0 47px, var(--linie) 47px 48px),
      linear-gradient(160deg, #fff, #dfe7ee);
    --px: 0;
    --py: 0;
  }
  @media (min-width: 700px) {
    .t-logo {
      aspect-ratio: auto;
      min-height: 340px;
    }
  }
  .logo-dreh {
    display: grid;
    place-items: center;
    width: 100%;
    margin-top: -6cqh;
    animation: eindrehen 1.4s 0.2s var(--ease) both;
  }
  .logo-dreh :global(.c-logo) {
    transform: translate(calc(var(--px) * 22px), calc(var(--py) * 22px)) rotateX(calc(var(--py) * -10deg))
      rotateY(calc(var(--px) * 10deg));
    transition: transform 0.4s var(--ease);
    box-shadow:
      0 0 0 4px var(--navy),
      0 30px 60px -22px rgb(28 34 50 / 0.55);
  }
  .t-logo-fuss {
    position: absolute;
    left: clamp(1.1rem, 2.2vw, 1.5rem);
    right: clamp(1.1rem, 2.2vw, 1.5rem);
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: #4d5568;
  }
  .t-logo-fuss strong {
    color: var(--navy);
  }

  /* Nächstes Spiel */
  .t-next {
    grid-area: next;
    background: var(--solid);
    color: #fff;
    border-color: transparent;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .t-next::after {
    content: '';
    position: absolute;
    right: -70px;
    top: -70px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 3px solid rgb(212 46 39 / 0.5);
    pointer-events: none;
  }
  .t-next::before {
    content: '';
    position: absolute;
    right: 40px;
    top: 40px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(212 46 39 / 0.6);
  }
  .t-next .label {
    color: var(--sand);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    animation: puls 2s infinite;
  }
  .t-next {
    container-type: inline-size;
  }
  .next-gegner {
    position: relative;
    z-index: 1;
    font-size: clamp(1.2rem, 8.6cqi, 2.2rem);
    text-transform: uppercase;
    min-width: 0;
  }
  .next-gegner.l1 {
    font-size: clamp(1.1rem, 7cqi, 2rem);
  }
  .next-gegner.l2 {
    font-size: clamp(1rem, 5.6cqi, 1.65rem);
  }
  .next-gegner.l3 {
    font-size: clamp(0.95rem, 4.6cqi, 1.35rem);
  }
  .next-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    padding-bottom: 0.06em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .vs {
    display: block;
    font-stretch: 100%;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--sand);
    margin-bottom: 0.3rem;
  }
  .next-meta {
    display: grid;
    gap: 0.1rem;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.9rem;
    line-height: 1.4;
    min-width: 0;
  }
  .next-meta time {
    font-weight: 700;
    color: #fff;
  }
  .next-ort {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .countdown {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .cd-feld {
    background: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--r-s);
    padding: 0.6rem 0.3rem 0.5rem;
    text-align: center;
    overflow: hidden;
  }
  .cd-zahl {
    display: block;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    font-variant-numeric: tabular-nums;
  }
  .cd-zahl:global(.tick) {
    animation: tick 0.45s var(--ease);
  }
  .cd-einheit {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sand);
  }
  .countdown :global(.cd-vorbei) {
    grid-column: 1 / -1;
    padding: 0.8rem 1rem;
    border-radius: var(--r-s);
    background: rgb(255 255 255 / 0.07);
    font-weight: 600;
  }

  /* Letztes Resultat */
  .t-res {
    grid-area: res;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .res-score {
    margin-top: auto;
    font-size: clamp(2.3rem, 4vw, 3.2rem);
    font-variant-numeric: tabular-nums;
  }
  .res-gegner {
    font-weight: 700;
    line-height: 1.3;
  }
  .res-name {
    overflow-wrap: anywhere;
  }
  .res-leer {
    margin-top: auto;
    display: grid;
    gap: 0.25rem;
  }
  .puck {
    color: var(--ink);
    opacity: 0.85;
    margin-bottom: 0.3rem;
    animation: gleiten 4s ease-in-out infinite;
  }
  .a-sieg {
    color: var(--sieg);
  }
  .a-niederlage {
    color: var(--niederlage);
  }
  .badge {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--solid);
    color: #fff;
    vertical-align: 0.12em;
  }
  .b-sieg {
    background: var(--sieg);
  }
  .b-niederlage {
    background: var(--niederlage);
  }

  /* Teamfoto-Kachel */
  .c .t-foto {
    color: var(--navy);
  }
  .t-foto {
    grid-area: foto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 150px;
    text-decoration: none;
    color: var(--navy);
    background: linear-gradient(135deg, var(--sand), #eadfc9);
    border-color: transparent;
  }
  .t-foto .label {
    position: relative;
    color: var(--navy);
  }
  .foto-streifen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 30%,
      var(--orange) 30% 35%,
      var(--creme) 35% 39%,
      transparent 39% 51%,
      var(--creme) 51% 55%,
      var(--orange) 55% 60%,
      transparent 60%
    );
    opacity: 0.85;
    transition: transform 0.7s var(--ease);
  }
  .t-foto:hover .foto-streifen {
    transform: scaleY(1.12) translateY(-4%);
  }
  .foto-text {
    position: relative;
    font-size: 1.05rem;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .pfeil {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }
  .t-foto:hover .pfeil,
  .t-foto:focus-visible .pfeil {
    transform: translateX(5px);
  }

  /* Zahlen */
  .t-stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    min-height: 128px;
  }
  .stat-zahl {
    display: flex;
    align-items: flex-start;
    font-size: clamp(2.1rem, 3.6vw, 3.1rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stat-vor {
    font-size: 0.32em;
    font-stretch: 100%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0.2em 0.35em 0 0;
    color: var(--akzent-text);
  }
  .stat-nach {
    color: var(--orange);
  }
  .stat-text {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .t-stat-akzent {
    background: var(--orange-dunkel);
    border-color: transparent;
    color: #fff;
  }
  .t-stat-akzent .stat-nach {
    color: var(--sand);
  }
  .t-stat-akzent .stat-text {
    color: rgb(255 255 255 / 0.92);
  }

  @media (max-width: 480px) {
    .bento {
      --gap: 10px;
    }
    .t-stat {
      min-height: 112px;
    }
    .stat-zahl {
      font-size: 1.9rem;
    }
    .stat-vor {
      font-size: 0.38em;
    }
  }

  /* ============ Sektionen ============ */
  .sektion {
    padding-top: clamp(4rem, 8vw, 6.5rem);
  }
  .sek-kopf {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .mehr {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .mehr span {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }
  .mehr:hover {
    background: var(--solid);
    border-color: var(--solid);
    color: #fff;
  }
  .mehr:hover span {
    transform: translateX(4px);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    justify-self: start;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--solid);
    color: #fff !important;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 20px -12px rgb(28 34 50 / 0.6);
    transition:
      transform 0.25s var(--ease),
      background 0.2s;
  }
  .btn:hover {
    transform: translateY(-2px);
    background: var(--orange-dunkel);
  }
  .btn:active {
    transform: translateY(0) scale(0.98);
  }
  .btn-hell {
    background: #fff;
    color: var(--navy) !important;
  }
  .btn-hell:hover {
    background: var(--sand);
  }
  .btn-akzent {
    background: var(--orange-dunkel);
  }
  .btn-akzent:hover {
    background: var(--orange);
  }

  /* ============ Spiele ============ */
  .spiele-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--gap);
  }
  .panel {
    background: var(--flaeche);
    border-radius: var(--r-l);
    padding: clamp(1rem, 2.2vw, 1.5rem);
    box-shadow: var(--sh-1);
    border: 1px solid var(--flaeche-rand);
  }
  .panel .h3 {
    margin: 0 0 0.75rem 0.4rem;
  }
  .liste {
    display: grid;
  }
  .zeile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.65rem 0.5rem;
    border-top: 1px solid var(--linie);
    transition: background 0.2s;
  }
  .zeile:hover {
    background: var(--hover);
  }
  .chip {
    display: grid;
    justify-items: center;
    width: 3.3rem;
    padding: 0.35rem 0 0.4rem;
    border-radius: var(--r-s);
    background: var(--solid);
    color: #fff;
    line-height: 1.05;
    transition: transform 0.3s var(--ease);
  }
  .zeile:hover .chip {
    transform: scale(1.05) rotate(-2deg);
  }
  .chip-grau {
    background: var(--chip-2);
    color: var(--ink);
  }
  .chip-wt,
  .chip-mt {
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }
  .chip-tag {
    font-size: 1.3rem;
    line-height: 1.05;
  }
  .zeile-titel {
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .zeile-sub {
    font-size: 0.8rem;
    color: var(--ink-2);
    line-height: 1.35;
  }
  .zeile-rechts {
    display: grid;
    justify-items: end;
    gap: 0.25rem;
  }
  .zeit,
  .score {
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
  }
  .tag-mini {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .leer {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: 1.4rem;
    border-radius: var(--r-m);
    border: 1.5px dashed var(--linie);
    background:
      radial-gradient(circle at 100% 0, rgb(42 98 184 / 0.1) 0 28%, transparent 29%),
      var(--hover);
    color: var(--ink-2);
  }
  .leer .puck {
    animation: none;
  }
  .leer-titel {
    font-weight: 800;
    color: var(--ink);
  }
  .leer-dunkel {
    flex: 1;
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.05);
    color: rgb(255 255 255 / 0.82);
  }
  .leer-dunkel h2 {
    color: #fff;
    font-stretch: 125%;
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .leer-dunkel svg {
    color: var(--sand);
  }

  /* ============ News ============ */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--gap);
  }
  .news-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--karte);
    border-radius: var(--r-l);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--sh-1);
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
  }
  a.news-link:hover {
    transform: translateY(-6px);
    box-shadow: var(--sh-2);
  }
  .news-bild {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--navy);
  }
  .news-bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  a.news-link:hover .news-bild img {
    transform: scale(1.06);
  }
  .badge-ecke {
    position: absolute;
    left: 1rem;
    top: 1rem;
    background: rgb(255 255 255 / 0.94);
    color: var(--navy);
  }
  .news-body {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    flex: 1;
    padding: 1.2rem 1.35rem 1.5rem;
  }
  .news-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .news-etikett {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--linie);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  /* News ohne Bild: rein typografisch, ruhige Fläche mit feiner Akzentlinie */
  .news-link.ohne-bild {
    position: relative;
  }
  @media (min-width: 700px) {
    .news-link.ohne-bild {
      min-height: 15rem;
    }
  }
  .news-link.ohne-bild::before {
    content: '';
    position: absolute;
    left: 1.35rem;
    top: 0;
    width: 2.5rem;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--orange);
    transition: width 0.45s var(--ease);
  }
  a.news-link.ohne-bild:hover::before {
    width: 4.5rem;
  }
  .ohne-bild .news-body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.7rem 1.5rem 1.6rem;
  }
  .ohne-bild .news-titel {
    font-stretch: 125%;
    font-weight: 850;
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
