</EntwurfLayout>

<script>
  const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.add('js');

  // --- Mobiles Menü ---
  const kopf = document.querySelector<HTMLElement>('[data-kopf]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuLabel = document.querySelector<HTMLElement>('[data-menu-label]');
  const setzeMenu = (offen: boolean, fokusZurueck = true) => {
    if (!kopf || !menuBtn || !menu) return;
    kopf.toggleAttribute('data-offen', offen);
    menuBtn.setAttribute('aria-expanded', String(offen));
    if (menuLabel) menuLabel.textContent = offen ? 'Schliessen' : 'Menü';
    menu.inert = !offen;
    document.documentElement.style.overflow = offen ? 'hidden' : '';
    if (offen) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (fokusZurueck) menuBtn.focus({ preventScroll: true });
  };
  menuBtn?.addEventListener('click', () => setzeMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setzeMenu(false, false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && kopf?.hasAttribute('data-offen')) setzeMenu(false);
  });
  window.matchMedia('(min-width: 821px)').addEventListener('change', (e) => {
    if (e.matches && kopf?.hasAttribute('data-offen')) setzeMenu(false, false);
  });

  // --- Kontaktformular (Entwurf: sendet nichts) ---
  const kontakt = document.querySelector<HTMLFormElement>('[data-kontakt]');
  const danke = document.querySelector<HTMLElement>('[data-kontakt-danke]');
  kontakt?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!kontakt.checkValidity()) return;
    kontakt.reset();
    if (danke) {
      danke.hidden = false;
      danke.classList.remove('neu');
      void danke.offsetWidth;
      danke.classList.add('neu');
    }
  });
  kontakt?.addEventListener('input', () => {
    if (danke) danke.hidden = true;
  });

  // --- Countdown zum nächsten Spiel ---
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const ziel = new Date(cd.dataset.countdown!).getTime();
    const felder = [...cd.querySelectorAll<HTMLElement>('[data-teil]')];
    let timer = 0;
    const tick = () => {
      const rest = ziel - Date.now();
      if (rest <= 0) {
        cd.innerHTML = '<p class="cd-vorbei">Anpfiff ist erfolgt – Resultat folgt im Spielplan.</p>';
        window.clearInterval(timer);
        return;
      }
      const s = Math.floor(rest / 1000);
      const werte = [Math.floor(s / 86400), Math.floor((s % 86400) / 3600), Math.floor((s % 3600) / 60), s % 60];
      werte.forEach((w, i) => {
        const txt = String(w).padStart(2, '0');
        const f = felder[i];
        if (f.textContent !== txt) {
          f.textContent = txt;
          if (!reduziert) {
            f.classList.remove('tick');
            void f.offsetWidth;
            f.classList.add('tick');
          }
        }
      });
    };
    tick();
    timer = window.setInterval(tick, 1000);
  }

  // --- Zahlen hochzählen ---
  const zaehlen = (el: HTMLElement) => {
    if (reduziert || el.dataset.gezaehlt) return;
    el.dataset.gezaehlt = '1';
    const ziel = Number(el.dataset.zaehlen);
    const start = ziel > 1000 ? ziel - 40 : 0;
    const dauer = ziel > 1000 ? 1600 : 1100;
    const t0 = performance.now();
    const schritt = (t: number) => {
      const p = Math.min(1, (t - t0) / dauer);
      const e = 1 - Math.pow(1 - p, 4);
      el.textContent = String(Math.round(start + (ziel - start) * e));
      if (p < 1) requestAnimationFrame(schritt);
    };
    el.textContent = String(start);
    requestAnimationFrame(schritt);
  };

  // --- Scroll-Reveal ---
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          el.querySelectorAll<HTMLElement>('[data-zaehlen]').forEach(zaehlen);
          io.unobserve(el);
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.1 },
    );
    document.querySelectorAll('.rv, .t-stat').forEach((el) => io.observe(el));
  } else {
    document.querySelectorAll('.rv').forEach((el) => el.classList.add('is-in'));
  }

  // --- Parallax auf der Logo-Kachel ---
  if (!reduziert && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((tile) => {
      let raf = 0;
      tile.addEventListener('pointermove', (ev) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = tile.getBoundingClientRect();
          tile.style.setProperty('--px', ((ev.clientX - r.left) / r.width - 0.5).toFixed(3));
          tile.style.setProperty('--py', ((ev.clientY - r.top) / r.height - 0.5).toFixed(3));
        });
      });
      tile.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        tile.style.setProperty('--px', '0');
        tile.style.setProperty('--py', '0');
      });
    });
  }

  // --- Kader-Filter mit animiertem Umordnen (View Transitions, sonst sofort) ---
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const karten = [...document.querySelectorAll<HTMLElement>('[data-kader] [data-pos]')];
  const status = document.querySelector<HTMLElement>('[data-kader-status]');
  const anwenden = (wert: string) => {
    let n = 0;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === wert)));
    karten.forEach((k) => {
      k.hidden = wert !== 'alle' && k.dataset.pos !== wert;
      if (!k.hidden) n++;
      k.classList.add('is-in');
    });
    if (status) status.textContent = `${n} Spieler angezeigt`;
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const wert = b.dataset.filter!;
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (!reduziert && doc.startViewTransition) doc.startViewTransition(() => anwenden(wert));
      else anwenden(wert);
    }),
  );
</script>

<style>
  /* ============ Tokens ============ */
  .c {
