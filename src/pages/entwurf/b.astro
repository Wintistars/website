  /* ================= News ================= */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    padding-top: 12px;
  }
  .karte {
    position: relative;
    transition:
      translate 0.35s var(--ease),
      opacity 0.7s var(--ease);
  }
  .karte-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--papier);
    border: 1px solid rgb(28 34 50 / 0.1);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgb(28 34 50 / 0.05),
      0 14px 30px -20px rgb(28 34 50 / 0.35);
    position: relative;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: box-shadow 0.35s var(--ease);
  }
  a.karte-link:hover {
    box-shadow:
      0 1px 2px rgb(28 34 50 / 0.06),
      0 26px 44px -24px rgb(28 34 50 / 0.45);
  }
  .karte:has(a.karte-link:hover) {
    translate: 0 -3px;
  }
  .karte-bild {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #eef0ee;
  }
  .karte-bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mk-navy {
    color: var(--navy);
  }
  .mk-rot {
    color: var(--rot);
  }
  .mk-orange {
    color: var(--orange);
    stroke-width: 3.5;
  }
  .sk-sp-schatten {
    fill: rgb(28 34 50 / 0.25);
  }
  .sk-sp-k {
    fill: var(--navy);
  }
  .sk-sp-nr {
    fill: #fff;
    font: 800 12px/1 var(--f-titel);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .sk-tor {
    fill: rgb(255 255 255 / 0.9);
    stroke: var(--rot);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .sk-pass .mk,
  .sk-pass .sk-spitze {
    color: var(--orange);
    stroke: var(--orange);
  }
  .sk-schuss .mk,
  .sk-schuss .sk-spitze {
    color: var(--rot);
    stroke: var(--rot);
  }
  .sk-lauf {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2.4;
    stroke-dasharray: 6 6;
    stroke-linecap: round;
  }
  .sk-lauf + .sk-spitze {
    stroke: var(--navy);
  }
  .sk-spitze {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.d-js) .karte .sk-lauf,
    :global(.d-js) .karte .sk-spitze,
    :global(.d-js) .karte .sk-sp {
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    :global(.d-js) .karte.is-in .sk-lauf,
    :global(.d-js) .karte.is-in .sk-spitze,
    :global(.d-js) .karte.is-in .sk-sp {
      opacity: 1;
      transition-delay: calc(var(--d, 0ms) + var(--dd, 0.5s) + 0.35s);
    }
