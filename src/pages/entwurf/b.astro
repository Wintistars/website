---
// ENTWURF D – «Taktiktafel». Nur Design-Studie, wird vor dem definitiven Design entfernt.
// Helles Whiteboard mit Eisfeld-Markierungen, saubere Typo und darüber Marker-Notizen.
// @ts-ignore – Paket ohne Typen
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/instrument-sans';
import '@fontsource/permanent-marker';
import EntwurfLayout from '../../layouts/EntwurfLayout.astro';
import Magnet from '../../components/entwurf/b/Magnet.astro';
import Galerie from '../../components/entwurf/b/Galerie.astro';
import { getEntwurfDaten } from '../../lib/entwurf';
import { ART_LABEL, ausgang, gegner, type Spiel } from '../../lib/spielplan';
import { formatSpieltag, formatUhrzeit, datumTeile, ZEITZONE } from '../../lib/zeit';
import { GRUENDUNGSJAHR, VEREIN } from '../../lib/verein';
import type { SpielerPosition } from '../../lib/types';

const d = await getEntwurfDaten();
const naechstes = d.naechstes;
const weitere = d.kommend.filter((s) => s.id !== naechstes?.id).slice(0, 5);
const resultate = d.resultate.slice(0, 4);

const NAV = [
  { href: '/news/', label: 'News' },
  { href: '/team/', label: 'Team' },
  { href: '/spielplan/', label: 'Spielplan' },
  { href: '/club/', label: 'Club' },
  { href: '/kontakt/', label: 'Kontakt' },
];

// ---------- Spiele ----------
const ort = (s: Spiel) => s.ort?.split(',')[0]?.trim() || undefined;
const metaZeile = (s: Spiel) => [ART_LABEL[s.art], ort(s)].filter(Boolean).join(' · ');
const kurzDatum = (s: Spiel) =>
  s.beginn.toLocaleDateString('de-CH', { timeZone: ZEITZONE, day: '2-digit', month: '2-digit' });
function score(s: Spiel): string {
  if (!s.resultat) return '';
  const { heim, gast } = s.resultat;
  return s.wir === 'gast' ? `${gast}:${heim}` : `${heim}:${gast}`;
}
/** Schriftgrösse nach Namenslänge, damit lange Gegnernamen sauber umbrechen. */
const laenge = (name: string) => (name.length > 28 ? 'l3' : name.length > 20 ? 'l2' : name.length > 13 ? 'l1' : 'l0');
const AUSGANG_LABEL = { sieg: 'Sieg', niederlage: 'Niederlage', unentschieden: 'Unentschieden' } as const;

// ---------- News ----------
const newsDatum = (iso: string) =>
  new Date(`${iso.slice(0, 10)}T12:00:00Z`).toLocaleDateString('de-CH', {
    timeZone: ZEITZONE,
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

// ---------- Kadertafel ----------
// Neutrale Kadertafel ohne Rangfolge: drei Gruppen, innerhalb nach Rückennummer
// (ohne Nummer ans Ende, dann alphabetisch). Eingeblendet wird in Nummernreihenfolge über alle Gruppen.
const POS: SpielerPosition[] = ['torhueter', 'verteidiger', 'sturm'];
const GRUPPEN_TITEL: Record<SpielerPosition, string> = { torhueter: 'Torhüter', verteidiger: 'Verteidigung', sturm: 'Sturm' };
const MAGNET_FARBE: Record<SpielerPosition, string> = { torhueter: 'g', verteidiger: 'v', sturm: 's' };
const POS_EINZEL: Record<SpielerPosition, string> = { torhueter: 'Torhüter', verteidiger: 'Verteidiger', sturm: 'Stürmer' };
type KaderSpieler = (typeof d.spieler)[number];
const nachNummer = (a: KaderSpieler, b: KaderSpieler) =>
  (a.nummer > 0 ? 0 : 1) - (b.nummer > 0 ? 0 : 1) ||
  (a.nummer > 0 && b.nummer > 0 ? a.nummer - b.nummer : 0) ||
  `${a.name} ${a.vorname}`.localeCompare(`${b.name} ${b.vorname}`, 'de-CH');
const kader = [...d.spieler].sort(nachNummer);
const gruppen = POS.map((pos) => ({ pos, spieler: kader.filter((s) => s.position === pos) })).filter(
  (g) => g.spieler.length > 0,
);
/** Reihenfolge fürs gestaffelte Einrasten: nach Nummer über alle Gruppen */
const rang = new Map(kader.map((s, i) => [s, i]));

// ---------- Erfolge ----------
// «Meister … Liga A» zählt für die höchste Liga; massgebend ist die erste genannte Liga.
const ersteLiga = (titel: string) => /\bliga\s+([a-z])\b/i.exec(titel)?.[1]?.toUpperCase();
const meisterA = d.erfolge.filter((e) => /\bmeister/i.test(e.titel) && ersteLiga(e.titel) === 'A');

// ---------- Spielzüge (Hero) ----------
// Das Hero-Feld ist bewusst künstlerisch: randlos, Mittelkreis stark vergrössert, damit das Logo
// als grosser Center-Ice-Magnet Platz hat. Koordinaten 1600×700, Mitte (800, 350), Tor rechts bei x = 1480.
type P = readonly [number, number];
type Art = 'pass' | 'lauf' | 'schuss';
interface Schritt {
  art: Art;
  von: P;
  nach: P;
  /** Kontrollpunkt der Kurve, sonst gerade */
  c?: P;
}
const mitte = (s: Schritt): P => s.c ?? [(s.von[0] + s.nach[0]) / 2, (s.von[1] + s.nach[1]) / 2];
const pfad = (s: Schritt) => {
  const c = mitte(s);
  return `M${s.von[0].toFixed(1)} ${s.von[1].toFixed(1)} Q${c[0]} ${c[1]} ${s.nach[0].toFixed(1)} ${s.nach[1].toFixed(1)}`;
};
/** Pfeilspitze am Ende der Kurve (Richtung = Tangente am Endpunkt) */
function spitze(s: Schritt, laenge = 15, winkel = 0.5): string {
  const c = mitte(s);
  let dx = s.nach[0] - c[0];
  let dy = s.nach[1] - c[1];
  const l = Math.hypot(dx, dy) || 1;
  dx /= l;
  dy /= l;
  const punkt = (a: number) => [
    (s.nach[0] + (-dx * Math.cos(a) + dy * Math.sin(a)) * laenge).toFixed(1),
    (s.nach[1] + (-dx * Math.sin(a) - dy * Math.cos(a)) * laenge).toFixed(1),
  ];
  const [a, b] = [punkt(winkel), punkt(-winkel)];
  return `M${a[0]} ${a[1]} L${s.nach[0].toFixed(1)} ${s.nach[1].toFixed(1)} L${b[0]} ${b[1]}`;
}
const kreuz = ([x, y]: P, r = 11) => `M${x - r} ${y - r} L${x + r} ${y + r} M${x + r} ${y - r} L${x - r} ${y + r}`;

interface HeroSchritt {
  art: Art;
  /** Index des Spielers */
  spieler: number;
  /** Pass: Empfänger */
  nach?: number;
  /** Laufweg oder Schuss: Endpunkt */
  ziel?: P;
  c?: P;
}
interface HeroZug {
  titel: string;
  /** Startpositionen der Spieler-Magnete */
  pos: P[];
  x: P[];
  schritte: HeroSchritt[];
}
// Echtes IIHF-Feld in Metern (60 × 30, Mitte = 0/0), im SVG in Dezimetern (×10).
// Sichtbar ist die rechte Angriffszone (x von −2 bis 30 m): Mittellinie am Rand, blaue Linie, Bullykreise, Tor.
// Alle Züge gehen aufs rechte Tor (Torlinie x = 26 m) und enden mit einem Schuss ins Netz.
const ZUEGE_BREIT: HeroZug[] = [
  {
    titel: 'Aufbau über die blaue Linie',
    pos: [[12.8, -10], [12.8, 9.5], [22.5, 7], [20, -3.5]],
    x: [[16, -5.5], [17.5, 4.5], [23.2, 3.4], [21, -9.5]],
    schritte: [
      { art: 'pass', spieler: 0, nach: 1, c: [15.6, 0] },
      { art: 'pass', spieler: 1, nach: 2, c: [17.5, 11] },
      { art: 'pass', spieler: 2, nach: 3, c: [23, 1.5] },
      { art: 'schuss', spieler: 3, ziel: [25.7, -0.3], c: [23.2, -2.6] },
    ],
  },
  {
    titel: 'Durch die Mitte',
    pos: [[12.8, 3], [14, -10.5], [21, -8], [21.5, 6.5]],
    x: [[16.5, 6], [18.5, -4.5], [23.2, 2.4], [13.8, -5.5]],
    schritte: [
      { art: 'lauf', spieler: 0, ziel: [17, 1.5], c: [15, 3.8] },
      { art: 'pass', spieler: 0, nach: 2, c: [20.2, -3.6] },
      { art: 'pass', spieler: 2, nach: 3, c: [24.3, -0.6] },
      { art: 'schuss', spieler: 3, ziel: [25.7, 0.4], c: [24, 4] },
    ],
  },
  {
    titel: 'Aus der Ecke in den Slot',
    pos: [[13, -9], [23.8, -11.2], [19, 2.2], [14, 9]],
    x: [[20.5, -7.6], [17, -1.8], [23, 4.6], [16.5, 6.5]],
    schritte: [
      { art: 'pass', spieler: 0, nach: 1, c: [18, -12.8] },
      { art: 'lauf', spieler: 1, ziel: [27.4, -5.5], c: [27.2, -10] },
      { art: 'pass', spieler: 1, nach: 2, c: [24.2, -0.8] },
      { art: 'schuss', spieler: 2, ziel: [25.7, 0.2], c: [22.6, 1.6] },
    ],
  },
];
/** Handy: gleiche Komposition wie Desktop (Angriffszone), zwei kurze Züge mit drei Spielern.
    Über dem Tor (x 22–29 m, y −8…−4 m) bleibt Platz für «Tor!». */
const ZUEGE_SCHMAL: HeroZug[] = [
  {
    titel: 'Über die blaue Linie',
    pos: [[12.5, 8], [21.5, 9.2], [20, -2.4]],
    x: [[16.5, 4], [18, -7], [24.3, 8.4]],
    schritte: [
      { art: 'pass', spieler: 0, nach: 1, c: [17, 11.4] },
      { art: 'pass', spieler: 1, nach: 2, c: [24.2, 4.4] },
      { art: 'schuss', spieler: 2, ziel: [25.7, -0.2], c: [23, -2] },
    ],
  },
  {
    titel: 'Querpass vors Tor',
    pos: [[12.5, -2], [16, -9.4], [21, 6.6]],
    x: [[13.2, 4.6], [16.6, 2.2], [24.4, 8]],
    schritte: [
      { art: 'pass', spieler: 0, nach: 1, c: [12.6, -7.6] },
      { art: 'pass', spieler: 1, nach: 2, c: [22, -2] },
      { art: 'schuss', spieler: 2, ziel: [25.7, 0.4], c: [24, 4] },
    ],
  },
];
const HERO_SETS = [
  { name: 'breit', zuege: ZUEGE_BREIT },
  { name: 'schmal', zuege: ZUEGE_SCHMAL },
];
const dm = ([x, y]: P): P => [Math.round(x * 100) / 10, Math.round(y * 100) / 10];
const zu = (a: P, b: P, d: number): P => {
  const dx = b[0] - a[0];
  const dy = b[1] - a[1];
  const l = Math.hypot(dx, dy) || 1;
  return [a[0] + (dx / l) * d, a[1] + (dy / l) * d];
};
interface HeroLinie {
  art: Art;
  spieler: number;
  d: string[];
  spitze: string;
  weg?: string;
}
/** Linien in Dezimetern aus den Spielerpositionen (Start und Ende ausserhalb der Magnete) */
const linienVonZug = (z: HeroZug, f = 1): HeroLinie[] => {
  const pos = z.pos.map(dm);
  return z.schritte.map((s) => {
    const von = pos[s.spieler];
    const ende = s.art === 'pass' ? pos[s.nach!] : dm(s.ziel!);
    const c: P = s.c ? dm(s.c) : [(von[0] + ende[0]) / 2, (von[1] + ende[1]) / 2];
    const start = zu(von, c, 13 * f);
    const stop = s.art === 'pass' ? zu(ende, c, 15 * f) : s.art === 'lauf' ? zu(ende, c, 12 * f) : ende;
    const st: Schritt = { art: s.art, von: start, nach: stop, c };
    let d = [pfad(st)];
    if (s.art === 'schuss') {
      // Doppellinie wie an der Taktiktafel
      const dx = stop[0] - start[0];
      const dy = stop[1] - start[1];
      const l = Math.hypot(dx, dy) || 1;
      const n: P = [(-dy / l) * 1.9, (dx / l) * 1.9];
      const v = (p: P, f: number): P => [p[0] + n[0] * f, p[1] + n[1] * f];
      const vorne = zu(stop, c, 5);
      d = [1, -1].map((f) => pfad({ art: 'schuss', von: v(start, f), nach: v(vorne, f), c: v(c, f) }));
    }
    const weg = s.art === 'lauf' ? pfad({ art: 'lauf', von, nach: ende, c }) : undefined;
    if (s.art === 'lauf') pos[s.spieler] = ende;
    return { art: s.art, spieler: s.spieler, d, spitze: spitze(st, s.art === 'schuss' ? 9.5 : 7.5, 0.5), weg };
  });
};
// Rückennummern aus dem Kader (Platzhalter, solange keine echten Spieler erfasst sind)
const feldNummern = d.spieler
  .filter((s) => s.position !== 'torhueter')
  .map((s) => s.nummer)
  .sort((a, b) => a - b);
const HERO_NR = [feldNummern[0] ?? 4, feldNummern[3] ?? 12, feldNummern[6] ?? 22, feldNummern[8] ?? 27];
/** Pool für die Zufallsauswahl im Hero (pro Spielzug neu gemischt, damit niemand bevorzugt wird) */
const HERO_POOL = feldNummern.length >= 4 ? feldNummern : [4, 12, 22, 27];
// IIHF-Feld in Dezimetern: Bullykreise der Zonen (x ±20 m, y ±7 m), Punkte der neutralen Zone (1.5 m vor der blauen Linie)
const HF_KREISE: P[] = [
  [-200, -70],
  [-200, 70],
  [200, -70],
  [200, 70],
];
const HF_PUNKTE: P[] = [
  [-99, -70],
  [-99, 70],
  [99, -70],
  [99, 70],
];

---

<EntwurfLayout title="Entwurf B – Taktiktafel" bg="#f7f8f6">
  <script is:inline slot="head">
    document.documentElement.classList.add('d-js');
  </script>

  <div class="d">
    <div class="glanz" aria-hidden="true"></div>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>

    <!-- KOPF: oben transparent auf der Tafel, beim Scrollen schmal mit milchigem Hintergrund -->
    <header class="kopf" data-kopf>
      <div class="wrap kopf-innen">
        <a class="marke" href="/entwurf/b/" aria-label={`${VEREIN} – Startseite`}>
          <Magnet size="48px" alt="" eager />
          <span class="marke-text"><span class="mt-ehc">EHC</span> <span class="mt-name">Wintistars</span></span>
        </a>
        <nav class="nav" id="d-nav" aria-label="Hauptnavigation" data-nav>
          <ul>
            {
              NAV.map((n, i) => (
                <li style={`--i:${i}`}>
                  <a href={n.href}>
                    <span class="nav-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="nav-text">
                      {n.label}
                      <svg class="strich" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                        <path pathLength="1" d="M3 8 C 28 3, 60 10, 97 5" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav-fuss">
            <a class="knopf knopf-voll" href={naechstes ? '#spiele' : '/spielplan/'}>
              {naechstes ? `Nächstes Spiel ${kurzDatum(naechstes)}` : 'Zum Spielplan'}
            </a>
          </div>
        </nav>
        <a class="kopf-cta" href={naechstes ? '#spiele' : '/spielplan/'}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M6 13l6 6 6-6"></path></svg>
          {
            naechstes ? (
              <span>
                Nächstes Spiel <strong>{kurzDatum(naechstes)}</strong>
              </span>
            ) : (
              <span>Spielplan</span>
            )
          }
        </a>
        <button class="menu-knopf" type="button" aria-expanded="false" aria-controls="d-nav" aria-label="Menü" data-menu-knopf>
          <span class="menu-text" aria-hidden="true">Menü</span>
          <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </header>
    <div class="kopf-platz" aria-hidden="true"></div>

    <main id="inhalt">
      <!-- HERO: ganzes Eisfeld, Logo im Mittelkreis, Spielzüge im Loop -->
      <section class="hero" aria-labelledby="hero-titel">
        <div class="wrap hero-raster">
        <div class="hero-kopf">
          <div class="hk-titel">
            <h1 id="hero-titel" class="an" style="--i:1">
              <span class="h1-ehc">EHC</span>
              <span class="h1-name">Wintistars</span>
            </h1>
            <p class="hero-seit an" style="--i:2">
              <span>Plauscheishockey&nbsp;· Winterthur</span><span class="hs-trenner" aria-hidden="true">&nbsp;· </span><span class="hs-seit">seit&nbsp;{GRUENDUNGSJAHR}</span>
            </p>
          </div>
          <div class="hk-text">
            <p class="hero-lead an" style="--i:2">
              Meisterschaft im Conte Hockey Cup, Liga&nbsp;A in Frauenfeld, dazu Plauschspiele in der Eishalle Deutweg.
              Von Oktober bis April rund&nbsp;30&nbsp;Matches.
            </p>
            <div class="hero-cta an" style="--i:3">
              <a class="knopf knopf-voll" href="/spielplan/">Zum Spielplan</a>
              <a class="knopf" href="/team/">Zum Team</a>
            </div>
          </div>
        </div>

        <div class="feld" data-feld data-nummern={HERO_POOL.join(',')}>
          <div class="feld-clip">
          <div class="rink-box">
          <svg class="hf-rink" viewBox="-300 -150 600 300" aria-hidden="true" focusable="false">
            <rect class="hf-eis" x="-300" y="-150" width="600" height="300" rx="85" />
            <g fill="none">
              <circle class="z l-blau l-duenn" pathLength="1" style="--o:3" cx="0" cy="0" r="45" />
              <line class="z l-rot l-dick" pathLength="1" style="--o:1" x1="0" y1="-150" x2="0" y2="150" />
              <line class="z l-blau l-dick" pathLength="1" style="--o:2" x1="-114.3" y1="-150" x2="-114.3" y2="150" />
              <line class="z l-blau l-dick" pathLength="1" style="--o:2" x1="114.3" y1="-150" x2="114.3" y2="150" />
              <line class="z l-rot l-duenn" pathLength="1" style="--o:3" x1="-260" y1="-137" x2="-260" y2="137" />
              <line class="z l-rot l-duenn" pathLength="1" style="--o:3" x1="260" y1="-137" x2="260" y2="137" />
              {HF_KREISE.map(([cx, cy], k) => (
                <g>
                  <circle class="z l-rot l-duenn" pathLength="1" style={`--o:${4 + (k % 2)}`} cx={cx} cy={cy} r="45" />
                  <path
                    class="z l-rot l-duenn"
                    pathLength="1"
                    style={`--o:${5 + (k % 2)}`}
                    d={`M${cx - 4} ${cy - 45}v-6M${cx + 4} ${cy - 45}v-6M${cx - 4} ${cy + 45}v6M${cx + 4} ${cy + 45}v6`}
                  />
                </g>
              ))}
              <path class="z l-blau l-duenn l-raum" pathLength="1" style="--o:5" d="M260 -18 A18 18 0 0 0 260 18" />
              <path class="z l-blau l-duenn l-raum" pathLength="1" style="--o:5" d="M-260 -18 A18 18 0 0 1 -260 18" />
              <rect class="z l-bande" pathLength="1" style="--o:0" x="-300" y="-150" width="600" height="300" rx="85" />
            </g>
            <g class="hf-punkte">
              {[...HF_KREISE, ...HF_PUNKTE].map(([cx, cy]) => (
                <circle cx={cx} cy={cy} r="3" />
              ))}
              <circle class="hf-punkt-blau" cx="0" cy="0" r="1.6" />
            </g>
          </svg>
          <svg class="zuege" viewBox="-300 -150 600 300" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="d-sp-navy" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2d3550" />
                <stop offset="1" stop-color="#1c2232" />
              </linearGradient>
              {
                HERO_SETS.flatMap((set) =>
                  set.zuege.flatMap((z, i) =>
                    linienVonZug(z, set.name === 'schmal' ? 1.7 : 1).map((l, k) =>
                      l.art === 'lauf' ? (
                        <mask id={`d-zm-${set.name}-${i}-${k}`} maskUnits="userSpaceOnUse" x="-300" y="-150" width="600" height="300">
                          <path class="z-maske" pathLength="1" d={l.d[0]} />
                        </mask>
                      ) : null,
                    ),
                  ),
                )
              }
            </defs>
            {
              HERO_SETS.map((set) => (
                <g class="zset" data-set={set.name}>
                  {set.zuege.map((z, i) => (
                    <g
                      class:list={['zug', { 'zug-aus': i > 0 }]}
                      data-titel={z.titel}
                      data-pos={z.pos
                        .map(dm)
                        .map((p) => p.join(','))
                        .join(';')}
                    >
                      {z.x.map((pt) => (
                        <path class="zm zm-x" pathLength="1" d={kreuz(dm(pt), 5)} />
                      ))}
                      {linienVonZug(z, set.name === 'schmal' ? 1.7 : 1).map((l, k) => (
                        <g class={`schritt s-${l.art}`} data-art={l.art} data-spieler={l.spieler}>
                          {l.art === 'lauf' ? (
                            <path
                              class="s-linie"
                              d={l.d[0]}
                              mask={`url(#d-zm-${set.name}-${i}-${k})`}
                              data-maske={`d-zm-${set.name}-${i}-${k}`}
                            />
                          ) : (
                            l.d.map((dd) => <path class="s-linie" pathLength="1" d={dd} />)
                          )}
                          <path class="s-spitze" d={l.spitze} />
                          {l.weg && <path class="s-weg" d={l.weg} />}
                        </g>
                      ))}
                    </g>
                  ))}
                  <g class="spieler-ebene">
                    {set.zuege[0].pos.map(dm).map(([x, y], k) => (
                      <g class="sp" transform={`translate(${x} ${y})`}>
                        <g class="sp-hub">
                          <circle class="sp-schatten" cx="0.7" cy="1.8" r="9" />
                          <circle class="sp-koerper" r="9" />
                          <circle class="sp-rand" r="7.8" />
                          <text class="sp-nr" y="0.5">{HERO_NR[k]}</text>
                        </g>
                      </g>
                    ))}
                  </g>
                </g>
              ))
            }
            <g class="tor" data-tor-grafik>
              <g class="netz">
                <path class="netz-flaeche" d="M260 -9.15 H268 Q271 -9.15 271 -6 V6 Q271 9.15 268 9.15 H260 Z" />
                {[263.5, 267].map((x) => (
                  <line class="netz-faden" x1={x} y1="-8.6" x2={x} y2="8.6" />
                ))}
                {[-5.5, -1.8, 1.8, 5.5].map((y) => (
                  <line class="netz-faden" x1="260" y1={y} x2="270.5" y2={y} />
                ))}
              </g>
              <path class="tor-rahmen" d="M260 -9.15 H268 Q271 -9.15 271 -6 V6 Q271 9.15 268 9.15 H260" />
            </g>
          </svg>
          </div>
          </div>
          <div class="feld-logo">
            <Magnet
              size="var(--logo-s)"
              eager
              alt="Club-Logo EHC Wintistars: roter Löwe im runden Badge «Wintistars Hockey · Est. 1993»"
            />
          </div>
          <p class="feld-titel" aria-hidden="true"><span data-zug-titel>{ZUEGE_BREIT[0].titel}</span></p>
          <p class="tor-notiz" aria-hidden="true" data-tor-notiz>Tor!</p>
        </div>
        </div>
      </section>

      <!-- MATCHPLAN & SPIELE -->
      <section class="sektion wrap" id="spiele" aria-labelledby="spiele-titel">
        <div class="sek-kopf">
          <div class="wisch" data-rv>
            <div class="wisch-inhalt">
              <p class="kicker">Spielplan</p>
              <h2 id="spiele-titel" class="h2">Matchplan</h2>
            </div>
          </div>
          <a class="mehr" href="/spielplan/">Ganzer Spielplan <span aria-hidden="true">→</span></a>
        </div>

        <div class="spiele-grid">
          <article class="blatt matchplan rv" data-rv aria-labelledby="next-titel">
            {
              naechstes ? (
                <>
                  <div class="mp-kopf">
                    <p class="label">Nächstes Spiel</p>
                    <span class="chip">{ART_LABEL[naechstes.art]}</span>
                  </div>
                  <div class="mp-inhalt">
                  <h3 id="next-titel" class={`mp-gegner ${laenge(gegner(naechstes))}`}>
                    {naechstes.wir && (
                      <span class="mp-vs">{naechstes.wir === 'gast' ? 'Auswärts bei' : 'Heimspiel gegen'}</span>
                    )}
                    <span class="mp-name">{gegner(naechstes)}</span>
                  </h3>
                  <p class="mp-wann">
                    <time datetime={naechstes.beginn.toISOString()}>{formatSpieltag(naechstes.beginn)}</time>
                    <span class="mp-zeit">{formatUhrzeit(naechstes.beginn)} Uhr</span>
                  </p>
                  {ort(naechstes) && (
                    <p class="mp-ort">
                      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path fill="currentColor" d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7Zm0 4.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z" />
                      </svg>
                      {ort(naechstes)}
                    </p>
                  )}
                  <div class="countdown" data-countdown={naechstes.beginn.toISOString()}>
                    <p class="cd-label">Anpfiff in</p>
                    <div class="cd-felder" aria-hidden="true">
                      {['Tage', 'Std', 'Min', 'Sek'].map((e, i) => (
                        <div class="cd-feld">
                          <span class="cd-zahl" data-teil={i}>--</span>
                          <span class="cd-einheit">{e}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="mp-fuss">
                    <a href="/spielplan.ics">Im Kalender speichern</a>
                    {naechstes.link && (
                      <a href={naechstes.link} rel="noopener" target="_blank">
                        Matchblatt SIHF<span class="sr"> (öffnet in neuem Fenster)</span>
                      </a>
                    )}
                  </div>
                  </div>
                </>
              ) : (
                <div class="mp-leer">
                  <div class="mp-kopf">
                    <p class="label">Nächstes Spiel</p>
                  </div>
                  <h3 id="next-titel" class="mp-gegner l1">Noch kein Spiel angesetzt</h3>
                  <p>Sobald der nächste Match feststeht, steht er hier – mit Countdown bis zum Anpfiff.</p>
                  <a class="mp-leer-link" href="/spielplan.ics">Im Kalender speichern</a>
                </div>
              )
            }
          </article>

          <div class="spielliste rv" data-rv style="--d:120ms">
            <h3 class="h3">Weitere Spiele</h3>
            {
              weitere.length > 0 ? (
                <ol class="tabelle">
                  <li class="t-kopf" aria-hidden="true">
                    <span>Datum</span>
                    <span>Gegner</span>
                    <span>Zeit</span>
                    <span class="t-ha">H/A</span>
                  </li>
                  {weitere.map((s) => {
                    const t = datumTeile(s.beginn);
                    return (
                      <li class="t-zeile">
                        <time class="t-datum" datetime={s.beginn.toISOString()}>
                          <span class="t-wt">{t.wochentag}</span>
                          <span class="t-tag">{kurzDatum(s)}</span>
                        </time>
                        <span class="t-mitte">
                          <span class="t-gegner">{gegner(s)}</span>
                          <span class="t-meta">{metaZeile(s)}</span>
                        </span>
                        <span class="t-zeit">{formatUhrzeit(s.beginn)}</span>
                        <span class="t-ha">
                          {s.wir && (
                            <span class={`ha ha-${s.wir}`} title={s.wir === 'heim' ? 'Heimspiel' : 'Auswärtsspiel'}>
                              <span aria-hidden="true">{s.wir === 'heim' ? 'H' : 'A'}</span>
                              <span class="sr">{s.wir === 'heim' ? 'Heimspiel' : 'Auswärtsspiel'}</span>
                            </span>
                          )}
                        </span>
                      </li>
                    );
                  })}
                </ol>
              ) : (
                <p class="leer-zeile">Keine weiteren Spiele angesetzt. Neue Termine erscheinen automatisch.</p>
              )
            }

            <h3 class="h3 h3-res">Letzte Resultate</h3>
            {
              resultate.length > 0 ? (
                <ol class="tabelle tabelle-res zeichne" data-rv>
                  {resultate.map((s) => {
                    const a = ausgang(s);
                    const t = datumTeile(s.beginn);
                    return (
                      <li class="t-zeile">
                        <time class="t-datum" datetime={s.beginn.toISOString()}>
                          <span class="t-wt">{t.wochentag}</span>
                          <span class="t-tag">{kurzDatum(s)}</span>
                        </time>
                        <span class="t-mitte">
                          <span class="t-gegner">{gegner(s)}</span>
                          <span class="t-meta">{metaZeile(s)}</span>
                        </span>
                        <span class={`t-score a-${a ?? 'x'}`}>{score(s)}</span>
                        <span class="t-ha">
                          {a && (
                            <svg class={`haken a-${a}`} viewBox="0 0 32 32" aria-hidden="true">
                              {a === 'sieg' ? (
                                <path class="mk" pathLength="1" d="M5 17 L12 25 L28 6" />
                              ) : a === 'niederlage' ? (
                                <path class="mk" pathLength="1" d="M7 7 L25 25 M25 7 L7 25" />
                              ) : (
                                <path class="mk" pathLength="1" d="M5 16 C 10 10, 14 22, 19 16 S 26 12, 28 15" />
                              )}
                            </svg>
                          )}
                          {a && <span class="sr">{AUSGANG_LABEL[a]}</span>}
                        </span>
                      </li>
                    );
                  })}
                </ol>
              ) : (
                <div class="res-leer zeichne" data-rv>
                  <svg class="res-leer-icon" viewBox="0 0 48 48" aria-hidden="true">
                    <rect class="mk" pathLength="1" x="7" y="9" width="32" height="30" rx="3" />
                    <path class="mk mk-zart" pathLength="1" d="M14 21h18M14 29h11" />
                  </svg>
                  <div>
                    <p class="res-leer-titel">Noch keine Resultate</p>
                    <p>Die Saison hat eben erst begonnen. Nach dem ersten Match steht hier das Ergebnis.</p>
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </section>

      <!-- NEWS -->
      <section class="sektion wrap" id="news" aria-labelledby="news-titel">
        <div class="sek-kopf">
          <div class="wisch" data-rv>
            <div class="wisch-inhalt">
              <p class="kicker">Aktuell</p>
              <h2 id="news-titel" class="h2">News</h2>
            </div>
          </div>
          <a class="mehr" href="/news/">Alle News <span aria-hidden="true">→</span></a>
        </div>
        <div class="news-grid">
          {
            d.news.map((n, i) => {
              const Tag = n.platzhalter ? 'div' : 'a';
              return (
                <article class="karte rv" data-rv style={`--d:${i * 110}ms`}>
                  <Tag class:list={['karte-link', { 'ohne-bild': !n.bild }]} href={n.platzhalter ? undefined : `/news/${n.slug}/`}>
                    {n.bild && (
                      <div class="karte-bild">
                        <img src={n.bild} alt="" loading="lazy" decoding="async" width="1200" height="750" />
                        {n.platzhalter && <span class="etikett">Platzhalter</span>}
                      </div>
                    )}
                    <div class="karte-text">
                      <div class="karte-meta">
                        <time datetime={n.datum}>{newsDatum(n.datum)}</time>
                        {n.platzhalter && !n.bild && <span class="etikett etikett-text">Platzhalter</span>}
                      </div>
                      <h3>{n.titel}</h3>
                      {n.lead && <p>{n.lead}</p>}
                      {!n.platzhalter && (
                        <span class="weiter" aria-hidden="true">
                          Weiterlesen →
                        </span>
                      )}
                    </div>
                  </Tag>
                </article>
              );
            })
          }
        </div>
      </section>

      <!-- TEAM: Aufstellung auf der Tafel -->
      <section class="team-band" id="team" aria-labelledby="team-titel">
        <svg class="tb-motiv" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <line x1="760" y1="0" x2="760" y2="600" class="tb-rot" />
          <line x1="440" y1="0" x2="440" y2="600" class="tb-blau" />
          <line x1="1080" y1="0" x2="1080" y2="600" class="tb-blau" />
          <circle cx="760" cy="300" r="150" />
          <circle cx="760" cy="300" r="5" class="tb-punkt" />
          <circle cx="250" cy="140" r="150" />
          <circle cx="250" cy="460" r="150" />
        </svg>
        <div class="wrap tb-innen">
        <div class="sek-kopf">
          <div class="wisch" data-rv>
            <div class="wisch-inhalt">
              <p class="kicker">Kader</p>
              <h2 id="team-titel" class="h2">Das Team</h2>
            </div>
          </div>
          <a class="mehr" href="/team/">Zum ganzen Team <span aria-hidden="true">→</span></a>
        </div>

        <div class="tb-raster">
          <figure class:list={['tb-foto', 'rv', { 'tb-foto-leer': !d.teamfoto }]} data-rv>
            {
              d.teamfoto ? (
                <img src={d.teamfoto} alt={d.teamfotoTitel ?? `Teamfoto ${VEREIN}`} loading="lazy" decoding="async" />
              ) : (
                <div class="tb-platz">
                  <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true">
                    <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="M6 15h8l3-5h14l3 5h8v23H6Z" />
                    <circle cx="24" cy="26" r="7" fill="none" stroke="currentColor" stroke-width="2.5" />
                  </svg>
                  <span class="tb-platz-titel">Teamfoto folgt</span>
                  <span class="tb-platz-sub">Das Mannschaftsfoto der Saison wird nachgeliefert.</span>
                </div>
              )
            }
            {d.teamfoto && <figcaption>{d.teamfotoTitel ?? VEREIN}</figcaption>}
          </figure>

          {
            kader.length === 0 ? (
              <div class="kt-leer">
                <p class="res-leer-titel">Kader folgt</p>
                <p>Sobald die Spieler erfasst sind, stehen sie hier.</p>
              </div>
            ) : (
              <div class="kadertafel" data-rv>
                {gruppen.map((g) => (
                  <section class="kt-gruppe" aria-labelledby={`kt-${g.pos}`}>
                    <h3 class="kt-titel" id={`kt-${g.pos}`}>
                      {GRUPPEN_TITEL[g.pos]} <span class="kt-anzahl">{g.spieler.length}</span>
                    </h3>
                    <ul class="kt-liste">
                      {g.spieler.map((s) => {
                        // Ohne JS: Link aufs Profil (falls vorhanden); mit JS öffnet ein Klick die Spielerkarte
                        const Tag = s.slug ? 'a' : 'button';
                        return (
                          <li style={`--i:${rang.get(s)}`}>
                            <Tag
                              class="kt-spieler"
                              href={s.slug ? `/spieler/${s.slug}/` : undefined}
                              type={s.slug ? undefined : 'button'}
                              aria-haspopup="dialog"
                              data-kt
                              data-rang={rang.get(s)}
                              data-nr={s.nummer > 0 ? s.nummer : ''}
                              data-vorname={s.vorname}
                              data-nachname={s.name}
                              data-pos={POS_EINZEL[s.position]}
                              data-rolle={MAGNET_FARBE[s.position]}
                              data-bild={s.bild}
                              data-slug={s.slug}
                            >
                              <span class:list={['kt-magnet', `kt-${MAGNET_FARBE[s.position]}`, { 'kt-bild': !!s.bild }]} aria-hidden="true">
                                {s.bild && <img src={s.bild} alt="" loading="lazy" decoding="async" width="600" height="800" />}
                                <span class="kt-nr">{s.nummer > 0 ? s.nummer : '–'}</span>
                              </span>
                              <span class="kt-name">
                                <span class="sr">{s.nummer > 0 ? `Nummer ${s.nummer}, ` : ''}</span>
                                <span class="kt-vorname">{s.vorname}</span> <span class="kt-nachname">{s.name}</span>
                              </span>
                            </Tag>
                          </li>
                        );
                      })}
                    </ul>
                  </section>
                ))}
              </div>
            )
          }
        </div>
        </div>
        {
          kader.length > 0 && (
            <dialog class="kt-dialog" data-kt-dialog aria-labelledby="ktd-name">
              <div class="ktd-karte">
                <button class="ktd-zu" type="button" data-ktd-zu aria-label="Spielerkarte schliessen">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
                <div class="ktd-portrait">
                  <img data-ktd-img alt="" width="600" height="800" hidden />
                  <div class="ktd-platz" data-ktd-platz>
                    <span class="ktd-platz-nr" data-ktd-platz-nr aria-hidden="true"></span>
                    <svg class="ktd-silhouette" viewBox="0 0 200 240" aria-hidden="true">
                      <path d="M100 30c-30 0-52 22-52 52v14c0 6 4 10 10 10h4c3 18 18 32 38 32s35-14 38-32h4c6 0 10-4 10-10V82c0-30-22-52-52-52Zm-30 62h60v8H70Z" />
                      <path d="M20 240c4-46 34-78 80-82 46 4 76 36 80 82Z" />
                    </svg>
                    <span class="ktd-platz-text">Porträt folgt</span>
                  </div>
                </div>
                <div class="ktd-text">
                  <p class="ktd-pos" data-ktd-pos></p>
                  <p class="ktd-nr" data-ktd-nr aria-hidden="true"></p>
                  <h3 class="ktd-name" id="ktd-name">
                    <span class="ktd-vorname" data-ktd-vorname></span>
                    <span class="ktd-nachname" data-ktd-nachname></span>
                  </h3>
                  <p class="sr" data-ktd-nr-sr></p>
                  <a class="ktd-link" data-ktd-link href="/team/" hidden>Zum Spielerprofil <span aria-hidden="true">→</span></a>
                  <div class="ktd-nav">
                    <button type="button" class="ktd-pfeil" data-ktd-zurueck aria-label="Vorheriger Spieler">
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
                    </button>
                    <span class="ktd-zaehler" data-ktd-zaehler aria-live="polite"></span>
                    <button type="button" class="ktd-pfeil" data-ktd-weiter aria-label="Nächster Spieler">
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </button>
                  </div>
                </div>
              </div>
            </dialog>
          )
        }
      </section>

      <!-- ÜBER UNS & ERFOLGE -->
      <section class="sektion wrap" id="club" aria-labelledby="club-titel">
        <div class="sek-kopf">
          <div class="wisch" data-rv>
            <div class="wisch-inhalt">
              <p class="kicker">Club</p>
              <h2 id="club-titel" class="h2">Über uns</h2>
            </div>
          </div>
          <a class="mehr" href="/club/">Mehr über den Club <span aria-hidden="true">→</span></a>
        </div>
        <div class="club-grid">
          <div class="ueber rv" data-rv>
            <p class="ueber-lead">{d.ueberUns}</p>
            <dl class="fakten">
              <div><dt>Gegründet</dt><dd>{GRUENDUNGSJAHR} in Winterthur</dd></div>
              <div><dt>Meisterschaft</dt><dd>Conte Hockey Cup, Liga&nbsp;A, Frauenfeld</dd></div>
              <div><dt>Plauschspiele</dt><dd>Eishalle Deutweg, Winterthur</dd></div>
              <div><dt>Saison</dt><dd>Oktober bis April, rund 30 Matches</dd></div>
            </dl>
            <div class="ueber-cta">
              <a class="knopf knopf-voll" href="/club/">Zum Club</a>
              <a class="knopf" href="#kontakt">Kontakt</a>
            </div>
          </div>

          <div class="erfolge blatt rv" data-rv style="--d:120ms" aria-labelledby="erfolge-titel">
            <h3 id="erfolge-titel" class="h3">Erfolge</h3>
            {
              meisterA.length > 0 && (
                <p class="meister">
                  <span class="meister-zahl">{meisterA.length}×</span>
                  <span class="meister-text">Meister Liga&nbsp;A</span>
                </p>
              )
            }
            <ol class="erfolg-liste">
              {
                d.erfolge.map((e) => {
                  const saison = e.saison && e.saison !== '–' ? e.saison : undefined;
                  const istMeister = /\bmeister/i.test(e.titel);
                  return (
                    <li class:list={{ 'ist-meister': istMeister }}>
                      <span class="erfolg-saison">{saison ?? '—'}</span>
                      <span class="erfolg-titel">
                        {e.titel}
                        {istMeister && (
                          <span class="erfolg-badge">
                            <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
                              <path fill="currentColor" d="M7 3h10v2h3v3a4 4 0 0 1-4 4h-.3A5 5 0 0 1 13 14.9V18h3v3H8v-3h3v-3.1A5 5 0 0 1 8.3 12H8a4 4 0 0 1-4-4V5h3V3Zm0 4H6v1a2 2 0 0 0 1 1.7V7Zm10 0v2.7A2 2 0 0 0 18 8V7h-1Z" />
                            </svg>
                            Titel
                          </span>
                        )}
                      </span>
                    </li>
                  );
                })
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- GALERIE (kompakt, Archivbilder) -->
      {
        d.archiv.length > 0 && (
          <section class="sektion wrap" id="galerie" aria-labelledby="galerie-titel">
            <div class="sek-kopf">
              <div class="wisch" data-rv>
                <div class="wisch-inhalt">
                  <p class="kicker">Archiv</p>
                  <h2 id="galerie-titel" class="h2">Galerie</h2>
                  <p class="galerie-hinweis">Archivbilder – neue Fotos folgen.</p>
                </div>
              </div>
              <a class="mehr" href="/galerie/">Zur Galerie <span aria-hidden="true">→</span></a>
            </div>
            <Galerie fotos={d.archiv} max={4} />
          </section>
        )
      }

      <!-- KONTAKT -->
      <section class="sektion wrap" id="kontakt" aria-labelledby="kontakt-titel">
        <div class="sek-kopf">
          <div class="wisch" data-rv>
            <div class="wisch-inhalt">
              <p class="kicker">Mitspielen?</p>
              <h2 id="kontakt-titel" class="h2">Kontakt</h2>
            </div>
          </div>
        </div>
        <div class="kontakt-grid">
          <div class="kontakt-karte blatt">
            <p class="kontakt-lead">Interesse, bei uns mitzuspielen? Oder eine Frage zum Club? Schreib uns.</p>
            <form class="kontakt-form" data-kontakt-form action="#" method="post" novalidate>
              <div class="kf-zeile">
                <div class="kf-feld">
                  <label for="kf-name">Name <span class="kf-pflicht" aria-hidden="true">*</span></label>
                  <input id="kf-name" name="name" type="text" autocomplete="name" required />
                  <p class="kf-fehler" id="kf-name-fehler" hidden>Bitte gib deinen Namen an.</p>
                </div>
                <div class="kf-feld">
                  <label for="kf-mail">E-Mail <span class="kf-pflicht" aria-hidden="true">*</span></label>
                  <input id="kf-mail" name="email" type="email" autocomplete="email" inputmode="email" required />
                  <p class="kf-fehler" id="kf-mail-fehler" hidden>Bitte gib eine gültige E-Mail-Adresse an.</p>
                </div>
              </div>
              <div class="kf-feld">
                <label for="kf-betreff">Betreff</label>
                <input id="kf-betreff" name="betreff" type="text" autocomplete="off" />
              </div>
              <div class="kf-feld">
                <label for="kf-nachricht">Nachricht <span class="kf-pflicht" aria-hidden="true">*</span></label>
                <textarea id="kf-nachricht" name="nachricht" rows="5" required></textarea>
                <p class="kf-fehler" id="kf-nachricht-fehler" hidden>Bitte schreib uns eine Nachricht.</p>
              </div>
              <div class="kf-fuss">
                <p class="kf-hinweis"><span aria-hidden="true">*</span> Pflichtfeld</p>
                <button class="knopf knopf-voll" type="submit">Senden</button>
              </div>
              <p class="kf-danke" data-kontakt-danke role="status" hidden>
                Danke! (Entwurf: Das Formular wird nach der Design-Wahl angebunden.)
              </p>
            </form>
          </div>
          <aside class="kontakt-info" aria-label="Gut zu wissen">
            <dl>
              <div>
                <dt>Meisterschaft</dt>
                <dd>Kunsteisbahn Frauenfeld, Conte Hockey Cup</dd>
