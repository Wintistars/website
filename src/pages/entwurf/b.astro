        <nav class="fuss-nav" aria-label="Fussnavigation">
          <div>
            <p class="fuss-h">Saison</p>
            <ul>
              <li><a href="/news/">News</a></li>
              <li><a href="/spielplan/">Spielplan</a></li>
              <li><a href="/team/">Team</a></li>
