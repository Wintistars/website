  .tb-platz-titel {
    margin-top: 0.3rem;
    font: 800 1.45rem/1.1 var(--f-titel);
    text-transform: uppercase;
    color: var(--creme);
  }
  .tb-platz-sub {
    font-size: 0.86rem;
  }
  .kt-leer {
    color: rgb(246 241 231 / 0.8);
  }
  .kt-leer .res-leer-titel {
    color: var(--creme);
  }
  .kadertafel {
    display: grid;
    gap: 1.6rem;
  }
  .kt-gruppe + .kt-gruppe {
    padding-top: 0.2rem;
  }
  .kt-titel {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid rgb(217 194 156 / 0.25);
    font: 650 0.72rem/1.2 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .kt-anzahl {
    font-weight: 500;
    letter-spacing: 0;
  }
  .kt-liste {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
    gap: 1rem 0.6rem;
  }
  .kt-spieler {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.1rem;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }
  .kt-magnet {
    --mf: var(--creme);
    position: relative;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    color: var(--navy);
    background: linear-gradient(180deg, #fffdf8 0%, var(--mf) 100%);
    box-shadow:
      inset 0 0 0 2px rgb(217 194 156 / 0.55),
      0 2px 3px rgb(0 0 0 / 0.35),
      0 10px 16px -8px rgb(0 0 0 / 0.6);
    transition:
      translate 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .kt-g {
    --mf: var(--orange);
    color: #fff;
    background: linear-gradient(180deg, #cd7440 0%, var(--orange) 100%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.18),
      0 2px 3px rgb(0 0 0 / 0.35),
      0 10px 16px -8px rgb(0 0 0 / 0.6);
  }
  .kt-nr {
    position: relative;
    font: 800 1.3rem/1 var(--f-titel);
    font-variant-numeric: tabular-nums;
  }
  .kt-magnet img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .kt-bild .kt-nr {
    position: absolute;
    right: -4px;
    bottom: -4px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--mf);
    font-size: 0.75rem;
  }
  .kt-name {
    display: flex;
    flex-direction: column;
    font-size: 0.78rem;
    line-height: 1.2;
    color: rgb(246 241 231 / 0.7);
  }
  .kt-nachname {
    font-weight: 650;
    color: var(--creme);
  }
  .kt-spieler:hover .kt-magnet,
  .kt-spieler:focus-visible .kt-magnet {
    translate: 0 -4px;
    box-shadow:
      inset 0 0 0 2px rgb(217 194 156 / 0.7),
      0 6px 8px rgb(0 0 0 / 0.3),
      0 18px 24px -10px rgb(0 0 0 / 0.65);
  }
  a.kt-spieler:hover .kt-nachname {
    text-decoration: underline;
    text-decoration-color: #e3946a;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.d-js) .kadertafel.rv {
      opacity: 1;
      translate: none;
    }
    :global(.d-js) .kadertafel:not(.is-in) .kt-liste li {
      opacity: 0;
    }
    :global(.d-js) .kadertafel.is-in .kt-liste li {
      animation: kt-rein 0.45s cubic-bezier(0.3, 1.45, 0.5, 1) backwards;
      animation-delay: calc(var(--i) * 40ms + 0.1s);
    }
  }
  @keyframes kt-rein {
    from {
      opacity: 0;
      scale: 1.25;
      translate: 0 -8px;
    }
  }
  .foto {
    position: relative;
    overflow: hidden;
    background: var(--papier);
    border: 1px solid rgb(28 34 50 / 0.1);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgb(28 34 50 / 0.05),
      0 14px 30px -20px rgb(28 34 50 / 0.35);
  }
  .foto img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .foto-platz {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    aspect-ratio: 4 / 3;
    padding: 1rem;
    text-align: center;
    color: var(--ink-3);
    background:
      linear-gradient(160deg, #eef1f4, #e4e8ee);
  }
  .foto-titel {
    margin-top: 0.3rem;
    font: 800 1.5rem/1.1 var(--f-titel);
    text-transform: uppercase;
    color: var(--navy);
  }
  .foto-sub {
    font-size: 0.85rem;
    max-width: 16rem;
  }
  .foto figcaption {
    padding: 0.7rem 1rem 0.8rem;
    border-top: 1px solid var(--linie);
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: center;
  }
  /* ---------- Spielerkarte (Dialog; Handy: Bottom-Sheet) ---------- */
  .kt-spieler {
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .kt-dialog {
    width: min(720px, calc(100vw - 32px));
    max-width: none;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
  }
  .kt-dialog::backdrop {
    background: rgb(16 20 32 / 0.62);
    backdrop-filter: blur(3px);
  }
  .ktd-karte {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    overflow: hidden;
    background: var(--papier);
    color: var(--ink);
    border-top: 3px solid var(--orange);
    border-radius: 14px;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .kt-dialog[open] .ktd-karte {
      animation: ktd-auf 0.28s var(--ease);
    }
    .kt-dialog[open]::backdrop {
      animation: einblenden 0.28s ease;
    }
  }
  @keyframes ktd-auf {
    from {
      opacity: 0;
      scale: 0.96;
    }
  }
  .ktd-zu {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--navy);
    box-shadow: 0 0 0 1px rgb(28 34 50 / 0.12), 0 4px 10px -4px rgb(28 34 50 / 0.4);
    cursor: pointer;
  }
  .ktd-zu:hover {
    background: #fff;
  }
  .ktd-portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--navy);
  }
  .ktd-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ktd-platz {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 10%, #2c3653 0%, var(--navy) 70%);
  }
  .ktd-platz[hidden] {
    display: none;
  }
  .ktd-platz-nr {
    position: absolute;
    top: 6%;
    left: 0;
    right: 0;
    text-align: center;
    font: 900 clamp(6rem, 18vw, 10rem) / 1 var(--f-titel);
    color: rgb(246 241 231 / 0.07);
  }
  .kt-dialog[data-rolle='g'] .ktd-platz-nr {
    color: rgb(227 148 106 / 0.14);
  }
  .ktd-silhouette {
    position: relative;
    width: 78%;
    fill: rgb(246 241 231 / 0.14);
  }
  .ktd-platz-text {
    position: absolute;
    bottom: 0.9rem;
    font: 650 0.68rem/1 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(246 241 231 / 0.6);
  }
  .ktd-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }
  .ktd-pos {
    font: 650 0.72rem/1.2 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-text);
  }
  .ktd-nr {
    font: 900 4.2rem/0.9 var(--f-titel);
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }
  .ktd-name {
    display: flex;
    flex-direction: column;
    font: 700 1.5rem/1.05 var(--f-titel);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .ktd-nachname {
    font-weight: 850;
    font-size: 2.1rem;
    color: var(--navy);
  }
  .ktd-link {
    display: inline-block;
    margin-top: 0.4rem;
    padding-block: 0.6rem;
    color: var(--navy);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .ktd-link[hidden] {
    display: none;
  }
  .ktd-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .ktd-pfeil {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid rgb(28 34 50 / 0.2);
    border-radius: 50%;
    background: none;
    color: var(--navy);
    cursor: pointer;
  }
  .ktd-pfeil:hover {
    background: var(--navy);
    color: #fff;
  }
  .ktd-zaehler {
    min-width: 3.5rem;
    text-align: center;
    font: 700 1rem/1 var(--f-titel);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 600px) {
    .kt-dialog {
      width: 100vw;
      max-height: 92dvh;
      margin: auto 0 0;
    }
    .ktd-karte {
      grid-template-columns: 1fr;
      max-height: 92dvh;
      overflow-y: auto;
      border-radius: 16px 16px 0 0;
    }
    .ktd-portrait {
      aspect-ratio: auto;
      height: min(46dvh, 340px);
    }
    .ktd-nr {
      font-size: 3.2rem;
    }
    .ktd-text {
      padding: 1.2rem 1.2rem 1.6rem;
    }
    @media (prefers-reduced-motion: no-preference) {
      .kt-dialog[open] .ktd-karte {
        animation: ktd-hoch 0.32s var(--ease);
      }
    }
  }
  @keyframes ktd-hoch {
    from {
      translate: 0 40%;
      opacity: 0.6;
    }
  }
  /* ================= Club ================= */
  .club-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.75rem, 5vw, 4.5rem);
    align-items: start;
  }
  .ueber-lead {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink);
    max-width: 40rem;
  }
  .fakten {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.8rem;
    border-top: 1px solid var(--linie);
  }
  .fakten div {
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--linie);
  }
  .fakten dt {
    font: 650 0.7rem/1.2 var(--f-text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .fakten dd {
    margin-top: 0.25rem;
    font-weight: 600;
  }
  .ueber-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }
  .erfolge {
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .meister {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-top: 1.1rem;
    padding-bottom: 1.1rem;
    border-bottom: 2px solid var(--navy);
    color: var(--navy);
  }
  .meister-zahl {
    font: 900 4.2rem/0.85 var(--f-titel);
    font-variant-numeric: tabular-nums;
  }
  .meister-text {
    font: 700 1.15rem/1.15 var(--f-titel);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }
  .erfolg-liste {
    margin-top: 0.4rem;
  }
  .erfolg-liste li {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--linie);
  }
  .erfolg-liste li:last-child {
    border-bottom: 0;
  }
  .erfolg-saison {
    font: 800 1.35rem/1 var(--f-titel);
    font-variant-numeric: tabular-nums;
    color: var(--navy);
  }
  .ist-meister .erfolg-saison {
    color: var(--orange-text);
  }
  .erfolg-titel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    font-size: 0.95rem;
  }
  .erfolg-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgb(185 97 42 / 0.12);
    color: var(--orange-text);
    font: 650 0.68rem/1 var(--f-text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ================= Kontakt ================= */
  .kontakt-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }
  .kontakt-karte {
    padding: clamp(1.3rem, 3vw, 2rem);
  }
  .kontakt-lead {
    max-width: 34rem;
    font-size: 1.05rem;
    color: var(--ink-2);
  }
  .kontakt-form {
    display: grid;
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .kf-zeile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .kf-feld {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .kf-feld label {
    font: 650 0.78rem/1.2 var(--f-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .kf-pflicht {
    color: var(--orange-text);
  }
  .kf-feld input,
  .kf-feld textarea {
    width: 100%;
    min-height: 46px;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid rgb(28 34 50 / 0.2);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    font: 400 1rem/1.4 var(--f-text);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .kf-feld textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .kf-feld input:hover,
  .kf-feld textarea:hover {
    border-color: rgb(28 34 50 / 0.35);
  }
  .kf-feld input:focus-visible,
  .kf-feld textarea:focus-visible {
    outline: none;
    border-color: var(--navy);
    box-shadow: 0 0 0 3px rgb(185 97 42 / 0.35);
  }
  .kf-feld [aria-invalid] {
    border-color: var(--rot);
  }
  .kf-fehler {
    font-size: 0.85rem;
    color: #b0221c;
  }
  .kf-fuss {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1rem;
    margin-top: 0.2rem;
  }
  .kf-hinweis {
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .kf-danke {
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: rgb(29 122 69 / 0.1);
    color: #165c34;
    font-weight: 600;
  }
  .kf-danke[hidden],
  .kf-fehler[hidden] {
    display: none;
  }
  .kontakt-info {
    padding-top: 0.4rem;
  }
  .kontakt-info dl {
    border-top: 2px solid var(--navy);
  }
  .kontakt-info dl > div {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--linie);
  }
  .kontakt-info dt {
    font: 650 0.7rem/1.2 var(--f-text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .kontakt-info dd {
    margin-top: 0.25rem;
    font-weight: 600;
  }
  .kontakt-ics {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-block: 0.75rem;
    color: var(--navy);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  @media (max-width: 860px) {
    .kontakt-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .kf-zeile {
      grid-template-columns: minmax(0, 1fr);
    }
    .kf-fuss .knopf {
      width: 100%;
      justify-content: center;
    }
  }
  /* ================= Fuss ================= */
  .fuss::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: 11px;
    background: var(--saum);
  }
  .fuss {
    position: relative;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    background: radial-gradient(120% 140% at 88% 0%, #2a3350 0%, var(--navy) 58%);
    color: #fff;
  }
  .fuss-motiv {
    position: absolute;
    right: -90px;
    top: 30px;
    width: 600px;
    height: auto;
    fill: none;
    stroke: rgb(255 255 255 / 0.07);
    stroke-width: 2.5;
    pointer-events: none;
  }
  .fm-rot {
    stroke: rgb(212 46 39 / 0.22);
    stroke-width: 7;
  }
  .fm-blau {
    stroke: rgb(47 98 191 / 0.3);
    stroke-width: 7;
  }
  .fm-punkt {
    fill: rgb(255 255 255 / 0.14);
    stroke: none;
  }
  .fuss-innen {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: 2.5rem;
    align-items: start;
    padding-block: 3.6rem 2.6rem;
  }
  .fuss-marke {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .fuss-marke p {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .fuss-marke strong {
    font: 850 2.1rem/0.95 var(--f-titel);
    text-transform: uppercase;
  }
  .fuss-marke span {
    margin-top: 0.3rem;
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.72);
  }
  .fuss-marke .fuss-seit {
    margin-top: 0.45rem;
    font: 650 0.72rem/1 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .fuss-h {
    margin-bottom: 0.8rem;
    font: 650 0.7rem/1.2 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .fuss-nav {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 2.5rem;
  }
  .fuss-nav a {
    display: inline-block;
    padding-block: 0.7rem;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    background: linear-gradient(var(--orange), var(--orange)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease);
  }
  .fuss-nav a:hover {
    background-size: 100% 2px;
  }
  .fuss-abo {
    padding: 1.4rem 1.5rem 1.5rem;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .abo-titel {
    font: 800 1.55rem/1 var(--f-titel);
    text-transform: uppercase;
  }
  .abo-text {
    margin: 0.5rem 0 1.1rem;
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.72);
  }
  .fuss .knopf:focus-visible,
  .fuss a:focus-visible {
    outline-color: var(--sand);
  }
  .fuss-unten {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 2rem;
    padding-block: 1.2rem 5.5rem;
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.6);
    background: linear-gradient(rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.12)) 50% 0 /
