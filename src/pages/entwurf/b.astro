        </nav>
        <div class="fuss-abo">
          <p class="fuss-h">Kalender-Abo</p>
          <p class="abo-titel">Jeder Match automatisch im eigenen Kalender.</p>
          <p class="abo-text">Meisterschaft und Plauschspiele – Änderungen kommen von selbst nach.</p>
          <a class="knopf knopf-orange" href="/spielplan.ics">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm12 8H5v9h14v-9Z"></path></svg>
            Kalender abonnieren
          </a>
        </div>
      </div>
      <div class="wrap fuss-unten">
        <p>© {new Date().getFullYear()} {VEREIN} · Entwurf B «Taktiktafel»</p>
        <p>Frauenfeld · Eishalle Deutweg Winterthur</p>
        <a href="#">Nach oben <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </div>
</EntwurfLayout>

<script>
  const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Mobiles Menü ----------
  const kopf = document.querySelector<HTMLElement>('[data-kopf]');
  const knopf = document.querySelector<HTMLButtonElement>('[data-menu-knopf]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
  const schmal = window.matchMedia('(max-width: 899px)');
  const setzeMenu = (offen: boolean, fokus = true) => {
    if (!kopf || !knopf || !nav) return;
    kopf.toggleAttribute('data-offen', offen);
    knopf.setAttribute('aria-expanded', String(offen));
    knopf.setAttribute('aria-label', offen ? 'Menü schliessen' : 'Menü');
    document.documentElement.style.overflow = offen ? 'hidden' : '';
        if (offen) nav.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (fokus) knopf.focus({ preventScroll: true });
  };
  knopf?.addEventListener('click', () => setzeMenu(knopf.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && kopf?.hasAttribute('data-offen')) setzeMenu(false, false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && kopf?.hasAttribute('data-offen')) setzeMenu(false);
  });
  document.addEventListener('click', (e) => {
    if (kopf?.hasAttribute('data-offen') && !kopf.contains(e.target as Node)) setzeMenu(false, false);
  });
  schmal.addEventListener('change', () => kopf?.hasAttribute('data-offen') && setzeMenu(false, false));
  // Beim Scrollen wird der Kopf schmal und bekommt einen milchigen Hintergrund
  const kleinPruefen = () => kopf?.classList.toggle('klein', window.scrollY > 24);
  window.addEventListener('scroll', kleinPruefen, { passive: true });
  kleinPruefen();

  // ---------- Countdown ----------
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const ziel = new Date(cd.dataset.countdown!).getTime();
    const felder = [...cd.querySelectorAll<HTMLElement>('[data-teil]')];
    let timer = 0;
    const tick = () => {
      const rest = ziel - Date.now();
      if (rest <= 0) {
        cd.innerHTML = '<p class="cd-label">Anpfiff ist erfolgt – das Resultat folgt im Spielplan.</p>';
        window.clearInterval(timer);
        return;
      }
      const s = Math.floor(rest / 1000);
      const werte = [Math.floor(s / 86400), Math.floor((s % 86400) / 3600), Math.floor((s % 3600) / 60), s % 60];
      werte.forEach((w, i) => {
        const txt = String(w).padStart(2, '0');
        if (felder[i] && felder[i].textContent !== txt) felder[i].textContent = txt;
      });
    };
    tick();
    timer = window.setInterval(tick, 1000);
  }

  // ---------- Reveals (Wischer, Marker, Karten) ----------
  const alle = document.querySelectorAll<HTMLElement>('[data-rv]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.15 },
    );
    alle.forEach((el) => io.observe(el));
  } else {
    alle.forEach((el) => el.classList.add('is-in'));
  }

  // ---------- Hero: Spielzüge im Loop ----------
  // Ruhiger Ablauf wie an der Taktiktafel: Magnet hebt sich, Linie zeichnet sich, Magnet setzt ab.
  // Je nach Fensterbreite ist ein anderer Satz Züge sichtbar (breit / mittel / schmal, siehe CSS).
  // Eigene kleine Uhr: läuft nur, solange das Feld sichtbar ist (sonst steht alles still).
  const feld = document.querySelector<HTMLElement>('[data-feld]');
  if (feld && !reduziert) {
    const notiz = feld.querySelector<HTMLElement>('[data-tor-notiz]')!;
    const titel = feld.querySelector<HTMLElement>('[data-zug-titel]');
    const mqSchmal = window.matchMedia('(max-width: 600px)');
    const setName = () => (mqSchmal.matches ? 'schmal' : 'breit');
    // Rückennummern pro Spielzug zufällig aus dem Kader, damit niemand bevorzugt wird
    const pool = (feld.dataset.nummern ?? '').split(',').filter(Boolean);
    const mische = (sp: SVGGElement[]) => {
      const rest = [...pool];
      sp.forEach((e) => {
        const t = e.querySelector('.sp-nr');
        if (!t || rest.length === 0) return;
        t.textContent = rest.splice(Math.floor(Math.random() * rest.length), 1)[0];
      });
    };

    type Aufgabe = { start: number; dauer: number; fn: (p: number) => void; ease: (t: number) => number; fertig: () => void };
    const aufgaben = new Set<Aufgabe>();
    let uhr = 0;
    let zuletzt = 0;
    let laeuft = false;
    let sichtbar = false;
    const bild = (t: number) => {
      if (!laeuft) return;
      uhr += zuletzt ? Math.min(50, t - zuletzt) : 16;
      zuletzt = t;
      for (const a of [...aufgaben]) {
        const p = Math.min(1, (uhr - a.start) / a.dauer);
        a.fn(a.ease(p));
        if (p >= 1) {
          aufgaben.delete(a);
          a.fertig();
        }
      }
      requestAnimationFrame(bild);
    };
    const pruefe = () => {
      const soll = sichtbar && !document.hidden;
      if (soll && !laeuft) {
        laeuft = true;
        zuletzt = 0;
        requestAnimationFrame(bild);
      } else if (!soll) laeuft = false;
      feld.classList.toggle('pausiert', !soll);
    };
    new IntersectionObserver((e) => {
      sichtbar = e[0].isIntersecting;
      pruefe();
    }).observe(feld);
    document.addEventListener('visibilitychange', pruefe);

    const linear = (t: number) => t;
    const ausEase = (t: number) => 1 - Math.pow(1 - t, 3);
    const einAus = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const tween = (dauer: number, fn: (p: number) => void, ease = linear) =>
      new Promise<void>((fertig) => aufgaben.add({ start: uhr, dauer, fn, ease, fertig }));
    const warte = (ms: number) => tween(ms, () => {});
    const strich = (el: SVGElement, w: number) => (el.style.strokeDashoffset = String(w));
    const zeichne = (el: SVGElement, ms: number, ease = einAus) => tween(ms, (p) => strich(el, 1 - p), ease);
    const blende = (el: SVGElement | HTMLElement, ms: number, von: number, bis: number) =>
      tween(ms, (p) => (el.style.opacity = String(von + (bis - von) * p)), einAus);

    /** Ein Satz Züge mit seinen Spieler-Magneten */
    const satz = (name: string) => {
      const g = feld.querySelector<SVGGElement>(`.zset[data-set="${name}"]`)!;
      const zuege = [...g.querySelectorAll<SVGGElement>('.zug')];
      const sp = [...g.querySelectorAll<SVGGElement>('.sp')];
      const lage = sp.map(() => [0, 0]);
      const setze = (i: number, x: number, y: number) => {
        lage[i] = [x, y];
        sp[i].setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
      };
      const hub = (i: number, v: number) => sp[i].style.setProperty('--hub', v.toFixed(3));
      const posVon = (z: SVGGElement) => z.dataset.pos!.split(';').map((t) => t.split(',').map(Number));
      return { name, zuege, sp, lage, setze, hub, posVon };
    };
    type Satz = ReturnType<typeof satz>;

    const leeren = (z: SVGGElement) => {
      z.style.opacity = '1';
      z.querySelectorAll<SVGElement>('.zm, .s-linie[pathLength]').forEach((el) => {
        el.style.strokeDasharray = '1 2';
        strich(el, 1);
      });
      z.querySelectorAll<SVGPathElement>('.s-linie[data-maske]').forEach((el) => {
        const m = document.querySelector<SVGPathElement>(`#${el.dataset.maske} path`)!;
        m.style.strokeDasharray = '1 2';
        strich(m, 1);
      });
      z.querySelectorAll<SVGElement>('.s-spitze').forEach((el) => (el.style.opacity = '0'));
    };

    /** Tor: Netz zappelt, «Tor!» erscheint über dem Tor */
    /** Tor: Ist das Tor im Bild, zappelt das Netz und «Tor!» steht darüber; sonst steht «Tor!» beim Pfeil am Rand */
    const tor = async (spitzeEl: SVGElement) => {
      const grafik = feld.querySelector<SVGGElement>('[data-tor-grafik]')!;
      const netz = grafik.querySelector<SVGGElement>('.netz')!;
      const f = feld.getBoundingClientRect();
      const r = grafik.getBoundingClientRect();
      const sichtbarTor = r.right <= f.right + 1 && r.left >= f.left;
      const ziel = sichtbarTor ? r : spitzeEl.getBoundingClientRect();
      const x = Math.min(f.width - 48, Math.max(48, ziel.left + ziel.width / 2 - f.left - (sichtbarTor ? (f.width < 601 ? 2 : 18) : 30)));
      const ueber = f.width < 601 ? 40 : 64;
      const y = Math.min(f.height - 50, Math.max(4, ziel.top - f.top - (sichtbarTor ? ueber : 52)));
      notiz.style.left = `${x}px`;
      notiz.style.top = `${y}px`;
      notiz.classList.remove('zeigen');
      void notiz.offsetWidth;
      notiz.classList.add('zeigen');
      await tween(
        800,
        (p) => {
          const a = Math.sin(p * Math.PI * 6) * (1 - p);
          netz.setAttribute(
            'transform',
            `translate(265 0) scale(${(1 + a * 0.22).toFixed(3)} ${(1 - a * 0.1).toFixed(3)}) skewY(${(a * 9).toFixed(2)}) translate(-265 0)`,
          );
        },
        linear,
      );
      netz.removeAttribute('transform');
    };

    const spiele = async (s: Satz, z: SVGGElement) => {
      leeren(z);
      z.classList.remove('zug-aus');
      if (titel) titel.textContent = z.dataset.titel ?? '';
      feld.classList.add('titel-an');
      const gegner = [...z.querySelectorAll<SVGElement>('.zm')];
      gegner.forEach((m, i) => warte(i * 160).then(() => zeichne(m, 420, ausEase)));
      await warte(gegner.length * 160 + 700);

      for (const st of z.querySelectorAll<SVGGElement>('.schritt')) {
        const i = Number(st.dataset.spieler);
        const linien = [...st.querySelectorAll<SVGPathElement>('.s-linie')];
        const spitzeEl = st.querySelector<SVGElement>('.s-spitze')!;
        await tween(300, (p) => s.hub(i, 1 + 0.16 * p), ausEase);
        await warte(140);
        if (st.dataset.art === 'lauf') {
          const maske = document.querySelector<SVGPathElement>(`#${linien[0].dataset.maske} path`)!;
          await tween(950, (p) => strich(maske, 1 - p), einAus);
          await blende(spitzeEl, 180, 0, 1);
          const weg = st.querySelector<SVGPathElement>('.s-weg')!;
          const l = weg.getTotalLength();
          await tween(
            900,
            (p) => {
              const pt = weg.getPointAtLength(p * l);
              s.setze(i, pt.x, pt.y);
            },
            einAus,
          );
        } else if (st.dataset.art === 'pass') {
          await zeichne(linien[0], 760);
          await blende(spitzeEl, 180, 0, 1);
        } else {
          await Promise.all(linien.map((l) => zeichne(l, 520, (t) => t * t)));
          await blende(spitzeEl, 140, 0, 1);
          tor(spitzeEl);
        }
        await tween(320, (p) => s.hub(i, 1.16 - 0.16 * p), ausEase);
        await warte(st.dataset.art === 'schuss' ? 2200 : 480);
      }
    };

    /** Wechsel: Linien und X blenden aus, die Magnete gleiten an die Startplätze des nächsten Zugs */
    const wechsel = async (s: Satz, alt: SVGGElement, neu: SVGGElement) => {
      notiz.classList.remove('zeigen');
      feld.classList.remove('titel-an');
      const start = s.lage.map((p) => [...p]);
      const ziel = s.posVon(neu);
      // Magnete kurz abblenden und neue Nummern ziehen
      await Promise.all(s.sp.map((e) => blende(e, 260, 1, 0.15)));
      mische(s.sp);
      s.sp.forEach((e) => blende(e, 320, 0.15, 1));
      await Promise.all([
        blende(alt, 550, 1, 0),
        warte(200).then(() =>
          tween(
            1200,
            (p) => ziel.forEach((q, i) => s.setze(i, start[i][0] + (q[0] - start[i][0]) * p, start[i][1] + (q[1] - start[i][1]) * p)),
            einAus,
          ),
        ),
      ]);
      alt.classList.add('zug-aus');
      await warte(800);
    };

    const vorbereiten = (s: Satz) => {
      s.zuege.forEach((z) => {
        leeren(z);
        z.classList.add('zug-aus');
      });
      s.posVon(s.zuege[0]).forEach(([x, y], i) => s.setze(i, x, y));
      s.sp.forEach((e) => (e.style.opacity = '0'));
    };

    (async () => {
      ['breit', 'schmal'].forEach((n) => vorbereiten(satz(n)));
      feld.classList.add('animiert');
      await warte(1500); // Linien des Feldes zeichnen sich zuerst
      for (;;) {
        const s = satz(setName());
        vorbereiten(s);
        mische(s.sp);
        s.sp.forEach((e, i) =>
          warte(i * 140).then(() =>
            tween(
              460,
              (p) => {
                e.style.opacity = String(Math.min(1, p * 2));
                s.hub(i, 1.3 - 0.3 * p);
              },
              ausEase,
            ),
          ),
        );
        await warte(s.sp.length * 140 + 700);
        // Satz abspielen, bis die Fensterbreite einen anderen verlangt
        for (let i = 0; setName() === s.name; i = (i + 1) % s.zuege.length) {
          await spiele(s, s.zuege[i]);
          await wechsel(s, s.zuege[i], s.zuege[(i + 1) % s.zuege.length]);
        }
        notiz.classList.remove('zeigen');
      }
    })();
  }


  // ---------- Kadertafel: Spielerkarte ----------
  const ktDialog = document.querySelector<HTMLDialogElement>('[data-kt-dialog]');
  if (ktDialog) {
    const spieler = [...document.querySelectorAll<HTMLElement>('[data-kt]')].sort(
      (a, b) => Number(a.dataset.rang) - Number(b.dataset.rang),
    );
    const el = <T extends Element = HTMLElement>(sel: string) => ktDialog.querySelector<T>(sel)!;
    const img = el<HTMLImageElement>('[data-ktd-img]');
    const platz = el('[data-ktd-platz]');
    const link = el<HTMLAnchorElement>('[data-ktd-link]');
    let index = 0;
    let opener: HTMLElement | null = null;

    const zeige = (i: number) => {
      index = (i + spieler.length) % spieler.length;
      const d = spieler[index].dataset;
      const nr = d.nr ?? '';
      el('[data-ktd-pos]').textContent = d.pos ?? '';
      el('[data-ktd-nr]').textContent = nr ? `#${nr}` : '';
      el('[data-ktd-nr-sr]').textContent = nr ? `Rückennummer ${nr}` : '';
      el('[data-ktd-vorname]').textContent = d.vorname ?? '';
      el('[data-ktd-nachname]').textContent = d.nachname ?? '';
      el('[data-ktd-platz-nr]').textContent = nr;
      ktDialog.dataset.rolle = d.rolle ?? '';
      if (d.bild) {
        img.src = d.bild;
        img.alt = `Porträt ${d.vorname} ${d.nachname}`;
        img.hidden = false;
        platz.hidden = true;
      } else {
        img.hidden = true;
        img.removeAttribute('src');
        platz.hidden = false;
      }
      if (d.slug) {
        link.href = `/spieler/${d.slug}/`;
        link.hidden = false;
      } else link.hidden = true;
      el('[data-ktd-zaehler]').textContent = `${index + 1} / ${spieler.length}`;
    };

    spieler.forEach((m, i) =>
      m.addEventListener('click', (e) => {
        e.preventDefault();
        opener = m;
        zeige(i);
        ktDialog.showModal();
      }),
    );
    /** Schliessen und den Fokus zurück auf den Magneten setzen, der die Karte geöffnet hat */
    const schliessen = () => {
      ktDialog.close();
      opener?.focus();
    };
    el('[data-ktd-zu]').addEventListener('click', schliessen);
    ktDialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      schliessen();
    });
    el('[data-ktd-zurueck]').addEventListener('click', () => zeige(index - 1));
    el('[data-ktd-weiter]').addEventListener('click', () => zeige(index + 1));
    ktDialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        zeige(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        zeige(index + 1);
      }
    });
    // Klick auf den abgedunkelten Hintergrund schliesst
    ktDialog.addEventListener('click', (e) => {
      if (e.target === ktDialog) schliessen();
    });
  }

  // ---------- Kontaktformular (Entwurf: sendet nichts) ----------
  const kForm = document.querySelector<HTMLFormElement>('[data-kontakt-form]');
  if (kForm) {
    const danke = kForm.querySelector<HTMLElement>('[data-kontakt-danke]')!;
    const felder = [...kForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
    const pruefe = (f: HTMLInputElement | HTMLTextAreaElement) => {
      const fehler = kForm.querySelector<HTMLElement>(`#${f.id}-fehler`);
      if (!fehler) return true;
      const ok = f.checkValidity();
      fehler.hidden = ok;
      f.toggleAttribute('aria-invalid', !ok);
      if (ok) f.removeAttribute('aria-describedby');
      else f.setAttribute('aria-describedby', fehler.id);
      return ok;
    };
    felder.forEach((f) => {
      f.addEventListener('blur', () => f.value && pruefe(f));
      f.addEventListener('input', () => f.hasAttribute('aria-invalid') && pruefe(f));
    });
    kForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const falsch = felder.filter((f) => !pruefe(f));
      if (falsch.length) {
        danke.hidden = true;
        falsch[0].focus();
        return;
      }
      danke.hidden = false;
      kForm.reset();
    });
  }
</script>

<style>
  /* ================= Tokens ================= */
  .d {
    --tafel: #f7f8f6;
    --navy: #1c2232;
    --navy-2: #2b3348;
    --orange: #b9612a;
    --orange-text: #9c4f1f;
    --sand: #d9c29c;
    --creme: #f6f1e7;
    --rot: #d42e27;
    --blau: #2f62bf;
    --ink: #1c2232;
    --ink-2: #4b5266;
    --ink-3: #6b7285;
    --linie: rgb(28 34 50 / 0.13);
    --papier: #ffffff;
    --f-titel: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
    --f-text: 'Instrument Sans Variable', system-ui, sans-serif;
    --f-marker: 'Permanent Marker', 'Comic Sans MS', cursive;
    --ease: cubic-bezier(0.22, 0.8, 0.24, 1);
    /* Trikot-Saum (Bauchstreifen): Orange, Crème, Sand breit, Crème, Orange – nur als Oberkante des Footers */
    --saum: linear-gradient(
      180deg,
      var(--orange) 0 20%,
      var(--creme) 20% 34%,
      var(--sand) 34% 66%,
      var(--creme) 66% 80%,
      var(--orange) 80% 100%
    );
    --sh-blatt: 0 1px 1px rgb(28 34 50 / 0.06), 0 2px 4px rgb(28 34 50 / 0.05), 0 18px 34px -18px rgb(28 34 50 / 0.35);

    position: relative;
    isolation: isolate;
    color-scheme: light;
    min-height: 100vh;
    overflow-x: clip;
    background: var(--tafel);
    color: var(--ink);
    font-family: var(--f-text);
    font-size: 1rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  /* Glanz der Tafel: ein fixes Element, kein gekachelter Hintergrund */
  .glanz {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(112deg, rgb(255 255 255 / 0) 22%, rgb(255 255 255 / 0.9) 38%, rgb(255 255 255 / 0) 52%),
      linear-gradient(112deg, rgb(255 255 255 / 0) 58%, rgb(255 255 255 / 0.55) 64%, rgb(255 255 255 / 0) 70%),
      radial-gradient(140% 120% at 50% 0%, #fbfcfa 0%, #f3f5f2 60%, #e9ece8 100%);
  }

  .wrap {
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 40px);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 200;
    padding: 0.6rem 1rem;
    background: var(--navy);
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }
  .skip:focus {
    top: 12px;
  }
  .d :where(a, button):focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
    border-radius: 6px;
  }
  :where(.d) :where(h1, h2, h3, h4, p, ul, ol, dl, dd, figure) {
    margin: 0;
  }
  /* Keine Waisen: Fliesstext ruhig umbrechen, Titel ausgleichen */
  :where(.d) :where(p, li, dd) {
    text-wrap: pretty;
  }
  :where(.d) :where(h1, h2, h3, h4) {
    text-wrap: balance;
  }
  :where(.d) :where(ul, ol) {
    padding: 0;
    list-style: none;
  }

  /* ================= Typo-Bausteine ================= */
  .kicker,
  .label {
    font: 650 0.75rem/1.2 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-text);
  }
  .h2 {
    font: 800 clamp(2.9rem, 6.2vw, 5.4rem) / 0.86 var(--f-titel);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    margin-top: 0.3rem;
  }
  .h3 {
    font: 750 1.45rem/1 var(--f-titel);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .notiz {
    font-family: var(--f-marker);
    font-weight: 400;
    line-height: 1.1;
  }
  .mk {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ================= Knöpfe ================= */
  .knopf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--navy);
    border-radius: 999px;
    background: transparent;
    color: var(--navy);
    font: 650 0.95rem/1 var(--f-text);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s var(--ease),
      background-color 0.2s,
      color 0.2s;
  }
  .knopf:hover {
    background: var(--navy);
    color: #fff;
  }
  .knopf:active {
    transform: translateY(1px);
  }
  .knopf-voll {
    background: var(--navy);
    color: #fff;
    box-shadow: 0 10px 22px -12px rgb(28 34 50 / 0.7);
  }
  .knopf-voll:hover {
    background: var(--navy-2);
    transform: translateY(-1px);
  }
  .knopf-orange {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .knopf-orange:hover {
    background: #a5541f;
    border-color: #a5541f;
  }
  .knopf-klein {
    min-height: 40px;
    padding: 0.55rem 0.95rem;
    font-size: 0.875rem;
  }
  .galerie-hinweis {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .mehr {
    flex: none;
    color: var(--navy);
    font-weight: 650;
    text-decoration: none;
    padding: 0.7rem 0 0.4rem;
    border-bottom: 2px solid var(--orange);
    transition: color 0.2s;
  }
  .mehr span {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }
  .mehr:hover {
    color: var(--orange-text);
  }
  .mehr:hover span {
    transform: translateX(4px);
  }

  /* ================= Pins (Magnete auf Blättern) ================= */
  /* Karten-System: alle soliden Karten gleich – 14 px Radius, feiner Rahmen, ruhiger Schatten und
     eine 3 px rostorange Oberkante (Matchplan, News, Teamfoto, Kadertafel, Erfolge, Galerie, Kalender-Abo).
     Der mehrfarbige Trikot-Saum kommt nur einmal vor: als Oberkante des Footers. */
  .blatt,
  .karte-link,
  .foto,
  .fuss-abo {
    border-top: 3px solid var(--orange) !important;
  }
  .blatt {
    position: relative;
    background: var(--papier);
    border: 1px solid rgb(28 34 50 / 0.1);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgb(28 34 50 / 0.05),
      0 14px 30px -20px rgb(28 34 50 / 0.35);
  }

  /* ================= Kopf ================= */
  :global(html) {
    scroll-padding-top: 80px;
  }
  .kopf {
    --kopf-h: 84px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition:
      background-color 0.35s,
      box-shadow 0.35s;
  }
  .kopf.klein {
    --kopf-h: 62px;
    background: rgb(247 248 246 / 0.8);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow:
      0 1px 0 rgb(28 34 50 / 0.08),
      0 12px 30px -26px rgb(28 34 50 / 0.6);
  }
  .kopf-platz {
    height: 84px;
  }
  @media (max-height: 500px) {
    .kopf,
    .kopf.klein {
      --kopf-h: 54px;
    }
    .kopf-platz {
      height: 54px;
    }
    .marke :global(.d-magnet) {
      scale: 0.8;
    }
  }
  .kopf-innen {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    height: var(--kopf-h);
    transition: height 0.35s var(--ease);
  }
  .marke {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    color: var(--navy);
    text-decoration: none;
  }
  .marke :global(.d-magnet) {
    transform-origin: left center;
    transition: scale 0.35s var(--ease);
  }
  .kopf.klein .marke :global(.d-magnet) {
    scale: 0.8;
  }
  .marke-text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font: 850 1.55rem/1 var(--f-titel);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .mt-ehc {
    font-weight: 600;
    font-size: 0.78em;
    letter-spacing: 0.14em;
    color: var(--ink-2);
  }
  .nav ul {
    display: flex;
    gap: 0.15rem;
  }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.6rem 0.8rem;
    color: var(--navy);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.97rem;
  }
  .nav-text {
    position: relative;
  }
  .nav-nr,
  .nav-fuss {
    display: none;
  }
  .strich {
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -7px;
    width: calc(100% + 4px);
    height: 9px;
    overflow: visible;
  }
  .strich path {
    fill: none;
    stroke: var(--orange);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 0.4s var(--ease),
      opacity 0.1s;
  }
  .nav a:hover .strich path,
  .nav a:focus-visible .strich path,
  .nav a[aria-current='page'] .strich path {
    stroke-dashoffset: 0;
    opacity: 1;
  }
  .kopf-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 42px;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font: 600 0.88rem/1 var(--f-text);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 18px -12px rgb(28 34 50 / 0.8);
    transition:
      background-color 0.2s,
      transform 0.2s var(--ease);
  }
  .kopf-cta strong {
    font: 800 1.05rem/1 var(--f-titel);
    letter-spacing: 0.02em;
    margin-left: 0.15rem;
  }
  .kopf-cta:hover {
    background: var(--navy-2);
    transform: translateY(-1px);
  }
  .menu-knopf {
    display: none;
  }

  @media (max-width: 899px) {
    .nav {
      order: 3;
      width: 100%;
    }
    .nav ul {
      flex-wrap: wrap;
    }
    .kopf-innen {
      flex-wrap: wrap;
      height: auto;
      min-height: var(--kopf-h);
    }
    /* Mit JS: Overlay-Menü */
    :global(.d-js) .kopf-innen {
      flex-wrap: nowrap;
      height: var(--kopf-h);
    }
    :global(.d-js) .menu-knopf {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 44px;
      padding: 0.5rem 0.95rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--navy);
      font: 650 0.92rem/1 var(--f-text);
      cursor: pointer;
      box-shadow: inset 0 0 0 1.5px rgb(28 34 50 / 0.25);
    }
    .menu-icon {
      position: relative;
      display: inline-block;
      width: 18px;
      height: 10px;
    }
    .menu-icon i {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition: transform 0.3s var(--ease);
    }
    .menu-icon i:nth-child(1) {
      top: 0;
    }
    .menu-icon i:nth-child(2) {
      top: 8px;
    }
    .kopf[data-offen] .menu-icon i:nth-child(1) {
      transform: translateY(4px) rotate(45deg);
    }
    .kopf[data-offen] .menu-icon i:nth-child(2) {
      transform: translateY(-4px) rotate(-45deg);
    }
    .kopf[data-offen] {
      background: var(--tafel);
      box-shadow: 0 1px 0 rgb(28 34 50 / 0.08);
    }
    :global(.d-js) .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: auto;
      height: calc(100dvh - var(--kopf-h));
      overflow-y: auto;
      padding: 1.5rem clamp(16px, 4vw, 40px) 6rem;
      background: var(--tafel);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s,
        transform 0.35s var(--ease),
        visibility 0s 0.35s;
    }
    :global(.d-js) .kopf[data-offen] .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.25s,
        transform 0.35s var(--ease);
    }
    :global(.d-js) .nav ul {
      flex-direction: column;
      gap: 0;
    }
    :global(.d-js) .nav li {
      border-bottom: 1px solid var(--linie);
    }
    :global(.d-js) .nav a {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 0.9rem 0.1rem;
      font: 800 2.3rem/1 var(--f-titel);
      text-transform: uppercase;
    }
    :global(.d-js) .nav-nr {
      display: inline;
      min-width: 1.6rem;
      font: 600 0.8rem/1 var(--f-text);
      letter-spacing: 0.1em;
      color: var(--orange-text);
    }
    :global(.d-js) .strich {
      bottom: -6px;
    }
    :global(.d-js) .nav-fuss {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      margin-top: 1.8rem;
    }
    :global(.d-js) .nav .nav-fuss a {
      display: inline-flex;
      gap: 0;
      font: 650 0.95rem/1.3 var(--f-text);
      text-transform: none;
    }
    :global(.d-js) .nav .nav-fuss .knopf {
      padding: 0.75rem 1.2rem;
      color: #fff;
    }
    .nav-ics {
      color: var(--navy);
      font-weight: 650;
      text-decoration: underline;
      text-decoration-color: var(--orange);
      text-underline-offset: 4px;
      text-decoration-thickness: 2px;
      padding-block: 0.3rem;
    }
    @media (prefers-reduced-motion: no-preference) {
      :global(.d-js) .kopf[data-offen] .nav li {
        animation: auf 0.45s var(--ease) backwards;
        animation-delay: calc(var(--i) * 45ms + 60ms);
      }
    }
  }
  @media (max-width: 560px) {
    .kopf-cta {
      display: none;
    }
    .marke-text {
      font-size: 1.35rem;
    }
  }

  /* ================= Hero ================= */
  /* Angriffszone als Tafel rechts, das Logo als grosser Magnet auf der Mittellinie links davon (ab 601 px).
     Auf dem Handy: nur die neutrale Zone, das Logo füllt genau den Mittelkreis. */
  .hero {
    --logo-s: clamp(240px, 25vw, 370px);
    --feld-b: min(58vw, calc((100svh - 190px) * 330 / 306), 760px);
    padding-block: 0.5rem clamp(2rem, 4vw, 3.5rem);
  }
  .hero-raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--feld-b);
    align-items: center;
    max-width: 1440px;
  }
  .hero-kopf {
    /* Platz für den Teil des Logos, der links über das Feld hinausragt */
    padding-right: calc(var(--logo-s) * 0.5 - var(--feld-b) * 0.0727 + 1.5rem);
  }
  .hk-titel {
    position: relative;
    container-type: inline-size;
  }
  .hero h1 {
    margin-top: 0;
    color: var(--navy);
    text-transform: uppercase;
    line-height: 0.8;
  }
  .h1-ehc {
    display: block;
    font: 700 clamp(1.2rem, 2vw, 1.7rem) / 1 var(--f-titel);
    letter-spacing: 0.32em;
    color: var(--ink-2);
    margin-bottom: 0.35rem;
  }
  .h1-name {
    display: block;
    font: 900 min(21cqi, 6.4rem) / 0.82 var(--f-titel);
    letter-spacing: -0.01em;
  }
  .hero-seit {
    margin-top: 0.9rem;
    font: 650 0.78rem/1.3 var(--f-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-text);
  }
  .hk-text {
    margin-top: 1.4rem;
  }
  .hero-lead {
    max-width: 30rem;
    font-size: 1.04rem;
    color: var(--ink-2);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  /* ---------- Feld: echte IIHF-Proportionen, rechte Angriffszone ---------- */
  .feld {
    /* Ausschnitt in Metern; --k = Pixel pro Meter */
    --x0: -2.4;
    --x1: 30.6;
    --y0: -15.3;
    --y1: 15.3;
    --k: calc(var(--feld-b) / 33);
    position: relative;
    width: var(--feld-b);
    aspect-ratio: 330 / 306;
  }
  .feld-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* Links läuft das Feld weich aus (es geht ja weiter); oben, unten und rechts bleibt die echte Bande.
     Das Logo liegt ausserhalb dieser Ebene und bleibt voll deckend. */
  .feld-clip {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 20%);
    mask-image: linear-gradient(to right, transparent 0, #000 20%);
  }
  .rink-box {
    position: absolute;
    left: calc((-30 - var(--x0)) * var(--k));
    top: calc((-15 - var(--y0)) * var(--k));
    width: calc(60 * var(--k));
    height: calc(30 * var(--k));
  }
  .hf-rink,
  .zuege {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hf-eis {
    fill: #fff;
  }
  .hf-rink .l-bande {
    stroke: rgb(28 34 50 / 0.4);
    stroke-width: 1.2;
  }
  .hf-rink .l-rot {
    stroke: #d8433c;
  }
  .hf-rink .l-blau {
    stroke: #2f62bf;
  }
  .hf-rink .l-dick {
    stroke-width: 3;
    opacity: 0.8;
  }
  .hf-rink .l-duenn {
    stroke-width: 1.1;
  }
  .hf-rink .l-raum {
    fill: rgb(47 98 191 / 0.12);
  }
  .hf-punkte {
    fill: #d8433c;
  }
  .hf-punkt-blau {
    fill: #2f62bf;
  }
  .netz-flaeche {
    fill: rgb(255 255 255 / 0.95);
  }
  .netz-faden {
    stroke: #9aa3b0;
    stroke-width: 0.45;
  }
  .tor-rahmen {
    fill: none;
    stroke: var(--rot);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .feld-logo {
    position: absolute;
    left: 7.27%;
    top: 50%;
    z-index: 2;
    width: var(--logo-s);
    aspect-ratio: 1;
    translate: -50% -50%;
  }
  .feld-logo :global(.d-magnet) {
    display: block;
  }
  .zset {
    display: none;
  }
  @media (min-width: 601px) {
    .zset[data-set='breit'] {
      display: inline;
    }
  }
  @media (max-width: 600px) {
    .zset[data-set='schmal'] {
      display: inline;
    }
  }
  @media (max-width: 1099px) {
    .hero {
      --logo-s: clamp(220px, 27vw, 290px);
      --feld-b: min(72vw, calc((100svh - 330px) * 330 / 306), 640px);
    }
    .hero-raster {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-kopf {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1rem 2.5rem;
      align-items: end;
      padding-right: 0;
      margin-bottom: 1.8rem;
    }
    .hk-text {
      margin-top: 0;
    }
    .feld {
      justify-self: center;
      margin-left: calc(var(--logo-s) * 0.42);
    }
  }
  /* Niedrige Fenster (Handy quer, kleine Laptops): Text links, Feld rechts; Grössen nach der Höhe */
  @media (min-width: 601px) and (max-width: 1099px) and (max-height: 700px) {
    .hero {
      --feld-b: min(48vw, calc((100svh - 90px) * 330 / 306));
      --logo-s: calc(var(--feld-b) * 0.42);
    }
    .hero-raster {
      grid-template-columns: minmax(0, 1fr) var(--feld-b);
      align-items: center;
    }
    .hero-kopf {
      display: block;
      margin-bottom: 0;
      padding-right: calc(var(--logo-s) * 0.5 - var(--feld-b) * 0.0727 + 1.25rem);
    }
    .hk-text {
      margin-top: 1rem;
    }
    .feld {
      justify-self: end;
      margin-left: 0;
    }
  }
  @media (max-width: 600px) {
    /* Handy: dieselbe Komposition wie Desktop, verkleinert – Logo auf der Mittellinie links,
       Angriffszone mit beiden Bullykreisen und Tor rechts; volle Höhe mit Bande oben und unten, links weich auslaufend */
    .feld {
      --x0: -6.5;
      --x1: 30.6;
      --y0: -15.3;
      --y1: 15.3;
      --k: calc((100vw - 10px) / 37.1);
      --sp-gr: 1.7;
      justify-self: start;
      width: calc(100vw - 10px);
      height: calc(30.6 * var(--k));
      aspect-ratio: auto;
      margin-top: 1.4rem;
      margin-left: calc(10px - clamp(16px, 4vw, 40px));
    }
    .feld-clip {
      filter: none;
    }
    .feld-logo {
      --logo-s: clamp(110px, 31vw, 136px);
      left: calc(6.5 * var(--k));
    }
    .feld-titel {
      bottom: -1.6rem;
    }
    .hero {
      padding-bottom: 2.4rem;
    }
  }
  .zm,
  .s-linie,
  .s-spitze {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .zm {
    stroke: var(--rot);
    stroke-width: 2;
  }
  .s-pass .s-linie,
  .s-pass .s-spitze {
    stroke: var(--orange);
    stroke-width: 2.1;
  }
  .s-lauf .s-linie {
    stroke: var(--navy);
    stroke-width: 1.7;
    stroke-dasharray: 5 4.5;
  }
  .s-lauf .s-spitze {
    stroke: var(--navy);
    stroke-width: 1.7;
  }
  .s-schuss .s-linie {
    stroke: var(--rot);
    stroke-width: 1.4;
  }
  .s-schuss .s-spitze {
    stroke: var(--rot);
    stroke-width: 1.9;
  }
  .s-weg {
    fill: none;
    stroke: none;
  }
  .z-maske {
    fill: none;
    stroke: #fff;
    stroke-width: 7;
    stroke-linecap: round;
  }
  .zug-aus {
    display: none;
  }
  /* Spieler-Magnete: flach, mit Rückennummer; heben sich beim Spielzug kurz an */
  .sp-hub {
    transform: rotate(var(--prot, 0deg)) scale(calc(var(--hub, 1) * var(--sp-gr, 1)));
  }
  .sp-schatten {
    fill: rgb(28 34 50 / 0.3);
    transform: translate(calc((var(--hub, 1) - 1) * 7px), calc((var(--hub, 1) - 1) * 13px));
  }
  .sp-koerper {
    fill: url(#d-sp-navy);
  }
  .sp-rand {
    fill: none;
    stroke: rgb(255 255 255 / 0.2);
    stroke-width: 0.5;
  }
  .sp-nr {
    fill: #fff;
    font: 800 10px/1 var(--f-titel);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .feld-titel {
    position: absolute;
    right: 2%;
    bottom: -1.9rem;
    z-index: 3;
    white-space: nowrap;
    font: 400 1.05rem/1 var(--f-marker);
    color: var(--ink-3);
    transition: opacity 0.5s;
  }
  .feld.animiert:not(.titel-an) .feld-titel {
    opacity: 0;
  }
  .tor-notiz {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    font: 400 clamp(1.5rem, 2.6vw, 2.3rem) / 1 var(--f-marker);
    color: var(--rot);
    translate: -50% 0;
    rotate: -8deg;
    opacity: 0;
    pointer-events: none;
  }
  .tor-notiz.zeigen {
    animation:
      tor-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) forwards,
      tor-blink 0.4s steps(2, jump-none) 0.6s 2;
  }
  .feld.pausiert .tor-notiz {
    animation-play-state: paused;
  }
  @keyframes tor-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes tor-blink {
    50% {
      opacity: 0.25;
    }
  }

  /* ---------- Lade-Animationen (nur CSS, Inhalt bleibt ohne JS sichtbar) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .an {
      animation: auf 0.8s var(--ease) backwards;
      animation-delay: calc(var(--i) * 90ms + 120ms);
    }
    .hf-rink .z {
      stroke-dasharray: 1 2;
      stroke-dashoffset: 1;
      animation: zeichnen 1.1s cubic-bezier(0.45, 0, 0.2, 1) forwards;
      animation-delay: calc(var(--o) * 110ms + 200ms);
    }
    .hf-punkte,
    .hf-rink .l-raum,
    .zuege {
      animation: einblenden 0.6s ease 1.1s backwards;
    }
    .feld-logo {
      animation: einrasten 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) 0.55s backwards;
    }
  }
  @keyframes auf {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }
  @keyframes einblenden {
    from {
      opacity: 0;
    }
  }
  @keyframes zeichnen {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes schreiben {
    from {
      clip-path: inset(-20% 100% -20% 0);
    }
    to {
      clip-path: inset(-20% 0 -20% 0);
    }
  }
  @keyframes einrasten {
    from {
      opacity: 0;
      scale: 1.2;
    }
    60% {
      opacity: 1;
    }
  }

  /* ================= Sektionen & Wischer ================= */
  .sektion {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .sek-kopf {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.4rem);
  }
  .wisch {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    container-type: inline-size;
  }
  /* Abschnittstitel: ruhiges Einblenden */
  @media (prefers-reduced-motion: no-preference) {
    :global(.d-js) .wisch .wisch-inhalt {
      opacity: 0;
      translate: 0 10px;
      transition:
        opacity 0.7s var(--ease),
        translate 0.7s var(--ease);
    }
    :global(.d-js) .wisch.is-in .wisch-inhalt {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Allgemeine Reveals */
  @media (prefers-reduced-motion: no-preference) {
    :global(.d-js) .rv {
      opacity: 0;
      translate: 0 22px;
      transition:
        opacity 0.7s var(--ease),
        translate 0.7s var(--ease);
      transition-delay: var(--d, 0ms);
    }
    :global(.d-js) .rv.is-in {
      opacity: 1;
      translate: 0 0;
    }
    :global(.d-js) .zeichne .mk {
      stroke-dasharray: 1 2;
      stroke-dashoffset: 1;
    }
    :global(.d-js) .zeichne.is-in .mk {
      transition: stroke-dashoffset 0.55s ease-out;
      transition-delay: calc(var(--d, 0ms) + var(--dd, 0.45s));
      stroke-dashoffset: 0;
    }
  }

  /* ================= Matchplan ================= */
  .spiele-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .matchplan {
    overflow: hidden;
  }
  .mp-kopf {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem clamp(1.3rem, 3vw, 2rem);
