        <line x1="300" y1="0" x2="300" y2="400" class="fm-rot" />
        <line x1="150" y1="0" x2="150" y2="400" class="fm-blau" />
        <line x1="450" y1="0" x2="450" y2="400" class="fm-blau" />
        <circle cx="300" cy="200" r="120" />
        <circle cx="300" cy="200" r="6" class="fm-punkt" />
