    color: #fff;
  }
  .mp-inhalt {
    padding: clamp(1.2rem, 2.6vw, 1.8rem) clamp(1.3rem, 3vw, 2rem) clamp(1.3rem, 3vw, 2rem);
  }
  .mp-leer {
