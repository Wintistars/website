---
// NUR FÜR DESIGN-ENTWÜRFE: Übersicht der drei Startseiten-Varianten.
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow/400.css';
import EntwurfLayout from '../../layouts/EntwurfLayout.astro';
import { LOGO_PLATZHALTER } from '../../lib/entwurf';

const ENTWUERFE = [
  { href: '/entwurf/a/', titel: 'A · Eisfläche', text: 'Frisch und modern: Bento-Kacheln auf Eisbahn-Linien, Countdown, Kader mit Filter, kleine Galerie.', farbe: '#eef2f5' },
  { href: '/entwurf/b/', titel: 'B · Taktiktafel', text: 'Taktiktafel: Logo als Magnet auf dem Eisfeld, animierte Spielzüge, Kader als Nummern-Magnete.', farbe: '#f7f8f6' },
  { href: '/entwurf/c/', titel: 'C · Eiszeit', text: 'Eiszeit: Eine Zamboni macht beim Scrollen das Eis frisch und legt Titel und Archivfotos frei.', farbe: '#1c2232' },
];
---

<EntwurfLayout title="Übersicht" bg="#1c2232">
  <main>
    <img src={LOGO_PLATZHALTER} alt="Logo EHC Wintistars" width="160" height="160" class="logo" />
    <h1>Startseite – drei Entwürfe</h1>
    <ul>
      {
        ENTWUERFE.map((e) => (
          <li>
            <a href={e.href} style={`--farbe:${e.farbe}`}>
              <strong>{e.titel}</strong>
              <span>{e.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</EntwurfLayout>

<style>
  main {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    padding: 3rem 1rem;
    color: #f6f1e7;
    font-family: 'Barlow', system-ui, sans-serif;
    text-align: center;
  }
  .logo {
    width: 160px;
    height: 160px;
    clip-path: circle(47.5%);
  }
  h1 {
    margin: 0;
    font: 800 clamp(2rem, 6vw, 3.5rem) / 1 'Barlow Condensed', sans-serif;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    max-width: 60rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: 12px;
    border-top: 6px solid #b9612a;
    background: #f6f1e7;
    color: #1c2232;
    text-decoration: none;
    text-align: left;
    transition: transform 0.2s;
  }
  a:hover {
    transform: translateY(-4px);
  }
  strong {
    font: 800 1.6rem/1 'Barlow Condensed', sans-serif;
    text-transform: uppercase;
  }
</style>
