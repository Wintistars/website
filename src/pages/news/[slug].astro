---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsArtikel from '../../components/content/NewsArtikel.astro';
import { getNews } from '../../lib/sanity';
import type { News } from '../../lib/types';

export const getStaticPaths = (async () => {
  const news = await getNews();
  return news.map((n) => ({ params: { slug: n.slug }, props: { news: n } }));
}) satisfies GetStaticPaths;

interface Props {
  news: News;
}

const { news } = Astro.props;
---

<BaseLayout title={news.titel} description={news.lead}>
  <NewsArtikel news={news} />
  <p><a href="/news/">← Alle News</a></p>
</BaseLayout>
