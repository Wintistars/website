---
import { storyblokEditable } from '@storyblok/astro';
import type { BildBlok } from '../lib/types';
import SbPicture from '../components/SbPicture.astro';

interface Props {
  blok: BildBlok;
}

const { blok } = Astro.props;
---

<figure {...storyblokEditable(blok)}>
  <SbPicture asset={blok.bild} widths={[600, 1000, 1400]} sizes="(min-width: 48rem) 45rem, 100vw" />
  {blok.legende && <figcaption class="muted">{blok.legende}</figcaption>}
</figure>

<style>
  figure {
    margin: 1.5rem 0;
  }
  figcaption {
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }
</style>
