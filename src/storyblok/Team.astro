---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokRichText from '@storyblok/astro/StoryblokRichText.astro';
import type { SpielerStory, TeamContent } from '../lib/types';
import SbPicture from '../components/SbPicture.astro';
import SpielerCard from '../components/SpielerCard.astro';

interface Props {
  blok: TeamContent;
}

const { blok } = Astro.props;
// Nur aufgelöste Relationen anzeigen (unveröffentlichte Spieler bleiben UUID-Strings).
const spieler = (blok.spieler ?? []).filter((s): s is SpielerStory => typeof s !== 'string');
---

<article {...storyblokEditable(blok)}>
  {blok.kategorie && <p class="muted">{blok.kategorie}</p>}
  <h1>{blok.name}</h1>
  <SbPicture asset={blok.teamfoto} ratio={3 / 2} widths={[800, 1200, 1600]} sizes="(min-width: 72rem) 70rem, 100vw" eager />
  {blok.trainer && <p><strong>Trainer:</strong> {blok.trainer}</p>}
  {blok.beschreibung && <div class="prose"><StoryblokRichText document={blok.beschreibung} /></div>}

  {
    spieler.length > 0 && (
      <section>
        <h2>Kader</h2>
        <div class="grid">
          {spieler.map((s) => <SpielerCard story={s} />)}
        </div>
      </section>
    )
  }
</article>
