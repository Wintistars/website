---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import type { SeiteContent } from '../lib/types';

interface Props {
  blok: SeiteContent;
  /** Titel ausblenden, z. B. auf der Startseite. */
  hideTitle?: boolean;
}

const { blok, hideTitle = false } = Astro.props;
// SbBlokData hat eine lose Index-Signatur; unsere Blocktypen sind strenger.
const body = (blok.body ?? []) as unknown as SbBlokData[];
---

<article {...storyblokEditable(blok)} class="prose">
  {!hideTitle && <h1>{blok.titel}</h1>}
  {body.map((b) => <StoryblokComponent blok={b} />)}
</article>
