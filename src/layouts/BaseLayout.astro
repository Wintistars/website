---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Inhalt ohne Container und Abstände, z. B. für die Startseite mit randlosen Abschnitten. */
  fullWidth?: boolean;
}

const { title, description = 'EHC Wintistars – Eishockey in Winterthur', fullWidth = false } = Astro.props;
const fullTitle = title ? `${title} | EHC Wintistars` : 'EHC Wintistars';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c2232" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <SiteHeader />
    <main class:list={[fullWidth ? 'full' : 'container']}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    width: 100%;
    padding-block: 2rem 4rem;
  }
  main.full {
    padding-block: 0;
  }
</style>
